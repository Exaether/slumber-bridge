    {
        "tag": "character",
        "name": "avg_npc_662_1#8$1",
        "name2": "avg_222_bpipe_1#1",
        "focus": 1
    },
    {
        "text": "There we go.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
