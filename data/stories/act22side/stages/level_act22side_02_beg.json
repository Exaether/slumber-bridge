    },
    {
        "text": "Fischer, urgent correspondence from the Viscount...",
        "tag": "name",
        "value": "Special Forces Captain"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "right",
        "name": "avg_4017_puzzle_1#6$1",
        "duration": 0.3
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "tag": "playsound",
        "key": "$dooropenquite"
    },
    {
        "tag": "delay",
