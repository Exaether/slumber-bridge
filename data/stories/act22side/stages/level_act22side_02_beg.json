    {
        "tag": "delay",
        "time": 2.5
    },
    {
        "tag": "stopsound",
        "channel": "b",
        "fadetime": 2
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1020_reed2_1#6$1",
        "focus": "m"
    },
    {
        "text": "Those are sounds of fighting.",
        "tag": "name",
        "value": "Reed"
    },
    {
        "text": "Is somebody driving those Infected away?",
        "tag": "name",
        "value": "Reed"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_725_1#6$1",
        "focus": "r"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_421_1#1$1",
        "focus": "r"
    },
    {
        "text": "No, it's from the highway, outside the village.",
        "tag": "name",
        "value": "Skint Farmer"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_421_1#1$1",
        "focus": "r"
    },
    {
        "text": "Oh, God, see what I said... That's what starving people do, they start bashing other people in with hoes!",
        "tag": "name",
        "value": "Skint Farmer"
    },
    {
        "tag": "dialog"
    },
