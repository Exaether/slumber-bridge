    {
        "tag": "character",
        "name": "avg_npc_176"
    },
    {
        "text": "Miss Harmonie?",
        "tag": "name",
        "value": "Enthusiastic Merchant"
    },
    {
        "tag": "character",
        "name": "avg_npc_228_1#7"
    },
    {
        "text": "...Hm?",
        "tag": "name",
        "value": "Harmonie"
    },
    {
        "tag": "character",
        "name": "avg_npc_228_1#1"
    },
    {
        "text": "I'm sorry... I was just thinking about the dance tonight. Say, what color earrings would I be best off wearing?",
        "tag": "name",
        "value": "Harmonie"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
