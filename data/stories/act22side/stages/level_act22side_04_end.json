    },
    {
        "text": "No, Loughshinny.",
        "tag": "name",
        "value": "Eblana"
    },
    {
        "text": "Death is merely there to guide him to his dreams.",
        "tag": "name",
        "value": "Eblana"
    },
    {
        "tag": "dialog"
