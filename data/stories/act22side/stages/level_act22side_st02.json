        "fadetime": 0.5,
        "block": true
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "I believe everything is prepared."
    },
    {
        "text": "All that's left... is my little sister. She is still lost at a crossroads, but she will make the right decision in the end."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
