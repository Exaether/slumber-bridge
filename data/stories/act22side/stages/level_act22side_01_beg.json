            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Bagpipe",
        "text": "Same dress as back in County Hillock... it's the spectre force!"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_222_bpipe_1#1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Bagpipe",
        "text": "Come on, after them\u2014"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_npc_662_1#1$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "Wait, Bagpipe... there's something very strange about them."
    },
