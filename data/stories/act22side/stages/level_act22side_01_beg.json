    {
        "command": "name",
        "value": "Selmon",
        "text": "Hey, you seen Caireann? Woman about this tall, tail swings all around when she walks."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_724_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Selmon",
        "text": "No? Could you look for her around these parts, then, doctor? She hasn't come back since last night."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_725_1#4$1"
        }
    },
    {
        "command": "name",
        "value": "Fionn",
        "text": "Selmon, what's got you so\u2014"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_724_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Selmon",
        "text": "Ah, Fionn, come on here and help us out."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_1020_reed2_1#1$1"
        }
    },
    {
