    {
        "command": "name",
        "value": "Adele",
        "text": "The things I've experienced the last few days have truly been mind-boggling."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1007_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Gentle Creature",
        "text": "That, too, is a part of life."
    },
    {
        "command": "name",
        "value": "Gentle Creature",
        "text": "Are you happy right now, little one?"
