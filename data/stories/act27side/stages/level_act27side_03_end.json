        }
    },
    {
        "command": "name",
        "value": "Gentle Creature",
        "text": "Let me take a look. I believe you are..."
    },
    {
        "command": "name",
        "value": "Gentle Creature",
        "text": "...not very happy right now."
    },
    {
        "command": "name",
        "value": "Gentle Creature",
        "text": "Look over there. She is the proof."
