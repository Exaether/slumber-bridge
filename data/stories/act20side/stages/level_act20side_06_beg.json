    {
        "tag": "character",
        "name": "avg_npc_571_1#11$1",
        "name2": "avg_1026_gvial2_1#5$1",
        "focus": 2
    },
    {
        "text": "Oh, hey, Elysium. How come you're back so soon?",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "tag": "stopmusic",
        "fadetime": 3
    },
    {
        "tag": "character",
        "name": "avg_npc_571_1#11$1",
        "name2": "avg_1026_gvial2_1#5$1",
        "focus": 1
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Elysium"
    },
    {
        "tag": "character",
        "name": "avg_npc_571_1#11$1",
        "name2": "avg_1026_gvial2_1#9$1",
        "focus": 2
    },
    {
        "text": "What happened? Where's Master Edge?",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "tag": "character",
        "name": "avg_npc_571_1#12$1",
        "name2": "avg_1026_gvial2_1#9$1",
        "focus": 1
    },
    {
        "text": "Things have gone a little south, Gavial.",
        "tag": "name",
        "value": "Elysium"
    },
    {
        "tag": "character",
        "name": "avg_npc_571_1#12$1",
        "name2": "avg_1026_gvial2_1#6$1",
        "focus": 2
    },
    {
        "text": "Huh? You mean some giant Originium slug showed up, or what? I heard Provence saw something like that in Siesta.",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "tag": "character",
        "name": "avg_npc_571_1#11$1",
        "name2": "avg_1026_gvial2_1#6$1",
        "focus": 1
    },
    {
        "text": "If it was just some creature, I guarantee I'd be happy to wisecrack with you right now.",
        "tag": "name",
        "value": "Elysium"
    },
    {
        "tag": "character",
        "name": "avg_npc_571_1#9$1"
    },
    {
        "text": "Follow me.",
        "tag": "name",
        "value": "Elysium"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n",
        "volume": 0.7
    },
    {
        "tag": "character",
        "fadetime": 0.5
    },
