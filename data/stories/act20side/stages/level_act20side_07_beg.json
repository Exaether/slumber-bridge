    {
        "tag": "character",
        "name": "char_416_zumama_1#1"
    },
    {
        "text": "Also... High Priest.",
        "tag": "name",
        "value": "Eunectes"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "character",
