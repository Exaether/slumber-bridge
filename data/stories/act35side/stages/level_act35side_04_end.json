    {
        "tag": "subtitle",
        "text": "\u266aThe papyrus reeds sway by the river, its waters of purest lazurite\u266a",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "\u266aIt wends its way by the golden dunes, fed by our gifts of gems\u266a",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "\u266aMay I see Him by the waterside, may I follow Him to eternity\u266a",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
