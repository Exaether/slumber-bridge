    },
    {
        "text": "Mio arrives before the table, having deftly avoided every snare in the heavily-trapped room."
    },
    {
        "text": "The glimmering gem on the table is reflected in the cloudbeast's bright eyes."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
