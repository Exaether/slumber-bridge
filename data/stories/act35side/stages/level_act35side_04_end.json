        "name": "avg_4138_narant_1#2$1",
        "duration": 1
    },
    {
        "tag": "charslot",
        "slot": "left",
        "name": "avg_npc_1477_1#1$1",
        "duration": 1
    },
    {
        "tag": "delay",
