        "fadetime": 2,
        "block": true
    },
    {
        "tag": "playmusic",
        "intro": "$m_dia_street_intro",
        "key": "$m_dia_street_loop",
        "volume": 0.6
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "charslot",
