        "screenadapt": "coverall"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playmusic",
        "key": "$wasteland_loop",
        "volume": 0.6
    },
    {
        "tag": "blocker",
        "a": 0,
