        "focus": 2
    },
    {
        "text": "This is your last chance.",
        "tag": "name",
        "value": "Giovanna"
    },
    {
        "text": "If you walk through those doors, you'll be my enemy. The Rossatis' enemy.",
        "tag": "name",
        "value": "Giovanna"
    },
    {
        "text": "You'll be in our way, and I, as Donna Rossati, have a responsibility to eliminate everything that stands in our way.",
        "tag": "name",
        "value": "Giovanna"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "avg_1028_texas2_1#1$1",
        "name2": "avg_npc_687_1#7$1"
    },
