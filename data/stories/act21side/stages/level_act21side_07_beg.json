        "name2": "avg_npc_687_1#6$1",
        "focus": 2
    },
    {
        "text": "Don't make me do this.",
        "tag": "name",
        "value": "Giovanna"
    },
    {
        "tag": "character",
        "name": "avg_1028_texas2_1#2$1",
        "name2": "avg_npc_687_1#6$1",
        "focus": 1
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Texas"
    },
    {
        "tag": "character",
        "name": "avg_1028_texas2_1#6$1",
        "name2": "avg_npc_687_1#6$1",
        "focus": 1
    },
    {
        "text": "We're just too sentimental, Giovanna.",
        "tag": "name",
        "value": "Texas"
    },
