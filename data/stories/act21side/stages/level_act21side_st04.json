        "fadetime": 0
    },
    {
        "tag": "background",
        "image": "27_g26_dusk_wild",
        "screenadapt": "coverall"
    },
    {
        "tag": "playmusic",
        "intro": "$drift_intro",
        "key": "$drift_loop",
        "volume": 0.6
    },
    {
        "tag": "blocker",
        "a": 0,
