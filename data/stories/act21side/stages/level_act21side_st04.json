    {
        "tag": "subtitle",
        "text": "'Lyudmila, do you know what it means to be my student?'",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "'I'm become decrepit and weak now. Are you still willing to be my student, and my tool?'",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "'We will both regret it, ragazza.'",
        "x": 300,
