    {
        "tag": "playmusic",
        "intro": "$suspenseful_intro",
        "key": "$suspenseful_loop",
        "volume": 0.6
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "image"
    },
    {
        "tag": "playsound",
        "key": "$firestorm"
    },
    {
        "tag": "background",
        "image": "59_g11_castlecorridor_d",
        "screenadapt": "coverall"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "bgeffect",
        "name": "$eb_deathburning",
        "layer": 3
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1020_reed2_1#12$1",
        "focus": "m"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "The noble red dragon loosens her grip in shock, and her sister's body drops to the ground, as cold as it was before her heart was pierced."
    },
    {
        "text": "It is not blood but purple fire that roars from the wound spanning her entire torso. It instantly floods the balcony and flows down the citadel."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$rungeneral"
    },
    {
        "tag": "charslot",
        "duration": 1.5
    },
    {
        "tag": "delay",
        "time": 2.5
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "bgeffect"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "The noble red dragon rushes over to the balcony, but the purple flames of death are even faster."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "background",
        "image": "59_g13_castlebalcony",
        "screenadapt": "coverall"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "bgeffect",
        "name": "$eb_deathburning",
        "layer": 3
    },
    {
