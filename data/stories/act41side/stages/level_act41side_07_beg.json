    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1692_1#8$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Nemos",
        "text": "Even coffins are in short supply, but she is not some nameless nobody. She deserves one."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_1020_reed2_1#12$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Noble Red Dragon",
        "text": "..."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1692_1#6$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Nemos",
        "text": "Is something wrong?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_1020_reed2_1#13$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Noble Red Dragon",
        "text": "No. I'm simply realizing how ugly the path she walked is, a path that even now waves at me invitingly... And it's an invitation I have no choice but to accept."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_1020_reed2_1#1$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Noble Red Dragon",
        "text": "Go, Nemos. I will buy you some time."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1692_1#10$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Nemos",
        "text": "You mean from the dark mist?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_1020_reed2_1#8$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Noble Red Dragon",
        "text": "Yes. If it wants to be a part of the Samhain festivities, I will keep it at bay."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_1020_reed2_1#1$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Noble Red Dragon",
        "text": "I can hardly wait to ask the mist how to return the Red Dragon's flame to darkness."
    },
    {
        "command": "dialog"
    },
    {
        "command": "stopmusic",
        "params": {
            "fadetime": 2
        }
    },
    {
        "command": "blocker",
        "params": {
            "a": 0,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 0,
            "block": true
        }
    },
    {
