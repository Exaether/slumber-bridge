    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "The dead dragon lies on the ground."
    },
    {
        "text": "Behind the living dragon, the wayward wakewoman suddenly understands it all."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
