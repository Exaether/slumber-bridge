    },
    {
        "tag": "playmusic",
        "intro": "$darkness01_intro",
        "key": "$darkness01_loop",
        "volume": 0.6
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
