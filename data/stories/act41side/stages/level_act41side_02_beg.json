        "volume": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "The potatoes in the bag were very small. None had the usual oval shape."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1752_1#1$1",
        "focus": "m"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "My arm!",
        "tag": "name",
        "value": "Anxious Resident"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1688_1#1$1",
        "focus": "m"
    },
    {
        "text": "My God! He's bleeding! How could you turn a blade on a fellow Taran, Rory?!",
        "tag": "name",
        "value": "Friendly Resident"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1686_1#1$1",
        "focus": "m"
    },
    {
        "text": "I, I\u2014",
        "tag": "name",
        "value": "Brooding Resident"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1697_1#8$1",
        "focus": "m"
    },
    {
        "tag": "delay",
        "time": 0.2
    },
    {
        "tag": "playsound",
        "key": "$d_avg_axeimp",
        "volume": 1
    },
    {
        "tag": "camerashake",
        "duration": 0.8,
        "xstrength": 50,
        "ystrength": 50,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1697_1#8$1",
        "focus": "m"
    },
    {
        "text": "Drop the sword.",
        "tag": "name",
        "value": "Culann"
    },
    {
        "text": "Don't make me use my hammer on you.",
        "tag": "name",
        "value": "Culann"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
