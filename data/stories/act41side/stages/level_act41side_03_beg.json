    {
        "text": "Found you!",
        "tag": "name",
        "value": "'The Bureaucrat'"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_clothmovement",
        "volume": 0.7
    },
    {
        "text": "I got it! I got it!",
        "tag": "name",
        "value": "'The Bureaucrat'"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_crowdtalk_fear",
        "loop": true,
        "channel": "bgs",
        "volume": 0
    },
    {
        "tag": "soundvolume",
        "volume": 1,
        "channel": "bgs",
        "fadetime": 2
    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "text": "You've got your bug, now help me get these crystals before they fall into the ditch!",
        "tag": "name",
        "value": "'The Cruel Officer'"
    },
    {
        "text": "Coming\u2014",
        "tag": "name",
        "value": "'The Bureaucrat'"
    },
    {
        "text": "Hold on, I <i>am</i> going to get my cut if I help you, right?",
        "tag": "name",
        "value": "'The Bureaucrat'"
    },
    {
        "text": "Sure, sure! Just hurry! You don't want to see these crystals end up in the ditch, do you?",
        "tag": "name",
        "value": "'The Cruel Officer'"
    },
    {
        "text": "Sweet cloudbeast, you're mine!",
        "tag": "name",
        "value": "'The Torturer'"
    },
    {
        "text": "Good... all the gems on the sword are there...",
        "tag": "name",
        "value": "'The Ombudsman'"
    },
    {
        "text": "Where are The Brigadier and the others?",
        "tag": "name",
        "value": "'The Torturer'"
    },
    {
        "text": "Who cares?",
        "tag": "name",
        "value": "'The Bureaucrat'"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
