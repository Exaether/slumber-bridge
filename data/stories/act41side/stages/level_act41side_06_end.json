    },
    {
        "text": "Traitor.",
        "tag": "name",
        "value": "Brooding Resident"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1692_1#4$1",
        "focus": "m"
    },
    {
        "text": "Have you gone mad?!",
        "tag": "name",
        "value": "Nemos"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1692_1#7$1",
        "focus": "m"
    },
    {
        "text": "Oh, silly me. Of course you have. We all have.",
        "tag": "name",
        "value": "Nemos"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1686_1#1$1",
        "focus": "m"
    },
    {
        "text": "Traitor\u2014",
        "tag": "name",
        "value": "Brooding Resident"
    },
    {
        "tag": "dialog"
    },
    {
