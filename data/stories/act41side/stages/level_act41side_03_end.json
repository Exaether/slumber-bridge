        "name": "avg_npc_1686_1#1$1",
        "focus": "m"
    },
    {
        "text": "The hell's wrong with you, Theo? You have eyes, use them!",
        "tag": "name",
        "value": "Brooding Resident"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_240",
        "focus": "m"
    },
    {
        "text": "S-Sorry, Mr. Rory, I was just hoping to try my luck over at Lagran Street, see if I could get some potatoes\u2014",
        "tag": "name",
        "value": "Theo"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1686_1#1$1",
        "focus": "m"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Get lost!",
        "tag": "name",
        "value": "Brooding Resident"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_240",
        "focus": "m"
    },
    {
        "text": "Sorry...",
        "tag": "name",
        "value": "Theo"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_pcknmgrwl",
        "volume": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Look out! The burdenbeast's panicking! Out of the way!",
