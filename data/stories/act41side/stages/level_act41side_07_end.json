    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Nemos turns to leave, while Loughshinny looks towards the Dark Woods."
    },
    {
        "text": "The sun has set beneath the horizon. Curfew is about to begin."
    },
    {
        "text": "In the distance, she sees the dark mist spreading from the forest towards Na Saoirs\u00ed, thicker than ever."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
