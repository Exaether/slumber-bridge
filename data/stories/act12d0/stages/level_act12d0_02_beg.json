        "params": {
            "name": "char_187_ccheal_1",
            "name2": "char_411_tomimi_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "Yep. Zumama's Eunectes tribe is the strongest one too, now, and everyone thinks she's gonna be the next Chief."
