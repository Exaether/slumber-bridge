            "name2": "char_411_tomimi_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Gavial",
        "text": "Oh, yeah, Tomimi, how about you introduce the Doctor to our place? I've been away for forever. I don't know what's changed."
    },
    {
        "command": "character",
        "params": {
            "name": "char_187_ccheal_1",
            "name2": "char_411_tomimi_1#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "Sure!"
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "Okay, let me think. What should I tell an outsider...? Right, let's start with the tribes."
    },
    {
        "command": "dialog"
    },
