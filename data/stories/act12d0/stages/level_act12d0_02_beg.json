    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "Yeah, so the Doctor's seen it too!"
    },
    {
        "command": "predicate",
        "params": {
            "references": 2
        }
    },
    {
        "command": "character",
        "params": {
            "name": "char_187_ccheal_1",
            "name2": "char_411_tomimi_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "Gavial, your friend doesn't seem like a fashion expert either."
    },
    {
        "command": "predicate",
        "params": {
            "references": 3
        }
    },
    {
        "command": "character",
        "params": {
            "name": "char_187_ccheal_1#3"
        }
    },
    {
        "command": "name",
        "value": "Gavial",
        "text": "Haha. There's something even you don't know, huh."
    },
    {
        "command": "predicate",
        "params": {
            "references": "1;2;3"
        }
    },
    {
        "command": "character",
        "params": {
