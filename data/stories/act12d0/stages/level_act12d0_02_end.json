    {
        "command": "name",
        "value": "Tomimi",
        "text": "Gavial, how come you let them go?"
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "You used to chase down every last person in a fight and beat them until they saw stars."
    },
    {
        "command": "character",
        "params": {
            "name": "char_187_ccheal_1",
            "name2": "char_411_tomimi_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Gavial",
        "text": "Yeah. I used to do that."
    },
    {
        "command": "name",
        "value": "Gavial",
        "text": "But nah, now I just think they're kind of cute. Right, Doctor?"
    },
    {
        "command": "decision",
        "params": {
            "options": "No idea what you're saying, but I agree.;......;Cuter than you breaking them in half.",
