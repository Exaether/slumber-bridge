        }
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "Gavial... you really have changed."
    },
    {
        "command": "character",
        "params": {
            "name": "char_187_ccheal_1#2"
        }
    },
    {
        "command": "name",
        "value": "Gavial",
        "text": "Mm? Hold on, Tomimi, you little brat."
