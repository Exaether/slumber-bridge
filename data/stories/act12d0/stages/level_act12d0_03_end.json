        }
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "That's great! Even if she's a doctor, Gavial's still Gavial!"
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "That's good to know. Gavial hasn't changed. What a relief..."
