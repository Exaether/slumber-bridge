    },
    {
        "tag": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 1
    },
    {
        "text": "No idea. Why don't we bring it back? Leader's sure to like it.",
        "tag": "name",
        "value": "Archosauria A"
    },
    {
        "tag": "character",
        "name": "avg_npc_071",
        "name2": "avg_npc_070",
        "focus": 2
    },
    {
        "text": "Sure, let's take it!",
        "tag": "name",
        "value": "Archosauria B"
    },
    {
