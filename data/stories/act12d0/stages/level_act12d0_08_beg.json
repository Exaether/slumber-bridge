    },
    {
        "text": "Hah!",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "tag": "playsound",
        "key": "$fightgeneral"
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Ahhhh!",
        "tag": "name",
        "value": "Eunectes"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "text": "Gavial wins!",
        "tag": "name",
        "value": "Old Archosauria"
    },
    {
        "text": "Haha, I win again.",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "text": "Hmph, another rematch! I'll definitely win this time!",
        "tag": "name",
        "value": "Eunectes"
    },
    {
        "text": "Sure!",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "playsound",
        "key": "$smallearthquake",
        "volume": 0.4
    },
    {
        "tag": "camerashake",
        "duration": 2,
        "xstrength": 4,
        "ystrength": 4,
        "vibrato": 20,
        "randomness": 30,
        "fadeout": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Eh, why is the ground shaking?",
        "tag": "name",
        "value": "Eunectes"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "text": "Look over there!",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
