        "fadeout": true,
        "block": false
    },
    {
        "text": "Gavial!",
        "tag": "name",
        "value": "Everyone"
    },
    {
        "tag": "character",
        "name": "char_411_tomimi_1"
    },
    {
        "text": "Wahhhh!! Gavial rushed onto the platform!",
        "tag": "name",
        "value": "Tomimi"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
