    },
    {
        "text": "I'm not gonna let you hurt the Doctor, Reunion!",
        "tag": "name",
        "value": "Ceobe"
    },
    {
        "tag": "camerashake",
        "duration": 0.8,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "character",
        "name": "char_2013_cerber_1"
    },
    {
        "text": "Nooo! Don't steal my honey biscuits! Get back here!",
        "tag": "name",
        "value": "Ceobe"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
