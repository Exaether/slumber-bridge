        }
    },
    {
        "command": "name",
        "value": "High Priest",
        "text": "I'm certain Gavial's here to get her engine back!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_074",
            "name2": "char_416_zumama_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Eunectes",
        "text": "...She'll have to go through me to get it."
