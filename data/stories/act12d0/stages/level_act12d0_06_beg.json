    },
    {
        "command": "name",
        "value": "Eunectes",
        "text": "Gavial isn't like that."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_070",
            "name2": "char_416_zumama_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Yogi",
        "text": "Great Chief, I trust Gavial."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_070",
            "name2": "char_416_zumama_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Eunectes",
        "text": "Yes, I trust her too. Your brother will be fine. Where is he?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_070",
            "name2": "char_416_zumama_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Yogi",
        "text": "At Tomimi's tribe."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_070",
            "name2": "char_416_zumama_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Eunectes",
        "text": "Tomimi's... You should go get your brother later."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_070",
            "name2": "char_416_zumama_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Yogi",
        "text": "Understood."
    },
