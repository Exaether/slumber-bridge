        "command": "character",
        "params": {
            "name": "char_337_utage_summer_1#4",
            "name2": "char_201_moeshd_summer",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Croissant",
        "text": "Whassat?"
