        "command": "character",
        "params": {
            "name": "char_337_utage_summer_1"
        }
    },
    {
        "command": "name",
        "value": "Utage",
        "text": "Gavial, I'm borrowing her!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_411_tomimi_1#2"
        }
    },
    {
        "command": "name",
        "value": "Tomimi",
        "text": "Wha? Whaaaaaaa?"
