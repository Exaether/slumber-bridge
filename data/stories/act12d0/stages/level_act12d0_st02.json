        }
    },
    {
        "command": "name",
        "value": "Gavial",
        "text": "Hah, I used to love coming here to bathe."
    },
    {
        "command": "predicate",
        "params": {
            "references": 2
        }
    },
    {
        "command": "character",
        "params": {
