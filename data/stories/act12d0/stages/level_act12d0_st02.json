    },
    {
        "command": "character",
        "params": {
            "name": "char_415_flint_1"
        }
    },
    {
        "text": "Kemar, well aware of the language barrier, communicates with her stance, rather than words."
    },
    {
        "command": "character",
        "params": {
            "name": "char_415_flint_1",
            "name2": "char_017_homura_summer",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Heh. Seeing as I've got nothing else to do, we might as well go a few rounds."
