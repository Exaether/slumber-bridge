    },
    {
        "command": "name",
        "value": "Inam",
        "text": "Yes. And you're here with the machine. Right, it must be you."
    },
    {
        "command": "name",
        "value": "Inam",
        "text": "The one called 'Doctor' asked me to give you this note."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_075",
            "name2": "avg_npc_012",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Dylan",
        "text": "Hm? Let's see here..."
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Dylan",
        "text": "...Lancet-2, looks like we've got work to do."
    },
