    },
    {
        "tag": "playmusic",
        "intro": "$drift_intro",
        "key": "$drift_loop",
        "volume": 0.4
    },
    {
        "text": "W-Where am I...?",
        "tag": "name",
        "value": "Tomimi"
    },
    {
        "text": "Waahh... aahhh... I want to go home...",
        "tag": "name",
        "value": "Tomimi"
    },
    {
        "text": "Agh!",
        "tag": "name",
        "value": "Tomimi"
    },
    {
        "text": "Hey, Tomimi. Are you okay?",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "text": "Gavial...",
        "tag": "name",
        "value": "Tomimi"
    },
    {
        "text": "You're such a pain. I let you out of my sight for one second and you run off to a place like this.",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "text": "Gavial, you're bleeding!",
        "tag": "name",
        "value": "Tomimi"
    },
    {
        "text": "Huh? It's fine, it's just a little cut.",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "text": "Come on, let's go home.",
        "tag": "name",
        "value": "Gavial"
    },
    {
        "tag": "dialog"
    },
    {
