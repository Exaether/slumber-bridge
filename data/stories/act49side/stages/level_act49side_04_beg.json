    {
        "text": "*pant*... *pant*...",
        "tag": "name",
        "value": "Determined Shanhaizhong Member"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "focus": "r"
    },
    {
        "text": "Drop your weapon and live!",
        "tag": "name",
        "value": "Yanese Border Force"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "focus": "m"
    },
    {
        "text": "Drop my weapon?",
        "tag": "name",
        "value": "Determined Shanhaizhong Member"
    },
    {
        "text": "We will teach the House of Yan that Ju has awakened, and their reign is no more than a fleeting dream compared to the infinity of heaven and earth!",
        "tag": "name",
        "value": "Determined Shanhaizhong Member"
    },
    {
        "text": "The mounts, seas, and all in between shall be\u2014",
        "tag": "name",
        "value": "Determined Shanhaizhong Member"
    },
