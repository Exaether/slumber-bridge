        "block": true
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2125_1#1$1"
    },
    {
        "tag": "cameraeffect",
        "effect": "Grayscale",
        "fadetime": 0,
        "keep": true,
        "initamount": 0,
