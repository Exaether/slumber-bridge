    {
        "text": "The space shakes, then warps, and tears..."
    },
    {
        "text": "As if a thousand years worth of martial prowess has been channeled into a single strike, ripping apart the edges of the dream."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
