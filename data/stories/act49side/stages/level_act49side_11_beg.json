        "tag": "image"
    },
    {
        "tag": "background",
        "image": "70_g8_suilingcoreruins",
        "screenadapt": "coverall"
    },
    {
        "text": "Then I will look for you. I always will.",
        "tag": "name",
        "value": "Chongyue"
    },
    {
        "text": "Suit yourself.",
        "tag": "name",
        "value": "Wang"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
