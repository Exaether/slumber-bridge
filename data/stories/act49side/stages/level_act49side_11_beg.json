        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
