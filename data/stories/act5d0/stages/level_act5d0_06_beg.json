    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_105_emper"
    },
    {
        "text": "We got some party crashers. Yo, get behind the bar if you wanna live.",
        "tag": "name",
        "value": "Emperor"
    },
    {
        "tag": "character",
        "name": "char_201_moeshd"
    },
    {
        "text": "Yessir!",
        "tag": "name",
        "value": "Croissant"
    },
    {
        "tag": "character",
        "name": "char_103_angel_1#8"
    },
    {
        "text": "Nice! There's a coin back here.",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "character",
        "name": "char_101_sora_1#3"
    },
    {
        "text": "Don't squirm around, there's not much room back here\u2014\u2014Ow! Watch your halo, Exusiai!",
        "tag": "name",
        "value": "Sora"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1"
    },
    {
        "text": "Stop gawking and get down, Bison.",
        "tag": "name",
        "value": "Texas"
    },
    {
        "tag": "character",
        "name": "char_325_bison_1#2"
    },
    {
        "text": "Huh? Ah!",
        "tag": "name",
        "value": "Bison"
    },
    {
        "tag": "character"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_soldiersrun",
        "volume": 0.5
    },
    {
        "text": "Get 'em!",
        "tag": "name",
        "value": "Mafioso"
    },
