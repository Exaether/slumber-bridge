    },
    {
        "tag": "character"
    },
    {
        "text": "Woah, what're you...?!",
        "tag": "name",
        "value": "Mafioso A"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "text": "...What?",
        "tag": "name",
        "value": "Gambino"
    },
    {
        "tag": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027#2",
        "focus": 2
    },
    {
        "text": "Sounds like we got party crashers.",
        "tag": "name",
        "value": "Capone"
    },
    {
        "tag": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027#2",
        "focus": 1
    },
    {
        "text": "...I shoulda killed you quicker. But now we gotta play host.",
        "tag": "name",
        "value": "Gambino"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "playsound",
        "key": "$fightgeneral"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "text": "Stop 'em! Aagh! My toe...",
        "tag": "name",
        "value": "Mafioso A"
    },
    {
        "text": "What's this, kung fu?! Can't even touch her!",
        "tag": "name",
        "value": "Mafioso B"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$fightgeneral"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "text": "They're unarmed, just get 'em... Oof!",
        "tag": "name",
        "value": "Mafioso A"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
