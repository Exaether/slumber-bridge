    {
        "tag": "character",
        "name": "char_272_strong_1#4",
        "name2": "avg_npc_027#4",
        "focus": 2
    },
    {
        "text": "Hey, I remember you. I met you before. You dressed up like a seafood salesman. Played like you were making finballs.",
        "tag": "name",
        "value": "Capone"
    },
    {
        "text": "Funny. I never thought I'd have to give you a second look.",
        "tag": "name",
        "value": "Capone"
    },
    {
        "tag": "character",
        "name": "char_272_strong_1",
        "name2": "avg_npc_027#4",
        "focus": 1
    },
    {
        "text": "No, I really am a... never mind.",
        "tag": "name",
        "value": "Jaye"
    },
    {
        "tag": "character",
        "name": "char_272_strong_1#4",
        "name2": "avg_npc_027#4",
        "focus": 1
    },
    {
        "text": "Right now, just for tonight, I am what you think I am.",
        "tag": "name",
        "value": "Jaye"
    },
    {
        "tag": "character",
        "name": "char_243_waaifu_1#3"
    },
    {
        "text": "Hai-yah!",
        "tag": "name",
        "value": "Waai Fu"
    },
    {
        "tag": "character",
        "name": "avg_npc_028"
    },
    {
        "text": "Hmph!",
        "tag": "name",
        "value": "Gambino"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$e_skill_skulsrsword",
        "volume": 0.9
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 1,
        "g": 1,
        "b": 1,
        "afrom": 0,
