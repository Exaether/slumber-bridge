    },
    {
        "tag": "character",
        "name": "char_272_strong_1"
    },
    {
        "text": "Soda. Want some?",
        "tag": "name",
        "value": "Jaye"
    },
    {
        "tag": "character",
        "name": "char_201_moeshd#2",
        "name2": "char_272_strong_1",
        "focus": 1
    },
    {
        "text": "Oh. Thank ya kindly. But ain't ya gonna try to stop this little kerfuffle?",
        "tag": "name",
        "value": "Croissant"
    },
    {
        "tag": "character",
        "name": "char_201_moeshd#2",
        "name2": "char_272_strong_1",
        "focus": 2
    },
    {
        "text": "I can't stop it. Looks like you know that already.",
        "tag": "name",
        "value": "Jaye"
    },
    {
        "tag": "character",
        "name": "char_325_bison_1"
    },
    {
        "text": "So we just watch?",
        "tag": "name",
        "value": "Bison"
    },
    {
        "tag": "character",
        "name": "char_272_strong_1"
    },
    {
        "text": "Or I guess we could cheer them on?",
        "tag": "name",
        "value": "Jaye"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
