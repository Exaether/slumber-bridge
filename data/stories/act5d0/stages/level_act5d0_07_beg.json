    {
        "command": "name",
        "value": "Gambino",
        "text": "You're rusty."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_028#3",
            "name2": "avg_npc_027#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Capone",
        "text": "The scars you got in Siracusa are holding you back too."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_028",
            "name2": "avg_npc_027",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Gambino",
        "text": "Just give up. I don't wanna kill you."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_028",
            "name2": "avg_npc_027#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Capone",
        "text": "No, you really do."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_028#4",
            "name2": "avg_npc_027#3",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Gambino",
        "text": "Heh. You know me too well."
    },
