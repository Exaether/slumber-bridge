    {
        "tag": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027#2",
        "focus": 2
    },
    {
        "text": "Wh\u2014\u2014",
        "tag": "name",
        "value": "Capone"
    },
    {
        "tag": "character",
        "name": "char_201_moeshd#2"
    },
    {
        "text": "Well lookie here! I just wanted to bust through this wall and make a nice path... but it looks like I found quite a sight.",
        "tag": "name",
        "value": "Croissant"
    },
    {
        "tag": "character",
        "name": "char_201_moeshd"
    },
    {
        "text": "Sorry to bother ya. You two keep at it. We'll go around.",
        "tag": "name",
        "value": "Croissant"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_soldiersrun",
        "volume": 0.5
    },
    {
        "text": "Hurry! Don't let them get away!",
        "tag": "name",
        "value": "Mafioso"
    },
    {
        "tag": "character",
        "name": "char_325_bison_1"
    },
    {
        "text": "...I think we're out of options.",
        "tag": "name",
        "value": "Bison"
    },
    {
        "tag": "playmusic",
        "intro": "$chasing_intro",
        "key": "$chasing_loop",
        "volume": 0.8,
        "crossfade": 1.5
    },
    {
        "tag": "character",
        "name": "avg_npc_028#4"
    },
    {
        "text": "How about that. Our troublemakers came right to us. We'll just scoop you up and\u2014\u2014",
        "tag": "name",
        "value": "Gambino"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
