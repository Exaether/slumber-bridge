    {
        "command": "name",
        "value": "Capone",
        "text": "Wh\u2014\u2014"
    },
    {
        "command": "character",
        "params": {
            "name": "char_201_moeshd#2"
        }
    },
    {
        "command": "name",
        "value": "Croissant",
        "text": "Well lookie here! I just wanted to bust through this wall and make a nice path... but it looks like I found quite a sight."
    },
    {
        "command": "character",
        "params": {
            "name": "char_201_moeshd"
        }
    },
    {
        "command": "name",
        "value": "Croissant",
        "text": "Sorry to bother ya. You two keep at it. We'll go around."
    },
