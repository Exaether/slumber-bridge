    },
    {
        "tag": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027#4",
        "focus": 1
    },
    {
        "text": "You're rusty.",
        "tag": "name",
        "value": "Gambino"
    },
    {
        "tag": "character",
        "name": "avg_npc_028#3",
        "name2": "avg_npc_027#2",
        "focus": 2
    },
    {
        "text": "The scars you got in Siracusa are holding you back too.",
        "tag": "name",
        "value": "Capone"
    },
    {
        "tag": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027",
        "focus": 1
    },
    {
        "text": "Just give up. I don't wanna kill you.",
        "tag": "name",
        "value": "Gambino"
    },
    {
        "tag": "character",
        "name": "avg_npc_028",
        "name2": "avg_npc_027#3",
        "focus": 2
    },
    {
        "text": "No, you really do.",
        "tag": "name",
        "value": "Capone"
    },
    {
        "tag": "character",
        "name": "avg_npc_028#4",
        "name2": "avg_npc_027#3",
        "focus": 1
    },
    {
        "text": "Heh. You know me too well.",
        "tag": "name",
        "value": "Gambino"
    },
    {
