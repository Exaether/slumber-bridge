    },
    {
        "tag": "character",
        "name": "char_325_bison_1",
        "name2": "char_201_moeshd#3",
        "focus": 2
    },
    {
        "text": "(Sounds like trouble in paradise.)",
        "tag": "name",
        "value": "Croissant"
    },
    {
        "tag": "character",
        "name": "char_325_bison_1",
        "name2": "char_201_moeshd#3",
        "focus": 1
    },
    {
        "text": "(Sure does. This could be good for us, if we...)",
        "tag": "name",
        "value": "Bison"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
