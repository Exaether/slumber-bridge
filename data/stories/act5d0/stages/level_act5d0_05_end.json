            "duration": 1,
            "xstrength": 10,
            "ystrength": 12,
            "vibration": 30,
            "randomness": 90,
            "fadeout": true
        }
    },
    {
        "command": "name",
        "value": "Mafioso A",
        "text": "S- so strong! Agh! Y- you're gonna break my arm! Stop!"
