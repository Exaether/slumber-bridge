    {
        "command": "character",
        "params": {
            "name": "char_272_strong_1#4",
            "name2": "avg_npc_031",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Jaye",
        "text": "Drop your weapon. And get out of my sight."
