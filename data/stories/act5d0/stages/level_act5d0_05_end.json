    {
        "command": "character",
        "params": {
            "name": "char_272_strong_1#4",
            "name2": "avg_npc_031",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Mafioso A",
        "text": "Al- alright already! Just let me go!"
