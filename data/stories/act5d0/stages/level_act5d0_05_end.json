    {
        "command": "character",
        "params": {
            "name": "char_272_strong_1",
            "name2": "avg_npc_031",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Mafioso A",
        "text": "What are you talking about?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_272_strong_1",
            "name2": "avg_npc_031",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Jaye",
        "text": "...nothing. I shouldn't try to copy Waai Fu's battle banter. I'll take the direct approach."
    },
    {
        "command": "name",
        "value": "Jaye",
        "text": "Heh."
    },
    {
        "command": "character",
        "params": {
            "name": "char_272_strong_1",
            "name2": "avg_npc_031",
            "focus": 2
        }
    },
    {
