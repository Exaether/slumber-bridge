        "command": "character",
        "params": {
            "name": "char_325_bison_1",
            "name2": "char_101_sora_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Sora",
        "text": "But hey, it's just something I came up with. Not bad, huh?"
