    },
    {
        "tag": "background",
        "image": "bg_motorway",
        "screenadapt": "coverall"
    },
    {
        "tag": "character",
        "name": "char_105_emper",
        "name2": "char_103_angel_1#8"
    },
    {
        "tag": "cameraeffect",
        "effect": "Grayscale",
