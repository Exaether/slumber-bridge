        "tag": "name",
        "value": "Bison"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1"
    },
    {
        "text": "Nice reflexes, you two.",
        "tag": "name",
        "value": "Texas"
    },
    {
        "tag": "character",
        "name": "char_103_angel_1#4"
    },
    {
        "text": "Whew, they really blew it up, didn't they?",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_105_emper"
    },
    {
