    {
        "command": "character",
        "params": {
            "name": "char_325_bison_1",
            "name2": "char_213_mostma_1#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Mostima",
        "text": "You play it case by case. Like right now we're up here on a bridge, and there's a cargo ship passing down below us."
