        "params": {
            "name": "char_325_bison_1",
            "name2": "char_213_mostma_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Bison",
        "text": "My gut... even a Messenger like you says to trust your gut?"
