    {
        "command": "character",
        "params": {
            "name": "char_325_bison_1",
            "name2": "char_213_mostma_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Mostima",
        "text": "It's pretty obvious what you'd be thinking about at a time like this."
