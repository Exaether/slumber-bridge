    {
        "command": "character",
        "params": {
            "name": "char_325_bison_1",
            "name2": "char_213_mostma_1#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Mostima",
        "text": "And we got three disguised mobsters coming at us from both directions."
