    {
        "text": "...I'm tired of this.",
        "tag": "name",
        "value": "Gambino"
    },
    {
        "tag": "character",
        "name": "avg_npc_028",
        "name2": "char_243_waaifu_1#3",
        "focus": 2
    },
    {
        "text": "Nng\u2014\u2014!",
        "tag": "name",
        "value": "Waai Fu"
    },
