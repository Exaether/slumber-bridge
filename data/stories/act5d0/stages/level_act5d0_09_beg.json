    {
        "command": "character",
        "params": {
            "name": "avg_npc_034#3",
            "name2": "char_272_strong_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "Thank you. You are Ah Fil. I've heard your story."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_034#3",
            "name2": "char_272_strong_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Jaye",
        "text": "You're the one Uncle always talks about..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_034#3",
            "name2": "char_272_strong_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "Heh, my old friend."
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "I thank you for helping Lungmen put a stop to them. And I thank you for your pursuit of justice."
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "Now, please leave."
    },
    {
        "command": "character",
        "params": {
            "name": "char_243_waaifu_1#3"
        }
    },
    {
        "command": "name",
        "value": "Waai Fu",
        "text": "But..."
    },
    {
        "command": "stopmusic",
        "params": {
