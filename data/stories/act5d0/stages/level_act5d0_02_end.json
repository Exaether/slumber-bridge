    {
        "text": "Ow... I was thrown clear...?",
        "tag": "name",
        "value": "Bison"
    },
    {
        "tag": "character"
    },
    {
        "text": "Thank heaven for guard rails. Otherwise we'd be a puddle down there.",
        "tag": "name",
        "value": "Mafioso A"
    },
    {
        "text": "Hurry up! Pull me out!",
        "tag": "name",
        "value": "Mafioso B"
    },
    {
        "tag": "character",
        "name": "char_325_bison_1#4"
    },
    {
        "text": "They're trying to get away! Stay on them!",
        "tag": "name",
        "value": "Bison"
    },
    {
        "tag": "camerashake",
        "duration": 0.4,
        "xstrength": 8,
