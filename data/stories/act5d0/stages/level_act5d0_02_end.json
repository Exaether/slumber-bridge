    },
    {
        "command": "name",
        "value": "Female Tourist",
        "text": "I know what you mean. Like, you're selling finballs, why do you have a big knife on the counter there?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_032",
            "name2": "avg_npc_033",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Male Tourist",
        "text": "The Foodie Guide says the owner is an old man called 'The Godly Finball Uncle.'"
    },
    {
        "command": "name",
        "value": "Male Tourist",
        "text": "He couldn't be some kind of triad or something..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_272_strong_1"
        }
    },
    {
        "command": "name",
        "value": "Jaye",
        "text": "Hm? Did you want something else?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_032"
        }
    },
    {
        "command": "name",
        "value": "Female Tourist",
        "text": "Oh, no."
