        "fadetime": 2,
        "block": true
    },
    {
        "tag": "imagetween",
        "xFrom": 0,
        "yFrom": 0,
        "xTo": -30,
        "yTo": 0,
        "xScale": 0.9,
        "yScale": 0.9,
        "duration": 15,
        "block": false
    },
    {
        "text": "Heh heh... you really are impressively clever.",
        "tag": "name",
        "value": "Rat King"
    },
    {
        "text": "The flames react to your will. Will you put me in the ground tonight?",
        "tag": "name",
        "value": "Rat King"
    },
    {
        "text": "How could I?",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "text": "I respect my elders, and care for the young.",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 10,
        "ystrength": 12,
