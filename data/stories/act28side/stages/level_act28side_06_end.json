        "intro": "$ponder_intro",
        "key": "$ponder_loop",
        "volume": 0.6
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1039_1#1$1",
        "duration": 0.5
    },
    {
        "tag": "charslot",
        "slot": "r",
