        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Sylvie, are you sure you want to work in a bank back home? You know... I don't want my position to get in the way of what <i>you</i> want, especially with a decision as important as this one.",
        "tag": "name",
        "value": "Gentle Voice"
    },
    {
        "text": "...I'm so proud of you, my daughter.",
        "tag": "name",
        "value": "Gentle Voice"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
