        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Are you serious, Sylvie? That's the best financial institution in all of Columbia... Goodness gracious, I can't believe my daughter actually made it! I'm so, so proud of you, I really can't say it enough!",
        "tag": "name",
        "value": "Gentle Voice"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
