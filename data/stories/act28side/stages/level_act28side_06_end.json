        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Top of your class again? ...Golly, how did someone like me give birth to a kid as smart as you? I couldn't be more proud of you, Sylvie.",
        "tag": "name",
        "value": "Gentle Voice"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "background",
