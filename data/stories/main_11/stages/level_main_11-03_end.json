    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "name",
        "value": "Catherine",
        "text": "Think it's dull, don't you?"
    },
    {
        "command": "name",
        "value": "Catherine",
        "text": "Hold onto your hammer and spanner tight."
    },
    {
        "command": "name",
        "value": "Catherine",
        "text": "If you really want to do something, you've got to persevere."
    },
    {
        "command": "name",
        "value": "Catherine",
        "text": "You strike once, and you get nothing more than a hunk of beaten metal."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_648_1#2$1"
        }
    },
    {
        "command": "name",
        "value": "Catherine",
        "text": "You strike again and again, and you can make steam armor."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_648_1#10$1"
        }
    },
    {
        "command": "name",
        "value": "Catherine",
        "text": "You strike again and again, and then your child, and your children's children carry on striking\u2014"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_648_1#1$1",
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "name",
        "value": "Catherine",
        "text": "And we've got Londinium."
    },
    {
        "command": "dialog"
    },
