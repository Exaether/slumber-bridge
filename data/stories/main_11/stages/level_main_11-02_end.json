    {
        "command": "subtitle",
        "params": {
            "text": "The night drags on.",
            "x": 300,
            "y": 370,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "The night drags on."
    },
    {
        "command": "subtitle",
        "params": {
            "text": "For so long that the children hear every tale of the Steam Knights told in Londinium, and first light has just broken.",
            "x": 300,
            "y": 370,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "For so long that the children hear every tale of the Steam Knights told in Londinium, and first light has just broken."
    },
    {
        "command": "subtitle",
        "params": {
            "text": "The sound of artillery stops sooner than they expected. Past the witching hour, the streets outside have more or less returned to silence. But no words are needed as they all continue to stay huddled indoors. No one dares rush to see the state out there.",
            "x": 300,
            "y": 370,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "The sound of artillery stops sooner than they expected. Past the witching hour, the streets outside have more or less returned to silence. But no words are needed as they all continue to stay huddled indoors. No one dares rush to see the state out there."
    },
    {
        "command": "subtitle",
        "params": {
            "text": "Near to every Londinier has been awake the whole night.",
            "x": 300,
            "y": 370,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "Near to every Londinier has been awake the whole night."
    },
    {
        "command": "subtitle",
        "params": {
            "text": "The same question circles in everyone's minds\u2014come next morning, will Londinium be different?",
            "x": 300,
