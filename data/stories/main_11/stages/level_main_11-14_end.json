        "focus": 1
    },
    {
        "text": "These statues...",
        "tag": "name",
        "value": "Siege"
    },
    {
        "tag": "character",
        "name": "avg_npc_407_1#8$1",
        "name2": "avg_npc_397_1#4$1",
        "focus": 2
    },
    {
        "text": "They're the kings of Victoria.",
        "tag": "name",
        "value": "Allerdale"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "text": "Phantoms roam here."
    },
    {
        "text": "Not the spirits of the dead... but a shadow of history and memory."
    },
    {
        "tag": "backgroundtween",
        "xFrom": 0,
        "yFrom": 0,
        "xTo": 0,
        "yTo": 0,
        "xScaleFrom": 1,
