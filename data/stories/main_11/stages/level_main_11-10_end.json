        }
    },
    {
        "command": "name",
        "value": "Allerdale",
        "text": "What's the matter, Vina?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_407_1#2$1",
            "name2": "avg_npc_397_1#9$1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Siege",
        "text": "......"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_407_1#1$1",
            "name2": "avg_npc_397_1#9$1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Siege",
        "text": "Never mind. Let's keep going."
    },
    {
        "command": "dialog"
    },
