        }
    },
    {
        "command": "name",
        "value": "Victorian Soldier",
        "text": "Wait, where did all these men come from?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_399_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Victorian Mercenary",
        "text": "Save your breath, unless you are willing to cough up the coin."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_241"
        }
    },
    {
        "command": "name",
        "value": "Victorian Soldier",
        "text": "Mercenaries... Who sent you? Which duke?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character",
        "params": {
