            "randomness": 90,
            "fadeout": true,
            "block": false
        }
    },
    {
        "command": "name",
        "value": "Victorian Soldier",
        "text": "Do not give ground. Not one of you! We will hold the line here!"
    },
    {
        "command": "name",
        "value": "Victorian Soldier",
        "text": "We are soldiers. We trust our commander."
    },
    {
        "command": "name",
        "value": "Victorian Soldier",
        "text": "We must follow our orders."
    },
