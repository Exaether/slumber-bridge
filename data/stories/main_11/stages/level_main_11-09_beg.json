    },
    {
        "command": "name",
        "value": "Rockrock",
        "text": "We don't know any dukes, and they certainly wouldn't know us."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_241"
        }
    },
    {
        "command": "name",
        "value": "Victorian Soldier",
        "text": "Are... Are you the rebels?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_4040_rockr_1#10$1"
        }
    },
    {
        "command": "name",
        "value": "Rockrock",
