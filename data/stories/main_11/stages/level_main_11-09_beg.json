    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_241"
        }
    },
    {
        "command": "name",
        "value": "Victorian Soldier",
        "text": "Self-... Salvation Corps..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_4040_rockr_1#10$1"
        }
    },
    {
        "command": "name",
        "value": "Rockrock",
        "text": "You know what this is about."
    },
    {
        "command": "name",
        "value": "Rockrock",
        "text": "You should've been the ones fighting the Sarkaz, but you chose to raise the white flag. That left us no choice but to rise up ourselves."
