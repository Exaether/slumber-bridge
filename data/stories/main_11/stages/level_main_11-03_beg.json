    {
        "command": "name",
        "text": "Oi, has the last batch of polymer prep come in yet?",
        "value": "Londinium Worker"
    },
    {
        "command": "camerashake",
        "params": {
            "duration": 0.3,
            "xstrength": 30,
            "ystrength": 30,
            "vibration": 30,
