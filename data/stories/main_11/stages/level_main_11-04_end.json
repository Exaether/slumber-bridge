        "focus": 1
    },
    {
        "text": "You've put on a few inches, brat.",
        "tag": "name",
        "value": "Catherine"
    },
    {
        "tag": "character",
        "name": "avg_npc_648_1#10$1",
        "name2": "avg_4072_ironmn_1#4$1",
        "focus": 2
    },
    {
        "text": "Yeah, I grew a little bit.",
        "tag": "name",
        "value": "Feist"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
