    },
    {
        "text": "Sorry, Doctor...",
        "tag": "name",
        "value": "Feist"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "avg_4072_ironmn_1#8$1",
        "focus": -1
    },
    {
        "tag": "decision",
        "options": "I thought I was just coming home with you.;Are we not welcome?",
        "values": "1;2"
    },
    {
        "tag": "predicate",
        "references": "1;2"
    },
    {
        "tag": "character",
        "name": "avg_4072_ironmn_1#9$1"
    },
    {
        "text": "I had, er, a little fight with Granny when I skipped out of the factory last year.",
        "tag": "name",
        "value": "Feist"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playsound",
        "key": "$d_gen_soldiersrun",
        "volume": 1
    },
    {
        "tag": "character",
        "name": "avg_npc_660_1#1$1",
        "name2": "char_empty",
        "fadetime": 0.5
    },
    {
        "tag": "delay",
        "time": 0.51
    },
    {
        "tag": "character",
        "name": "char_empty",
