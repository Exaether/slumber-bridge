            "name": "char_263_skadi#3",
            "duration": 1
        }
    },
    {
        "command": "delay",
        "value": 2
    },
    {
        "command": "charslot"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_1023_ghost2_1#12$1"
        }
    },
    {
        "command": "name",
        "value": "Specter",
        "text": "Finished with your chat?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_474_gladiia_1#1"
        }
    },
    {
        "command": "name",
        "value": "Gladiia",
        "text": "Yes."
    },
    {
        "command": "name",
        "value": "Gladiia",
        "text": "It's past time we left, Hunters."
    },
    {
        "command": "stopmusic",
        "params": {
            "fadetime": 2
        }
    },
    {
        "command": "dialog"
    },
