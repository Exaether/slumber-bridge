    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "text": "I gotcha!",
        "tag": "name",
        "value": "Vermeil"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "character",
        "name": "char_279_excu_4#6"
    },
    {
        "text": "You did not.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_190_clour"
    },
    {
        "text": "Eeh?!",
        "tag": "name",
        "value": "Vermeil"
    },
    {
        "tag": "character",
        "name": "char_279_excu_4#6"
    },
    {
        "text": "Pardon.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
