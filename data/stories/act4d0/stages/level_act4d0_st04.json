    {
        "text": "\u266a Do you hear the thunderclap? \u266a"
    },
    {
        "text": "\u266a See the clouds blanket the peaks \u266a"
    },
    {
        "text": "\u266a Long forgotten faces, long forgotten things \u266a"
    },
    {
        "text": "\u266a Find the way back to Vermeil \u266a"
    },
    {
        "text": "\u266a Take me home \u266a"
    },
    {
        "text": "\u266a Bright red clouds \u266a"
    },
