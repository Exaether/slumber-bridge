    },
    {
        "text": "Target escaped out the window. Quick response time.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Environment analyzed. Cured fowl meat, tanning bench, processed animal skins, worked with wooden tools and small knives.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Drop the bow. I am aware of your position, hiding behind the window.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "I repeat, I bear you no ill will.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_190_clour"
    },
    {
        "text": "\u2014\u2014No way!",
        "tag": "name",
        "value": "Vermeil"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "camerashake",
