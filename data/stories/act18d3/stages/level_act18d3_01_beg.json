    {
        "tag": "subtitle",
        "text": "She pulls open the door to the treatment ward.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "The bed is empty.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle"
    },
