        "block": false
    },
    {
        "text": "Ouch!",
        "tag": "name",
        "value": "Male Inhabitant B"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "There\u2014There is a hole here.",
        "tag": "name",
        "value": "Male Inhabitant B"
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_178",
        "focus": 2
    },
    {
        "text": "Woodframe's hole. You forgot.",
        "tag": "name",
        "value": "Male Inhabitant A"
    },
    {
        "tag": "character",
        "name": "avg_1012_skadiSP_1#4"
    },
    {
        "text": "Oh, it comes in handy after all.",
        "tag": "name",
        "value": "Skadi"
    },
    {
        "tag": "character",
        "name": "avg_npc_178"
    },
    {
        "text": "Those from outside, to our place, you should not have come!",
        "tag": "name",
        "value": "Male Inhabitant A"
    },
