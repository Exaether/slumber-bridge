    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#3",
        "fadetime": 1.5
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#3",
        "focus": 2
    },
    {
        "text": "Hey, Drywall, good morning!",
        "tag": "name",
        "value": "Anita"
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#3",
        "focus": 1
    },
    {
        "text": "Sheetmetal...",
        "tag": "name",
        "value": "Male Inhabitant B"
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#2",
        "focus": 2
    },
    {
        "text": "Oh yeah, where did Sheetmetal go? You never go anywhere without each other.",
        "tag": "name",
        "value": "Anita"
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#2",
        "focus": 1
    },
    {
        "text": "Sheetmetal.",
        "tag": "name",
        "value": "Male Inhabitant B"
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#2",
        "focus": 2
    },
    {
        "text": "Are you looking out... to the sea?",
        "tag": "name",
        "value": "Anita"
    },
    {
        "text": "Does this mean... It was Sheetmetal who got the red seashell last night?",
        "tag": "name",
        "value": "Anita"
    },
    {
        "text": "*Sigh*...",
        "tag": "name",
        "value": "Anita"
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#2",
        "focus": 1
    },
    {
        "text": "Woodframe, my condition got worse.",
        "tag": "name",
        "value": "Male Inhabitant B"
    },
    {
        "text": "My chest is bloating like it's about to blow.",
        "tag": "name",
        "value": "Male Inhabitant B"
    },
    {
        "text": "I don't even want to eat. Leave me alone.",
        "tag": "name",
        "value": "Male Inhabitant B"
    },
    {
        "tag": "character",
        "name": "avg_npc_187",
        "name2": "avg_npc_180#4",
        "focus": 2
    },
    {
        "text": "*Sigh*...",
        "tag": "name",
        "value": "Anita"
    },
    {
        "tag": "dialog"
    },
