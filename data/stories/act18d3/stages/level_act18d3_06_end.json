    {
        "tag": "subtitle",
        "text": "The girl closes her eyes and lets go as she is told.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "The force gripping onto her leg quickly disappears. She can hear all sorts of tiny trinkets splashing into the water. Just before she herself touches the surface of the sea, a force pulls her upward and sends her back to dry land again.",
        "x": 300,
        "y": 370,
        "alignment": "left",
        "size": 24,
        "delay": 0.04,
        "width": 720
    },
    {
        "tag": "subtitle",
        "text": "\u2014She lands face first.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
