        "block": true
    },
    {
        "tag": "subtitle",
        "text": "The singer stops her fingers, but the harmony formed by her harp and voice together does not simply disappear because of that.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "It yet remains with the wanderer herself, creating an open seam in the thick dust.",
        "x": 300,
        "y": 370,
