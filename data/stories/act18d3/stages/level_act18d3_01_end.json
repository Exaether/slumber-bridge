        "blackstart": 0.4,
        "blackend": 0.6,
        "name2": "avg_npc_183#3",
        "blackstart2": 0.2,
        "blackend2": 0.4,
        "focus": 1
    },
    {
        "text": "Commander. The coast is clean now.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "This place is void of all living\u2014er, excepting this outsider who can't stand still and stinks to high Heaven.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "avg_npc_182#1",
        "blackstart": 0.4,
        "blackend": 0.6,
        "name2": "avg_npc_183#3",
        "blackstart2": 0.2,
        "blackend2": 0.4,
        "focus": 2
    },
    {
        "text": "What did you see?",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "avg_npc_007"
    },
    {
        "text": "I... I...",
        "tag": "name",
        "value": "Bounty Hunter"
    },
    {
        "text": "Please, I haven't done anything! I swear it, I, I was only lost, I was too careless to end up here, I didn't mean to...",
        "tag": "name",
        "value": "Bounty Hunter"
    },
    {
        "text": "Look, I have gold coins, and plenty of other stuff too, damnit, I've lost so much... Take this money, this equipment, all of it, I just beg you to let me go!",
        "tag": "name",
        "value": "Bounty Hunter"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 40,
        "ystrength": 40,
        "vibrato": 30,
