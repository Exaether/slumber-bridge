    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Ugh\u2014",
        "tag": "name",
        "value": "Bounty Hunter"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n"
