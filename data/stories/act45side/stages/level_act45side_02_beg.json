    {
        "command": "name",
        "value": "Lost Girl",
        "text": "For two days and two nights, I haven't seen a single soul..."
    },
    {
        "command": "name",
        "value": "Lost Girl",
        "text": "Which... which way is Lungmen? Which way is home?"
    },
    {
        "command": "name",
        "value": "Lost Girl",
        "text": "Dad, Mom... I'm thirsty... I'm tired..."
    },
    {
        "command": "name",
        "value": "Lost Girl",
        "text": "Are those... buildings, afar?"
    },
    {
        "command": "charslot",
        "params": {
