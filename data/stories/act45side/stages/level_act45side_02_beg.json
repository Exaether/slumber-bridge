    {
        "command": "name",
        "value": "Voice on the Phone",
        "text": "Us folks at home been having a great year for wheat. Out'n the fields afore sunup, harvestin' away till sundown."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4185_amoris_1#8$3",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Nyamu Y\u016btenji",
        "text": "What? Y'all don't listen when I tell ya, huh? Take it easy, slow down. Enjoy country livin'."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4185_amoris_1#8$3",
            "focus": "n"
        }
    },
    {
        "command": "name",
        "value": "Voice on the Phone",
        "text": "Jus' don't want you to go wearin' yourself too thin, sweetie. Y'get weary out there, come home and take a break."
    },
    {
        "command": "name",
        "value": "Voice on the Phone",
        "text": "Say, sweetie, whaddya wanna eat for the holidays? Me and Dad'll whip you up somethin'..."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4185_amoris_1#3$4",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Nyamu Y\u016btenji",
