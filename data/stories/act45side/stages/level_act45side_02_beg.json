    {
        "command": "name",
        "value": "Scriptwriter",
        "text": "*Shangshu dialect* You don't know that because you're not from the countryside! Well, I am, and I know!"
    },
    {
        "command": "name",
        "value": "Director",
        "text": "I'll show you, third-rate hack writer\u2014"
    },
