    {
        "tag": "subtitle",
        "text": "<i>Before the gaze of thousands upon thousands, I am still as a doll.</i>",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "<i>I go where they want me to go. I make the sounds they want me to make.</i>",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "<i>I do not fear love.</i>",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
