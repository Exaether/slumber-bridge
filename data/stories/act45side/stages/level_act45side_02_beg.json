    },
    {
        "text": "My dream's to be the best drummer in Lungmen\u2014no, in all of Terra!",
        "tag": "name",
        "value": "Voice on TV"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4185_amoris_1#3$4",
        "focus": "m"
    },
    {
        "text": "......",
