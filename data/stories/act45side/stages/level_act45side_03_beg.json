    {
        "text": "The rain patters against the ground, washing Siracusa's every stain away."
    },
    {
        "text": "The girl steps into the alley. It is clean and tidy, so utterly spotless as to seem newly built."
    },
    {
        "text": "Siracusa's cleaners are consummate professionals."
    },
    {
        "text": "Not the slightest stench of blood hangs in the humid air."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#2$3",
        "duration": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#2$3",
        "focus": "m"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Sakiko Togawa"
    },
    {
        "text": "Umiri... where are you?",
        "tag": "name",
        "value": "Sakiko Togawa"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#2$3",
        "focus": "n"
    },
    {
        "text": "You... You looking for Umiri?",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#2$3",
        "focus": "m"
    },
    {
        "tag": "delay",
        "time": 1
