    {
        "command": "name",
        "value": "Father",
        "text": "...Sakiko?!"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1940_1#2$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Father",
        "text": "What brings you back all of a sudden? I thought you were busy with work?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4182_oblvns_1#12$2",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Sakiko Togawa",
        "text": "I am... We have a field mission, so I thought I would drop by."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1940_1#6$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Father",
        "text": "You've hardly ever written home! Every day, I've been reading the few letters you did send over and over."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4182_oblvns_1#12$2",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Sakiko Togawa",
        "text": "They're no more than simple letters. You needn't..."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1940_1#6$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Father",
        "text": "How could they be <i>no more than</i> letters when they're written by my dear daughter?!"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4182_oblvns_1#6$2",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Sakiko Togawa",
        "text": "Father, I think something's burning..."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1940_1#2$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Father",
        "text": "\u2014!"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1940_1#4$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Father",
        "text": "Just hold on!"
