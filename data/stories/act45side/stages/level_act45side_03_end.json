    {
        "command": "name",
        "value": "Francis",
        "text": "The don's dead, everyone's dead! We had hundreds of people, and now it's just our dozen left!"
    },
    {
        "command": "name",
        "value": "Francis",
        "text": "We busted our asses moving from Columbia to this stupid place, but you had to go and get everyone killed!"
    },
    {
        "command": "dialog"
    },
