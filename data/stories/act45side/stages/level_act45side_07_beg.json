    {
        "text": "Sakiko, just how long have you been away from home? Aren't you the clingy one today?",
        "tag": "name",
        "value": "Mother"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#2$2",
        "focus": "m"
    },
    {
        "text": "Home...",
        "tag": "name",
        "value": "Sakiko Togawa"
