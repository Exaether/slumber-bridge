    {
        "tag": "musicvolume",
        "volume": 0.6,
        "fadetime": 2
    },
    {
        "text": "You've gotten so good at the piano!",
        "tag": "name",
        "value": "Mother"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#10$2",
        "focus": "m"
    },
    {
        "text": "D-Do you think so?",
        "tag": "name",
        "value": "Sakiko Togawa"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1941_1#5$1",
        "focus": "m"
    },
    {
        "text": "I know better than anyone how much you've changed. I'm your mother, after all.",
        "tag": "name",
        "value": "Mother"
    },
    {
        "text": "I can hear it all\u2014how hard you've been working... I know your job must be so hectic, and yet you've kept up with your piano practice.",
        "tag": "name",
        "value": "Mother"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#6$2",
        "focus": "m"
    },
    {
        "text": "Huh?",
        "tag": "name",
        "value": "Sakiko Togawa"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1941_1#5$1",
        "focus": "m"
    },
    {
        "text": "It seems you've gone through quite a lot out there...",
        "tag": "name",
        "value": "Mother"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "playsound",
        "key": "$doorknockquite",
        "volume": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Hate to disturb you two while you're practicing! Supper's ready?",
        "tag": "name",
        "value": "Father"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
