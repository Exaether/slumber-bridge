            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Sakiko Togawa",
        "text": "Are we going to Victoria to find Ann?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_290_vigna_1#11$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Vigna",
        "text": "Who's Ann? Do you know, Iris?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_338_iris_1#4$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Iris",
        "text": "I don't. Is that a friend of yours who lives there?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4182_oblvns_1#14$2",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Sakiko Togawa",
        "text": "What...? You don't know her, Iris?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4182_oblvns_1#10$2",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Sakiko Togawa",
        "text": "Then Vigna and I..."
    },
    {
