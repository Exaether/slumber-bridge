    },
    {
        "tag": "charslot"
    },
    {
        "text": "Her heart rate is ragged, her breathing is out of control, and her back is soaked with sweat."
    },
    {
        "text": "Sakiko's consciousness has returned to her body once more, albeit in this most awful, unbecoming manner."
    },
    {
        "tag": "dialog"
    },
