    {
        "text": "You kept hopping from group to group, yet you never found a place to truly belong... Is this really the life you want?",
        "tag": "name",
        "value": "Sakiko Togawa"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#12$2",
        "focus": "m"
    },
    {
        "text": "You should never have had to bear this pain...",
        "tag": "name",
        "value": "Sakiko Togawa"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4182_oblvns_1#12$2",
        "focus": "m"
    },
    {
        "text": "Umiri, let's get out of here. Together.",
        "tag": "name",
        "value": "Sakiko Togawa"
    },
