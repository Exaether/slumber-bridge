        "text": "<i>Up on this beautiful stage, we act out a vibrant monodrama.</i>",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "<i>I do not fear death.</i>",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
