    },
    {
        "text": "The staircase stretches on and on... until Viviana sees a door in an inconspicuous corner."
    },
    {
        "text": "A tiny, familiar door."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4098_vvana_1#2$1"
    },
    {
