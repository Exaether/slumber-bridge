    {
        "text": "Attempting to turn left at each intersection, to ensure progress through continuous deviation.",
        "tag": "name",
        "value": "Federico"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1032_excu2_1#1$1"
    },
    {
        "text": "Unsuccessful.",
        "tag": "name",
        "value": "Federico"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1032_excu2_1#1$1"
    },
    {
        "text": "Attempting to descend.",
