    },
    {
        "tag": "background",
        "image": "bg_rhodeslowerdeck",
        "screenadapt": "showall"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
