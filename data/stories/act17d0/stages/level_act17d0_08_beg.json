    {
        "tag": "character",
        "name": "avg_npc_166",
        "name2": "char_456_ash_1#2",
        "focus": 1
    },
    {
        "text": "I'm afraid it won't be that simple. Look there...",
        "tag": "name",
        "value": "Schwarz"
    },
    {
        "tag": "character",
        "name": "avg_npc_166",
        "name2": "char_456_ash_1#1",
        "focus": 2
    },
    {
        "text": "...I hope it's not what I think it is...",
        "tag": "name",
        "value": "Ash"
    },
