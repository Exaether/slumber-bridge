    {
        "text": "Rangers's map stops here.",
        "tag": "name",
        "value": "Ash"
    },
    {
        "text": "It's all up to us now.",
        "tag": "name",
        "value": "Ash"
    },
    {
        "tag": "character",
        "name": "char_457_blitz_1#4"
    },
    {
        "text": "Who knew this cave would be so big?",
        "tag": "name",
        "value": "Blitz"
    },
    {
        "text": "It's like the ground beneath the town is completely hollow.",
        "tag": "name",
        "value": "Blitz"
    },
    {
        "tag": "character",
        "name": "avg_npc_166",
        "name2": "char_456_ash_1#2",
        "focus": 2
    },
    {
        "text": "Are the explosives okay?",
        "tag": "name",
        "value": "Ash"
