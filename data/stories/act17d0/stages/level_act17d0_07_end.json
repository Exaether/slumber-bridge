    },
    {
        "tag": "character",
        "name": "char_459_tachak_1#2"
    },
    {
        "text": "...No promises.",
        "tag": "name",
        "value": "Tachanka"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "character",
        "name": "char_503_rang",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "text": "You didn't tell her the truth. You're not going to run.",
        "tag": "name",
        "value": "Tachanka"
    },
    {
        "tag": "character",
        "name": "char_503_rang",
        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "text": "Hahaha... You didn't have to go blowing this old man's scheme.",
        "tag": "name",
        "value": "Rangers"
    },
    {
        "text": "You need someone to hold these monsters back.",
        "tag": "name",
        "value": "Rangers"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
