        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "text": "Alexsandr, take this.",
        "tag": "name",
        "value": "Frost"
    },
    {
        "tag": "character",
        "name": "char_458_rfrost_1#3",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "text": "What's this?",
        "tag": "name",
        "value": "Tachanka"
    },
    {
        "tag": "character",
        "name": "char_458_rfrost_1#3",
        "name2": "char_459_tachak_1#2",
        "focus": 1
    },
    {
        "text": "An Originium bomb I tried my hand at making. There's only two left.",
        "tag": "name",
        "value": "Frost"
    },
    {
        "tag": "character",
        "name": "char_458_rfrost_1#3",
        "name2": "char_459_tachak_1#2",
        "focus": 2
    },
    {
        "text": "...Thanks.",
        "tag": "name",
        "value": "Tachanka"
    },
    {
        "tag": "character",
        "name": "char_458_rfrost_1#4"
    },
    {
        "text": "Stay alive!",
        "tag": "name",
        "value": "Frost"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopmusic",
        "fadetime": 1
