        "name2": "avg_npc_156_1#1",
        "focus": 2
    },
    {
        "text": "Is this... a Rhodes Island emergency rescue signal?",
        "tag": "name",
        "value": "Liskarm"
    },
    {
        "tag": "character",
        "name": "avg_npc_155_1#1",
        "name2": "avg_npc_156_1#1",
        "focus": 1
    },
    {
        "text": "Is it another Rhodes Island field team, maybe?",
        "tag": "name",
        "value": "Franka"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playsound",
        "key": "$d_gen_transmissionget",
        "volume": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "...oh, thank hea......meone finally answered!",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "...pl......help us......equesting support...",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playmusic",
        "intro": "$nervous_intro",
        "key": "$nervous_loop",
        "volume": 0.4
    },
    {
        "tag": "character",
        "name": "avg_npc_156_1#2"
    },
    {
        "text": "This is a Rhodes Island Field Personnel Team. If you receive this, please reply.",
        "tag": "name",
        "value": "Liskarm"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "This is......Long Spring......Watchtower 33...",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "...mob......currently...",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "...they've come in!",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_503_rang"
    },
    {
        "text": "Calm down! Operator, tell us what's happened!",
        "tag": "name",
        "value": "Rangers"
    },
    {
        "tag": "character",
        "name": "avg_npc_156_1#1"
    },
    {
        "text": "The signal's very poor. They're coming through intermittent.",
        "tag": "name",
        "value": "Liskarm"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 15,
        "ystrength": 15,
        "vibrato": 20,
        "randomness": 70,
        "fadeout": true,
        "block": false
    },
    {
        "text": "...help us......plea......ing you\u2014",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopmusic"
    },
