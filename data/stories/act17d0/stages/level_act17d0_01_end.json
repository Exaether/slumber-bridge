    {
        "tag": "subtitle",
        "text": "Meandering tunnels lined by frames of cast concrete, set in a particular yet strange pattern.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "The things in here were never meant to be here.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "Within gray-white metal walls, instruments and devices not of this world wind up into operation.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "And within a culture chamber, manufactured of clear glass, Originium enveloped in connective tissue floats.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "It contracts. It relaxes. It convulses.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
