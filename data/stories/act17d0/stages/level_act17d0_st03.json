    {
        "command": "name",
        "value": "Human Resources Operator",
        "text": "Your information has been registered with Rhodes Island. You may stay and resupply at Rhodes Island field offices, or safehouses across Terra."
    },
    {
        "command": "name",
        "value": "Human Resources Operator",
        "text": "Although you are not official employees of Rhodes Island, the mission network is open to you and you will be paid for contracts you complete."
    },
    {
        "command": "name",
        "value": "Human Resources Operator",
        "text": "That's about it. Is there anything else you'd like to know?"
    },
