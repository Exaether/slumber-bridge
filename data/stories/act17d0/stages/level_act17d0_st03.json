    {
        "command": "name",
        "value": "Tachanka",
        "text": "So these are our new identities."
    },
    {
        "command": "name",
        "value": "Blitz",
        "text": "At least I've got a shield I can use. Could be worse."
    },
    {
        "command": "name",
        "value": "Frost",
        "text": "Do we have a plan?"
    },
    {
        "command": "name",
        "value": "Ash",
        "text": "Try to take a look at this world, which we now know too little about."
