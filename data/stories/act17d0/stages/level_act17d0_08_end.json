    {
        "tag": "subtitle",
        "text": "Arrows fall like rain on the ground in front of the manor, piercing Originiutant skulls and throats with precision.",
        "x": 300,
        "y": 370,
        "alignment": "left",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "The black downpour continues uninterrupted, like a storm sweeping across the land.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
