    },
    {
        "command": "name",
        "value": "Liskarm",
        "text": "The crystal electronics unit may be too damaged. Or there may be some damage somewhere else in the circuit we can't see with the naked eye."
    },
    {
        "command": "name",
        "value": "Liskarm",
        "text": "We don't have any equipment for repairing Originium circuits here, so we can't troubleshoot."
    },
    {
        "command": "character",
        "params": {
