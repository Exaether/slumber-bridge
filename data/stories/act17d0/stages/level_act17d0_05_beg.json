        "name2": "avg_npc_156_1#1",
        "focus": 2
    },
    {
        "text": "We can't power the comm casting unit.",
        "tag": "name",
        "value": "Liskarm"
    },
    {
        "tag": "character",
        "name": "avg_npc_155_1#1",
        "name2": "avg_npc_156_1#1",
        "focus": 1
    },
    {
        "text": "It's a power problem?",
        "tag": "name",
        "value": "Franka"
    },
    {
        "tag": "character",
        "name": "avg_npc_155_1#1",
        "name2": "avg_npc_156_1#1",
        "focus": 2
    },
    {
        "text": "Maybe... I'll have to see.",
        "tag": "name",
        "value": "Liskarm"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
