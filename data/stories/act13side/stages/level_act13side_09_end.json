    },
    {
        "tag": "subtitle",
        "text": "A tower with no survivors.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.5,
        "block": true
    },
