            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "Huh?!"
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "She came back? Where is she?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_npc_929_1#8$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Estara",
        "text": "It must be her! Look\u2014"
    },
    {
        "command": "dialog"
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_avg_cloakmovement",
            "volume": 0.7
        }
    },
    {
        "command": "delay",
        "value": 2
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_npc_928_1#4$1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "A new blanket from Mamma? It's a little torn..."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_npc_928_1#3$1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "But there are pictures of circles on it! And people with wings! Like what Mamma promised us!"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_npc_929_1#3$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Estara",
        "text": "Who cares if it's a little torn? Mamma's clothes are torn too. We have to be good."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_npc_928_1#1$1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "I know, I know."
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "Let's go and find Senior Federico!"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_npc_929_1#8$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Estara",
        "text": "Can we play with Senior Federico today?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_npc_928_1#1$1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "No, silly, we're going to tell Senior Federico that Mamma came back to see us last night, so he doesn't need to worry!"
    },
