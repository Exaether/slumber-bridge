    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "Morning, Sara... it's time to wake up..."
    },
    {
        "command": "name",
        "value": "Erendel",
        "text": "Mm... mmm... zzz..."
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot",
