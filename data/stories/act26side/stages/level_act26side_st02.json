        }
    },
    {
        "command": "name",
        "value": "Estara",
        "text": "Eren! Wake up, Eren!"
    },
    {
        "command": "name",
        "value": "Estara",
        "text": "Mamma came back yesterday!"
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot",
