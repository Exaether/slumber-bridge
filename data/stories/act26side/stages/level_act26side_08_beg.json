    },
    {
        "text": "...Equipment normal.",
        "tag": "name",
        "value": "Federico"
    },
    {
        "text": "The only loss has been one communicator.",
        "tag": "name",
        "value": "Federico"
    },
    {
        "text": "Current objective remains unchanged. Proceeding with mission.",
        "tag": "name",
        "value": "Federico"
    },
    {
        "text": "Locked onto suspect.",
        "tag": "name",
        "value": "Federico"
    },
