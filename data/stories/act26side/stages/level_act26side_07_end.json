            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Abbot",
        "text": "It'll be alright."
    },
    {
        "command": "name",
        "value": "Abbot",
        "text": "All who dwell in the Sanctilaminium Ambrosii are welcome in this chapel. That's how things have been for the last ten years."
    },
    {
        "command": "name",
        "value": "Abbot",
        "text": "Sit up front, Sural. Just like always. No need to worry."
    },
    {
        "command": "name",
        "value": "Abbot",
        "text": "Laterans do not interrupt a communion in progress."
    },
