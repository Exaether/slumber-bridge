    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "And so...",
        "tag": "name",
        "value": "Raimund"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_931_1#8$1",
        "focus": "m"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Raimund"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_931_1#1$1",
        "focus": "m"
    },
    {
        "text": "That'll do it...",
        "tag": "name",
        "value": "Raimund"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
