    },
    {
        "text": "......",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Hah, the flowers weren't blooming this early last year. Funny timing now, hm?",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_931_1#1$2",
        "bstart": 0,
        "bend": 0,
        "duration": 0.5,
        "focus": "m"
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_931_1#1$2",
        "focus": "m"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "No complaints, though. One last bloom for the road.",
        "tag": "name",
        "value": "Raimund"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "tag": "playsound",
        "key": "$d_avg_cloakmovement"
    },
    {
