    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "charslot"
    },
    {
        "text": "(Hush! Hold your breath...)",
        "tag": "name",
        "value": "Raimund"
    },
    {
        "text": "(...?!)",
        "tag": "name",
        "value": "Fortuna"
    },
    {
        "text": "(Someone's coming!)",
        "tag": "name",
        "value": "Raimund"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopmusic",
        "fadetime": 1
    },
