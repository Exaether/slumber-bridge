    {
        "text": "The sound of knocking echoes through the hall."
    },
    {
        "text": "The door creaks open, and the unusually bright rays of the moon pour in through the gap."
    },
    {
        "text": "There is a figure standing in the moonlight."
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Cl\u00e9ment"
    },
    {
        "text": "Senior Federico...",
        "tag": "name",
        "value": "Cl\u00e9ment"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
