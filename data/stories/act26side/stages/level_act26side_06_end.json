    },
    {
        "text": "\u2014\u2014",
        "tag": "name",
        "value": "Federico"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_924_1#5$1",
        "focus": "m"
    },
    {
        "text": "Senior Federico... I bring you Gerald's last words.",
        "tag": "name",
        "value": "Cl\u00e9ment"
    },
    {
        "text": "He begs you take the head of the fugitive Holst and his weapon...",
        "tag": "name",
        "value": "Cl\u00e9ment"
    },
    {
        "text": "In exchange, spare Fortuna and Raimund...",
        "tag": "name",
        "value": "Cl\u00e9ment"
    },
    {
        "text": "Spare the other Sarkaz.",
        "tag": "name",
        "value": "Cl\u00e9ment"
    },
