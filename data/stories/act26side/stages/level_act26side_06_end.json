    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_355_1#3$1",
        "focus": "m"
    },
    {
        "text": "\u2014!",
        "tag": "name",
        "value": "Oren"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_355_1#9$1",
        "focus": "m"
    },
    {
        "text": "Who's there?!",
        "tag": "name",
        "value": "Oren"
    },
    {
        "tag": "dialog"
    },
