        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_926_1#5$1",
        "bstart": 0.05,
        "bend": 0.13,
        "duration": 0.5
    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_923_1#10$1"
    },
    {
        "text": "Reverend Executor! This is most unusual!",
        "tag": "name",
        "value": "Abbot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1032_excu2_1#1$1"
    },
    {
        "text": "I'm finished.",
        "tag": "name",
        "value": "Federico"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_926_1#6$1",
        "duration": 1
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Gerald"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_372_1#8$1"
    },
    {
        "text": "You really just went for it...",
        "tag": "name",
        "value": "Richele"
    },
    {
        "text": "But, this definitely something. Your Excellency, can I ask you to explain what's going on here?",
        "tag": "name",
        "value": "Richele"
    },
    {
        "text": "In the heart of a Lateran monastery\u2013",
        "tag": "name",
        "value": "Richele"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_372_1#5$1"
    },
    {
        "text": "Why have we found a Sarkaz?",
        "tag": "name",
        "value": "Richele"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_923_1#7$1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Abbot"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_926_1#1$1"
    },
    {
        "text": "Well, I guess that's that...",
        "tag": "name",
        "value": "Gerald"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1032_excu2_1#10$1"
    },
    {
        "text": "I apologize if you find this offensive.",
        "tag": "name",
        "value": "Federico"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1032_excu2_1#1$1"
    },
    {
        "text": "But what are you doing here?",
        "tag": "name",
        "value": "Federico"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_926_1#1$1"
    },
    {
        "text": "I already told you. I'm just a hunter. Gerald, the hunter.",
        "tag": "name",
        "value": "Gerald"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_926_1#4$1"
    },
    {
        "text": "Unfortunately... It doesn't look like you believe me.",
        "tag": "name",
        "value": "Gerald"
    },
