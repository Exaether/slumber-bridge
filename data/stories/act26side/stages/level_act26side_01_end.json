    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_926_1#5$2"
    },
    {
        "text": "Hey! Don't!",
        "tag": "name",
        "value": "Gerald"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playmusic",
        "intro": "$suspenseful_intro",
