        "focus": "r"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Raggedly-Dressed Boy"
    },
    {
        "tag": "charslot",
        "slot": "left",
        "name": "avg_npc_929_1#6$1",
        "focus": "l"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Raggedly-Dressed Girl"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_490_1#1$1"
    },
    {
        "text": "My name is Arturia. Would you mind telling me yours?",
        "tag": "name",
        "value": "Arturia"
    },
