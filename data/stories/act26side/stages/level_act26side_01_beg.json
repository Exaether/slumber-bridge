    },
    {
        "tag": "background",
        "image": "39_g7_chapel",
        "screenadapt": "coverall"
    },
    {
        "tag": "playmusic",
        "intro": "$darkness01_intro",
        "key": "$darkness01_loop",
        "volume": 0.6
    },
    {
        "tag": "blocker",
