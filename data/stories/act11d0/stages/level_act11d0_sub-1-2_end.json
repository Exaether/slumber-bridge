[
    {
        "text": "\u4e5d\u5c3e\u72d0\u6d3b\u52a8 \u652f\u7ebf2",
        "tag": "header",
        "key": "title_test",
        "is_skippable": true,
        "fit_mode": "BLACK_MASK"
    },
    {
