    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "Such a young child... she's an operator?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_367_swllow_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "GreyThroat",
        "text": "Amiya isn't much older than Lisa, you know."
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_367_swllow_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "Yeah..."
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "We did not plan for this rescue, nor do we have the protective equipment. Are you going to be okay?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_367_swllow_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "GreyThroat",
        "text": "Yes."
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_367_swllow_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "What a surprise. They always said you couldn't handle working around Originium. I was worried."
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_367_swllow_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "GreyThroat",
        "text": "I've had enough of tragedy is all. Saving lives is what matters. Cut the chatter."
    },
