        "text": "Schultz!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "avg_npc_069#3",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "...I know."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066"
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "You two are Infected experts, yes?"
    },
    {
        "command": "name",
