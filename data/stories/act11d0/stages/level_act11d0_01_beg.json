    {
        "text": "2:10 P.M. \\ Clear"
    },
    {
        "text": "Wolumonde, Leithanien. Once a bustling hub of commerce, this nomadic town is now rarely seen by outsiders."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
