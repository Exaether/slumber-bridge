    {
        "text": "Nng...",
        "tag": "name",
        "value": "Tatjana"
    },
    {
        "text": "Where am I...?",
        "tag": "name",
        "value": "Tatjana"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
