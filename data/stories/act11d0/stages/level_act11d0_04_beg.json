    {
        "command": "name",
        "value": "Click",
        "text": "It's... awful..."
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "A fire. It's already been dealt with. And some time has passed. But..."
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "Here. Rhodes Island supply crates. With dates, serial numbers, everything."
    },
    {
        "command": "name",
        "value": "Click",
        "text": "There's an outline in the ash. Looks like there was something rectangular sitting on the box?"
    },
    {
        "command": "dialog"
    },
