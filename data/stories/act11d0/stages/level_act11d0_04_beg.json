    },
    {
        "command": "name",
        "value": "Severin",
        "text": "As strong as she is, I forgot she's just another girl trying her hardest to move on. Same age as Tatjana too."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "char_358_lisa_1#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Suzuran",
        "text": "Tatjana is... holding up."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "char_358_lisa_1#3",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "I know."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "char_358_lisa_1#2",
            "focus": 2
        }
    },
    {
        "command": "camerashake",
        "params": {
            "duration": 0.3,
            "xstrength": 10,
            "ystrength": 12,
            "vibration": 30,
            "randomness": 90,
            "fadeout": false
        }
    },
    {
        "command": "name",
        "value": "Suzuran",
        "text": "Hey! I told you to quit smoking!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "char_358_lisa_1#2",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "Maybe..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "char_358_lisa_1#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Suzuran",
        "text": "Smoking will only make your bronchitis worse!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "char_358_lisa_1#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Suzuran",
        "text": "..."
    },
    {
        "command": "name",
        "value": "Suzuran",
        "text": "Are... are you...?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066",
            "name2": "char_358_lisa_1#3",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "You got it, little fox. You're sharper than I expected."
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "But do me a favor and keep it to yourself."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
