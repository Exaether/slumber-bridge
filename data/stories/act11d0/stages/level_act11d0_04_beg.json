    {
        "command": "character",
        "params": {
            "name": "char_345_folnic_1#4"
        }
    },
    {
        "command": "name",
        "value": "Folinic",
        "text": "......"
    },
    {
        "command": "character",
        "params": {
            "name": "char_358_lisa_1#3",
            "name2": "char_345_folnic_1#4",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Suzuran",
        "text": "Do you... feel any better, Miss Folinic?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_358_lisa_1#3",
            "name2": "char_345_folnic_1#4",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Folinic",
        "text": "Yes."
    },
    {
        "command": "character",
        "params": {
            "name": "char_345_folnic_1#4",
            "name2": "avg_npc_066",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "Quite impressive, exhibiting such resilience at your age."
    },
    {
        "command": "character",
        "params": {
            "name": "char_345_folnic_1#3",
            "name2": "avg_npc_066",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Folinic",
        "text": "I know my eyes are swollen. Are you mocking me?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_345_folnic_1#3",
            "name2": "avg_npc_066",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "You lost a good friend and you're still keeping your calm. What could I possibly mock you about?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_345_folnic_1#4",
            "name2": "avg_npc_066",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Folinic",
        "text": "......"
    },
    {
        "command": "name",
        "value": "Folinic",
        "text": "...Things aren't over yet."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_066"
        }
    },
    {
        "command": "name",
        "value": "Severin",
        "text": "You're right, it isn't. Now, I hope we can work together."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
