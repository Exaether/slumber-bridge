        }
    },
    {
        "command": "name",
        "value": "Townsfolk",
        "text": "Got it!"
    },
    {
        "command": "name",
        "value": "Townsfolk",
        "text": "Tatjana, that one at the end of the street... do you know him?"
    },
    {
        "command": "dialog"
