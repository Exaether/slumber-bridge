    {
        "tag": "playmusic",
        "intro": "$nervous_intro",
        "key": "$nervous_loop",
        "volume": 0.4
    },
    {
        "tag": "character",
        "name": "avg_npc_066#5",
        "name2": "avg_npc_069#4",
        "focus": 2
    },
    {
        "text": "No, those explosions are coming from... underground?!",
        "tag": "name",
        "value": "Tatjana"
    },
    {
        "tag": "character",
        "name": "avg_npc_068"
    },
    {
        "text": "Severin! They're over at the workshops! They came through a tunnel on the next street over!",
        "tag": "name",
        "value": "Townsfolk"
    },
    {
        "text": "They crippled the main power plant!",
        "tag": "name",
        "value": "Townsfolk"
    },
