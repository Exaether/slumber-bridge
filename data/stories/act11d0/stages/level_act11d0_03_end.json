        "randomness": 90,
        "fadeout": true
    },
    {
        "tag": "character",
        "name": "avg_npc_066",
        "name2": "avg_npc_069#4",
        "focus": 2
    },
    {
        "text": "Wh-what? Another attack?",
        "tag": "name",
        "value": "Tatjana"
    },
    {
        "tag": "character",
        "name": "avg_npc_066#5",
        "name2": "avg_npc_069#4",
        "focus": 1
    },
    {
        "text": "At this point, every bandit for miles must know we have no Gendarmerie here.",
        "tag": "name",
        "value": "Severin"
    },
    {
        "text": "So what can we do? Get down on our knees and beg for mercy? Or fight to the bitter end?",
        "tag": "name",
        "value": "Severin"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$smallearthquake",
        "volume": 0.6
    },
    {
        "tag": "camerashake",
        "duration": 3,
        "xstrength": 4,
        "ystrength": 4,
        "vibrato": 20,
        "randomness": 30,
        "fadeout": true
