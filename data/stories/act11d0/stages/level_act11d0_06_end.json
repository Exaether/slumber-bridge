        "block": true
    },
    {
        "tag": "playmusic",
        "intro": "$nervous_intro",
        "key": "$nervous_loop",
        "volume": 0.4
    },
    {
        "tag": "character",
        "name": "avg_npc_068",
        "name2": "avg_npc_065"
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 8,
        "ystrength": 6,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "They think they can destroy our homes and get away with it?!",
        "tag": "name",
        "value": "Townsfolk"
    },
    {
        "text": "They trashed my shop, and beat my children!",
        "tag": "name",
        "value": "Townsfolk"
    },
    {
        "text": "Those damned traitors! Ingrates! After all we gave them!",
        "tag": "name",
        "value": "Townsfolk"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "character",
        "name": "avg_npc_065"
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 8,
        "ystrength": 6,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "We have to fight back!",
        "tag": "name",
        "value": "Townsfolk"
    },
    {
        "tag": "character",
        "name": "avg_npc_068"
    },
    {
        "text": "Fight back! Fight back! Fight back!",
        "tag": "name",
        "value": "Townsfolk"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
