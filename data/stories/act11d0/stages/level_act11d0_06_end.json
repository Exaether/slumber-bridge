    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Folinic"
    },
    {
        "tag": "character",
        "name": "char_358_lisa_1#3",
        "name2": "char_345_folnic_1#4",
        "focus": 1
    },
    {
        "text": "Did you hear that, Folinic?",
        "tag": "name",
        "value": "Suzuran"
    },
    {
        "text": "We've been going in circles.",
        "tag": "name",
        "value": "Suzuran"
    },
    {
        "tag": "character",
        "name": "char_358_lisa_1#3",
        "name2": "char_345_folnic_1#4",
        "focus": 2
    },
    {
        "text": "A Catastrophe Messenger thought dead is actually leading the mob?",
        "tag": "name",
        "value": "Folinic"
    },
    {
        "text": "Biederman, huh...?",
        "tag": "name",
        "value": "Folinic"
    },
    {
        "tag": "dialog"
    },
