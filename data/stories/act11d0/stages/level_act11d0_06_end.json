    {
        "command": "name",
        "value": "Mudrock",
        "text": "No."
    },
    {
        "command": "name",
        "value": "Mudrock",
        "text": "Just... musing."
    },
    {
        "command": "name",
        "value": "Mudrock",
        "text": "Winter is coming. And we will have no choice."
    },
