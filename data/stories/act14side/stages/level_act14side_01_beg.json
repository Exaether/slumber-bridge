    },
    {
        "tag": "image",
        "image": "24_i02",
        "fadetime": 2,
        "xScale": 2,
        "yScale": 2,
        "x": -700,
        "y": 0
    },
    {
        "tag": "imagetween",
        "xScaleTo": 2,
        "yScaleTo": 2,
        "duration": 10,
        "xTo": -800,
        "yTo": 50,
        "block": false
    },
    {
        "text": "Aside, Courier wears his eternal smile, listening to every word quietly and respectfully. But from time to time, the faraway look in his eyes carries a hint of something unclear."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "image"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "image",
        "image": "24_i02",
        "fadetime": 2,
        "xScale": 2,
        "yScale": 2,
        "x": 700,
        "y": 0
    },
    {
        "tag": "imagetween",
        "xScaleTo": 2,
        "yScaleTo": 2,
        "duration": 10,
        "xTo": 800,
        "yTo": 50,
        "block": false
    },
    {
        "text": "Sharp reclines against the seat browsing net pages. He'll find that the contents of Kjerag's internet far exceed his expectations."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "image"
    },
    {
        "tag": "blocker",
