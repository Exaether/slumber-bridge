    {
        "text": "Sir, have some water.",
        "tag": "name",
        "value": "Matterhorn"
    },
    {
        "text": "You haven't had so much as a sip since yesterday. You still have a hunt later. This is too...",
        "tag": "name",
        "value": "Matterhorn"
    },
    {
        "tag": "character",
        "name": "avg_172_svrash_1#1$1",
        "name2": "avg_199_yak_1#6$1",
        "focus": 1
    },
    {
        "text": "No need.",
        "tag": "name",
        "value": "Enciodes"
    },
    {
        "tag": "character",
        "name": "avg_172_svrash_1#1$1",
        "name2": "avg_199_yak_1#1$1",
        "focus": 2
    },
    {
        "text": "But\u2013\u2013",
        "tag": "name",
        "value": "Matterhorn"
    },
    {
        "tag": "character",
        "name": "avg_172_svrash_1#1$1",
        "name2": "avg_199_yak_1#1$1",
        "focus": 1
    },
    {
        "text": "This is my decision.",
        "tag": "name",
        "value": "Enciodes"
    },
    {
        "tag": "character",
        "name": "avg_172_svrash_1#5$1",
        "name2": "avg_199_yak_1#1$1",
        "focus": 1
    },
    {
        "text": "Don't make me say this twice, Matterhorn.",
        "tag": "name",
        "value": "Enciodes"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
