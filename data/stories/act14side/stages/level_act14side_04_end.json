    },
    {
        "tag": "character",
        "name": "avg_198_blackd_1#8$1",
        "name2": "avg_199_yak_1#1$1",
        "focus": 1
    },
    {
        "text": "Phew...",
        "tag": "name",
        "value": "Weiss"
    },
    {
        "tag": "character",
        "name": "avg_198_blackd_1#5$1",
        "name2": "avg_199_yak_1#1$1",
        "focus": 1
    },
    {
        "text": "It's cold. The snowstorm is getting stronger, isn't it?",
        "tag": "name",
        "value": "Weiss"
    },
