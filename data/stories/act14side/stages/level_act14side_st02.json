    {
        "text": "The head of the train gallops over the bridge, segment after segment following behind it. Flames begin to dance, as if awakened by the weight of the train."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "avg_206_gnosis_1#2$1",
        "blackstart": 0.05,
        "blackend": 0.2,
        "fadetime": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "The youth turns to face the crowd and snaps his fingers."
    },
    {
        "tag": "dialog"
    },
