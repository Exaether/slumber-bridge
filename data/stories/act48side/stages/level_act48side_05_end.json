            "focus": "r"
        }
    },
    {
        "command": "delay",
        "value": 2.5
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_1022_flwr2_1#9$2",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "text": "What is Lydia...?",
        "value": "Lena"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_1022_flwr2_1#18$2",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "text": "Well, she wouldn't meet with me, and I doubt I can convince her, even if we did meet.",
        "value": "Lena"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_1022_flwr2_1#4$2",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Lena",
        "text": "But Xanthos and Lykeion need to be tried fairly. I can't let Lydia make a mistake like this. What do I do?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "l",
            "name": "avg_1022_flwr2_1#4$2"
        }
    },
