        "slot": "l",
        "name": "avgnew_482_pallas_1#20$1"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_4056_titi_1#12$2"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "style": "slider",
        "inverse": true,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_4056_titi_1#12$2",
        "focus": "r"
    },
    {
        "text": "Feeling better, Pallas?",
        "tag": "name",
        "value": "Titi"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avgnew_482_pallas_1#20$1",
        "focus": "l"
    },
    {
        "text": "I'm fine. I just inhaled some smoke.",
        "tag": "name",
        "value": "Pallas"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avgnew_482_pallas_1#1$1",
        "focus": "l"
    },
    {
        "text": "We should be good to go back to the room in ten minutes. I'll help you take the harp to the First Temple, just in case anything else happens.",
        "tag": "name",
        "value": "Pallas"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_4056_titi_1#9$2",
        "focus": "r"
    },
    {
        "text": "Thanks.",
        "tag": "name",
        "value": "Titi"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_clothmovement"
    },
    {
