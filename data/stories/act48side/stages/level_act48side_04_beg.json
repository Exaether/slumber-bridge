        "duration": 2.5,
        "focus": "all"
    },
    {
        "tag": "delay",
        "time": 0.3
    },
    {
        "tag": "charslot",
        "slot": "r",
        "posfrom": "40,0",
        "posto": "0,0",
        "duration": 2,
        "focus": "all"
    },
    {
        "tag": "delay",
        "time": 3
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_4056_titi_1#12$2",
        "focus": "r"
    },
    {
        "text": "Don't worry, the harp's unharmed!",
        "tag": "name",
        "value": "Titi"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avgnew_482_pallas_1#19$1",
        "focus": "l"
    },
    {
        "text": "I was asking about YOU!",
        "tag": "name",
        "value": "Pallas"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_4056_titi_1#11$2",
        "focus": "r"
    },
    {
        "text": "Speaking of earthquakes... good thing the relic is well-protected.",
        "tag": "name",
        "value": "Titi"
    },
    {
        "text": "What's all the commotion downstairs?",
        "tag": "name",
        "value": "Titi"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avgnew_482_pallas_1#20$1",
        "focus": "l"
    },
    {
        "text": "Looks like a boat rammed straight into the hotel kitchen.",
        "tag": "name",
        "value": "Pallas"
    },
