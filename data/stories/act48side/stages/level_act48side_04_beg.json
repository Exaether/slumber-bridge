        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "A fire? Oh no, oh no! My luggage is still in my room!",
        "tag": "name",
        "value": "Panicking Guest"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2088_1#1$1",
        "focus": "m"
    },
    {
        "text": "Don't worry, the fire's in the first-floor kitchen. It's not going to spread to the guestrooms upstairs. Just wait for them to put out the fire and the smoke to disperse.",
        "tag": "name",
        "value": "Peace Officer"
    },
    {
        "text": "Stop crowding and clear the area around the door! There are still people coming down from upstairs\u2014",
        "tag": "name",
        "value": "Peace Officer"
    },
    {
        "text": "Sir! Now's not the time to go inside!",
        "tag": "name",
        "value": "Peace Officer"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "style": "slider",
        "inverse": true,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "charslot"
    },
    {
