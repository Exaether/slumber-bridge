        "focus": "l"
    },
    {
        "text": "What happened?! Everything okay, Titi?",
        "tag": "name",
        "value": "Pallas"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "posfrom": "240,0",
