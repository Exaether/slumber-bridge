        "name": "avg_npc_2070_1#1$1",
        "focus": "m"
    },
    {
        "text": "Caught you!",
        "tag": "name",
        "value": "Hek\u00e1demos"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
