            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Titi",
        "text": "I can see the frustration and yearning in your eyes."
    },
    {
        "command": "name",
        "value": "Titi",
        "text": "You want to cross swords with the Sargonians, face to face. This is your heroic spirit."
    },
    {
        "command": "name",
        "value": "Titi",
        "text": "Here is your chance. Come. As a Sargonian, I owe you this battle."
    },
    {
        "command": "dialog"
