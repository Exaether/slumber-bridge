        "tag": "background",
        "image": "69_g13_generalroom_n",
        "screenadapt": "coverall",
        "block": true
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
