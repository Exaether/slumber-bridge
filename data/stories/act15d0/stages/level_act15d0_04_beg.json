    {
        "text": "......",
        "tag": "name",
        "value": "Jailer"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "character",
        "name": "char_214_kafka_1#4",
        "name2": "char_440_Pinecone",
        "focus": 1
    },
    {
        "text": "Oop, here come the jailers. Work's 'boutta start. Catch you at the clinic later.",
        "tag": "name",
        "value": "Kafka"
    },
    {
        "text": "You'd better hustle. Who knows, these people might get scrappy again soon.",
        "tag": "name",
        "value": "Kafka"
    },
    {
        "tag": "character",
        "name": "char_214_kafka_1#4",
        "name2": "char_440_Pinecone",
        "focus": 2
    },
    {
        "text": "Mm-hm. Kafka, you take care too.",
        "tag": "name",
        "value": "Mina"
    },
    {
        "tag": "dialog"
