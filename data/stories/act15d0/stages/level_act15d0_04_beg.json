    },
    {
        "tag": "musicvolume",
        "volume": 0.4,
        "fadetime": 1
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
