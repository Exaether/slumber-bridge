            "blackstart2": 0.13,
            "blackend2": 0.25,
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Robin",
        "text": "Who're you?!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_451_robin#2",
            "name2": "avg_npc_137#9",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Jailer",
        "text": "My name is Jesselton, Miss Robin."
    },
    {
        "command": "character",
        "params": {
            "name": "char_451_robin#2",
            "name2": "avg_npc_137#6",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Jesselton",
        "text": "Don't you worry, I'm just like you. I'm one of the hitmen sent in here to take out Anthony."
    },
    {
        "command": "character",
        "params": {
            "name": "char_451_robin#2",
            "name2": "avg_npc_137#9",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Jesselton",
        "text": "An' I so happened to hear Mr. Anthony inviting you to break out..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_451_robin#2",
            "name2": "avg_npc_137#9",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Robin",
        "text": "...?!"
    },
    {
        "command": "dialog"
    },
