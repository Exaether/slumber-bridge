    {
        "text": "Waaait, whoah, what even happened? Why're we duking it out now?",
        "tag": "name",
        "value": "Kafka"
    },
    {
        "tag": "playsound",
        "key": "$fightgeneral",
        "volume": 0.5
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 10,
        "ystrength": 10,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "tag": "camerashake",
        "xstrength": 2,
        "ystrength": 2,
