        }
    },
    {
        "command": "name",
        "value": "Jailer B",
        "text": "Oh, Superintendent. Time's up?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_135#4"
        }
    },
    {
        "command": "name",
        "value": "Barton",
        "text": "I don't give a hoot which way the time is, it's our duty as jailers to manage the prisoners!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_134"
        }
    },
    {
        "command": "name",
        "value": "Jailer A",
        "text": "Yes, sir."
    },
    {
        "command": "name",
        "value": "Jailer A",
