    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1114_1#3$1"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
