    {
        "tag": "sticker",
        "id": "st1",
        "text": "'In these futures, and perhaps ones even further away...",
        "x": 300,
        "y": 300,
        "alignment": "center",
        "size": 28,
        "delay": 0,
        "duration": 2.5,
        "width": 700
    },
    {
        "tag": "sticker",
        "id": "st2",
        "text": "'Are the people I love still there?'",
        "x": 300,
        "y": 380,
        "alignment": "center",
        "size": 28,
        "delay": 0,
        "duration": 2.5,
        "width": 700
