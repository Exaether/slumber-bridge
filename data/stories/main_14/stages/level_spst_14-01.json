    },
    {
        "tag": "background",
        "image": "40_g2_glacier",
        "screenadapt": "coverall",
        "block": true
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_969_1#1$3"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_968_1#10$1"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
