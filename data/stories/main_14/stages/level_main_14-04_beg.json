        "duration": 1
    },
    {
        "tag": "delay",
        "time": 2.5
    },
    {
        "text": "A red light flashes a few times in the deep shadows."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "bgeffect"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Isn't it your job to protect her?",
        "tag": "name",
        "value": "Millscar"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
