    {
        "text": "Abandoned Mansion, Londinium Outskirts"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_399_1#1$1",
        "duration": 0.7
    },
    {
        "tag": "charslot",
