        "focus": "m"
    },
    {
        "text": "\u2014Phew.",
        "tag": "name",
        "value": "Millscar"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1342_1#8$1",
        "focus": "m"
    },
    {
        "text": "Well, this is easier than expected.",
        "tag": "name",
        "value": "Millscar"
    },
    {
        "text": "I thought it would be tougher.",
        "tag": "name",
        "value": "Millscar"
    },
    {
        "text": "No scruples. No acts to put up.",
        "tag": "name",
        "value": "Millscar"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1342_1#9$1",
        "focus": "m"
    },
    {
        "text": "I found <i>Victoria</i>.",
        "tag": "name",
        "value": "Millscar"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopmusic",
        "fadetime": 1
    },
    {
        "tag": "charslot",
        "duration": 0.5
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playsound",
        "key": "$d_avg_steamrelease"
    },
    {
        "tag": "bgeffect",
        "name": "$eb_glow_l",
        "layer": 1,
        "x": -500,
