    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "Long time no see.",
        "tag": "name",
        "value": "Nian"
    },
    {
        "tag": "character",
        "name": "avg_322_lmlee_1#10$1"
    },
    {
        "text": "Hm? You're a... Rhodes Islander...",
        "tag": "name",
        "value": "Lee"
    },
    {
        "tag": "character",
        "name": "avgnew_2014_nian_1#1$1"
    },
    {
        "text": "Aww. So it was just old Lee.",
        "tag": "name",
        "value": "Nian"
    },
    {
        "tag": "character",
        "name": "avgnew_2014_nian_1#7$1"
    },
    {
        "text": "Still, long time no see. What dragged you from Lungmen to Shangshu?",
        "tag": "name",
        "value": "Nian"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "background",
        "image": "25_g04_yaninn",
        "screenadapt": "coverall"
    },
    {
        "tag": "character"
