    },
    {
        "text": "I predicted this from you.",
        "tag": "name",
        "value": "Pole-Carrier"
    },
    {
        "tag": "character",
        "name": "avg_npc_300_1#4$1"
    },
    {
        "text": "I never once laid a hand on her.",
        "tag": "name",
        "value": "Innkeeper Zheng"
    },
    {
        "text": "You'll regret this.",
        "tag": "name",
        "value": "Innkeeper Zheng"
    },
