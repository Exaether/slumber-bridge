    {
        "text": "Hello, everyone.",
        "tag": "name",
        "value": "Dorothy"
    },
    {
        "text": "I'm the Director of Rhine Lab's Originium Art Section, and the overseer of Test Site 359.",
        "tag": "name",
        "value": "Dorothy"
    },
    {
        "text": "Welcome, all, to my laboratory.",
        "tag": "name",
        "value": "Dorothy"
    },
    {
        "tag": "character",
        "name": "avg_npc_535_1#11$1"
    },
    {
        "tag": "stopmusic",
        "fadetime": 1
    },
    {
        "text": "So we're here at last...",
        "tag": "name",
        "value": "Sonny"
    },
