    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#1$1"
    },
    {
        "text": "Acknowledged.",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#1$1"
    },
    {
        "text": "The government has taken over all administration of the site, and per our agreement, Rhodes Island needs to destroy all the information we've collected.",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#1$1"
    },
    {
        "text": "But this isn't the end.",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#1$1"
    },
    {
        "text": "I just got a new lead about Ferdinand's backer. I'm on my way to meet with the informant now.",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#9$1"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#9$1"
    },
    {
        "text": "Doctor...",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character"
    },
    {
        "tag": "image",
        "image": "29_i09",
        "xScale": 0.85,
