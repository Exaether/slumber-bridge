        "params": {
            "a": 1,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "character"
    },
    {
        "command": "background",
        "params": {
            "image": "bg_ltroom",
