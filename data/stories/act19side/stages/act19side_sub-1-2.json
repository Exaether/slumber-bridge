    {
        "command": "name",
        "value": "Rhine Defense Section Employee",
        "text": "......"
    },
    {
        "command": "name",
        "value": "Rhine Defense Section Employee",
        "text": "Director Parvis?"
    },
    {
        "command": "name",
        "value": "Rhine Defense Section Employee",
        "text": "Are... are you asleep?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "text": "There is no response from the communicator."
    },
    {
        "text": "The tune keeps playing, looping over and over again."
    },
    {
        "text": "He does not know if the old Caprinae is still sitting by the communicator."
    },
    {
        "text": "All he knows is that when he returns to Rhine Lab headquarters at dawn, he will see Parvis standing at his usual spot, a teacup in his hands, watching young faces come and go below with a smile on his face."
    },
