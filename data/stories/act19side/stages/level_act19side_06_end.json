    {
        "tag": "character",
        "name": "avg_npc_528_1#1$1"
    },
    {
        "text": "Director Clooney, Miss Urbica is not leaving the labs.",
        "tag": "name",
        "value": "Rhine Defense Member"
    },
    {
        "tag": "character",
        "name": "avg_npc_522_1#6$1"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Ferdinand"
    },
    {
        "tag": "character",
        "name": "avg_npc_528_1#1$1"
    },
    {
        "text": "Should we adjust the plan?",
        "tag": "name",
        "value": "Rhine Defense Member"
    },
    {
        "tag": "character",
        "name": "avg_npc_522_1#6$1"
    },
    {
        "text": "No.",
        "tag": "name",
        "value": "Ferdinand"
    },
    {
        "tag": "character",
        "name": "avg_npc_522_1#6$1"
    },
    {
        "text": "Proceed.",
        "tag": "name",
        "value": "Ferdinand"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
