    },
    {
        "text": "I can't reach Silence or Greyy.",
        "tag": "name",
        "value": "Mechanist"
    },
    {
        "tag": "character",
        "name": "avg_npc_521_1#1$1"
    },
    {
        "text": "The site must be entirely closed off.",
        "tag": "name",
        "value": "Mechanist"
    },
    {
        "tag": "character",
        "name": "char_249_muesys_1#7"
    },
    {
        "text": "Fer...dinand...",
        "tag": "name",
        "value": "Muelsyse"
    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#1$1"
    },
    {
        "text": "Closing off the lab is just the means, not the end.",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "character",
        "name": "avg_npc_532_1#8$1"
    },
    {
        "text": "Ferdinand is planning something at Site 359.",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "character",
        "name": "avg_npc_521_1#1$1"
    },
    {
        "text": "Doctor, Silence and the others are in danger.",
        "tag": "name",
        "value": "Mechanist"
    },
    {
        "tag": "character",
        "name": "avg_npc_521_1#1$1"
    },
    {
        "text": "We're not getting anything from the site... should we move to assist?",
        "tag": "name",
        "value": "Mechanist"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "decision",
        "options": "Ptilopsis...;...Device #9.",
        "values": "1;2"
    },
    {
        "tag": "predicate",
        "references": "1;2"
    },
    {
        "tag": "character",
        "name": "avg_npc_521_1#1$1"
    },
    {
        "text": "True... data transmission from Device #9 is different from standard communication. We only need a moment's signal to see what Ptilopsis is seeing.",
        "tag": "name",
        "value": "Mechanist"
    },
    {
        "tag": "character",
        "name": "avg_npc_521_1#1$1"
    },
    {
        "text": "I'll try to sync up with her.",
        "tag": "name",
        "value": "Mechanist"
    },
    {
        "tag": "dialog"
    },
