        "name": "avg_1047_halo2_1#9$1",
        "focus": "r"
    },
    {
        "text": "The one on observation duty was... Carolin.",
        "tag": "name",
        "value": "Elena"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_1047_halo2_1#12$1",
        "focus": "r"
    },
    {
        "text": "Could it be...?",
        "tag": "name",
        "value": "Elena"
    },
    {
        "tag": "dialog"
    },
