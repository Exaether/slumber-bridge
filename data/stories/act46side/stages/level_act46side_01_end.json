    {
        "text": "Angry shouts pierce through the metal walls."
    },
    {
        "text": "Give Mount Karlan back to us! Back to Kjerag! Back to Kjeragandr!",
        "tag": "name",
        "value": "Villager's Voice"
    },
    {
        "text": "Get off Kjeragandr's land!",
        "tag": "name",
        "value": "Villager's Voice"
