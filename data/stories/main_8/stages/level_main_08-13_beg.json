    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_080"
        }
    },
    {
        "command": "name",
        "value": "Infected",
        "text": "Ugh?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_058"
        }
    },
    {
        "command": "name",
        "value": "Shieldguard",
        "text": "Do you want to get yourself killed?!"
    },
    {
        "command": "name",
        "value": "Shieldguard",
        "text": "...That's..."
    },
    {
        "command": "name",
