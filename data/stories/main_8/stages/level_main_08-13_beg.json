    {
        "command": "name",
        "value": "Yeti Squad Member",
        "text": "Aghh!!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_058"
        }
    },
    {
        "command": "name",
        "value": "Shieldguard",
        "text": "What...? What just happened?! Quick! S-Set him down here! Take that goddamned spear out!"
    },
    {
        "command": "name",
        "value": "Shieldguard",
        "text": "(...What's going on? The black spear... grew out of his body?!)"
    },
    {
        "command": "name",
        "value": "Shieldguard",
        "text": "(No, it can't be... The Empire's monsters?! What are they doing here?!)"
    },
    {
        "command": "character"
    },
    {
        "command": "dialog"
    },
    {
        "command": "name",
        "value": "??? ",
        "text": "*Hiss*..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_080"
        }
    },
    {
        "command": "name",
        "value": "Infected",
        "text": "Ngh, ugh... Ungh!"
    },
    {
        "command": "name",
        "value": "Infected",
        "text": "What? Think you're all that?!"
    },
    {
        "command": "name",
        "value": "Infected",
        "text": "I'll show you what for! Let's go! Get him!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_080",
            "name2": "avg_npc_058",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Shieldguard",
        "text": "Stop...!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_080",
            "name2": "avg_npc_058",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Infected",
        "text": "What are you doing? Why are you stopping me?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_080",
            "name2": "avg_npc_058",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Shieldguard",
        "text": "You have no idea... You have no idea what you're facing! You don't even know what exactly he is, and you want to get yourself killed?!"
    },
