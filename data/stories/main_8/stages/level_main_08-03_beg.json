        "tag": "character",
        "name": "avg_npc_092#3"
    },
    {
        "text": "Take me.",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "text": "Take me then, officer!",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "text": "Look at my skin! I'm the bloody diseased one!",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "tag": "character",
        "name": "avg_npc_082",
        "name2": "avg_npc_092#3",
        "focus": 1
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
    {
        "tag": "character",
        "name": "avg_npc_082",
        "name2": "avg_npc_092#3",
        "focus": 2
    },
    {
        "text": "If you don't believe me, then take a look at this!",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "tag": "character",
        "name": "avg_npc_082",
        "name2": "avg_npc_092#3",
        "focus": 1
    },
    {
        "text": "A knife? Put that down. You can't touch us, old man.",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
    {
        "tag": "character",
        "name": "avg_npc_092#3"
    },
    {
        "text": "No, officer, watch my Arts!",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "tag": "camerashake",
        "duration": 0.4,
        "xstrength": 0,
        "ystrength": 8,
        "vibrato": 30,
        "randomness": 30,
        "fadeout": true,
        "block": false
    },
    {
        "text": "The elderly man slices open his own wrist, but no red flows onto the snow. It is instead as mist, scattering into the air."
    },
    {
        "tag": "character",
        "name": "avg_npc_092#3"
    },
    {
        "text": "Look, look... Officer! I'm an Infected, tried and true!",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "tag": "character",
        "name": "avg_npc_082",
        "name2": "avg_npc_092#3",
        "focus": 1
    },
    {
        "text": "I believe you.",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
