        }
    },
    {
        "command": "name",
        "value": "Infected Patrol Unit",
        "text": "A knife? Put that down. You can't touch us, old man."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_092#3"
        }
    },
    {
        "command": "name",
