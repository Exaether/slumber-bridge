    {
        "command": "name",
        "value": "Infected Patrol Unit",
        "text": "Bloody old fart, what are you doing here?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_092#2"
        }
    },
    {
        "command": "name",
        "value": "Old Man",
        "text": "I committed a crime!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_082",
            "name2": "avg_npc_092#2",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Infected Patrol Unit",
        "text": "A confession? Ah, yeah, I remember.  An old geezer got in our guy's way. Judging by your limp, you were one of the thugs who attacked him!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_082",
            "name2": "avg_npc_092#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Old Man",
        "text": "Yup!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_082",
            "name2": "avg_npc_092#2",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Infected Patrol Unit",
        "text": "...Not that you look worth the trouble. Go take a bloody hike. No point in dirtying our hands over a miserable little wretch."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_082",
            "name2": "avg_npc_092#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Old Man",
        "text": "Hold it. Sir, look at my skin here. What's that look like to you?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_082"
        }
    },
    {
        "command": "name",
        "value": "Infected Patrol Unit",
        "text": "\u2014\u2014"
    },
    {
        "command": "name",
        "value": "Infected Patrol Unit",
        "text": "Infected! You're the Infected?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
            "r": 0,
            "g": 0,
