    {
        "text": "Central District"
    },
    {
        "text": "H\u2014help me...!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "We're Reunion too! Why are you doing this? You Sarkaz always bite whatever hand feeds you!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "avg_npc_042"
    },
    {
        "text": "...What's happening?",
        "tag": "name",
        "value": "Rosmontis"
    },
    {
        "tag": "character"
    },
    {
        "text": "The Sarkaz barricading the street are massacring Reunion...",
        "tag": "name",
        "value": "Rosmontis Squadmember"
    },
    {
        "text": "Captain?",
        "tag": "name",
        "value": "Rosmontis Squadmember"
    },
    {
        "tag": "character",
        "name": "avg_npc_042"
    },
    {
        "text": "Need to help the casualties.",
        "tag": "name",
        "value": "Rosmontis"
    },
    {
        "tag": "character"
    },
    {
        "text": "You are, Captain?",
        "tag": "name",
        "value": "Rosmontis Squadmember"
    },
    {
        "tag": "character",
        "name": "avg_npc_042"
    },
    {
        "text": "Mmhm. I'm going.",
        "tag": "name",
        "value": "Rosmontis"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "background",
        "image": "bg_chercen_2",
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Ngh... urgh... why, why! !",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "How did Reunion get like this... how did it get like this?! Weren't we gonna unite? Weren't we gonna be... be a family of our own, each other's kin?!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "avg_npc_053"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "text": "See you\u2014",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "tag": "character"
    },
    {
        "text": "Stop.",
        "tag": "name",
        "value": "Rosmontis"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
