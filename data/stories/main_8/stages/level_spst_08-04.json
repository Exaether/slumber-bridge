        "command": "character",
        "params": {
            "name": "avg_npc_088"
        }
    },
    {
        "command": "name",
        "value": "Steady Rhodes Island Operator",
        "text": "...I'll hold the mercs off outside the control tower. You guys, back in. Rescue the remaining people. Secure an evacuation route that hasn't been destroyed."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "How are you gonna hold alone against that many Sarkaz?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_089"
        }
    },
    {
        "command": "name",
        "value": "Seasoned Rhodes Island Operator",
        "text": "I'll go with her."
    },
    {
        "command": "name",
        "value": "Seasoned Rhodes Island Operator",
        "text": "You guys, go back in now. Move."
