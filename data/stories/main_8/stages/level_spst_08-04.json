        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "Is there anyone else in the command tower?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_090"
        }
    },
    {
        "command": "name",
        "value": "Panicked Rhodes Island Operator",
        "text": "Yes!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "Then we need to go help them!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_089"
        }
    },
    {
        "command": "name",
        "value": "Seasoned Rhodes Island Operator",
        "text": "Wait! Keep your head down!"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_053"
        }
    },
    {
        "command": "name",
        "value": "Sarkaz Mercenary",
        "text": "\u2014Enemies have left the command tower! Go find them!"
    },
    {
        "command": "name",
        "value": "Sarkaz Mercenary",
        "text": "Block this place off. Don't give them the chance to seek aid."
    },
