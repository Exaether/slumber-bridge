    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "...Alright!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_090"
        }
    },
    {
        "command": "name",
        "value": "Panicked Rhodes Island Operator",
        "text": "Don't you push it now! They've got a lot of people!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_088"
        }
    },
    {
        "command": "name",
        "value": "Steady Rhodes Island Operator",
        "text": "...It's been forever. Us two, fighting side by side, eyeing for a chance to ambush the enemy."
    },
