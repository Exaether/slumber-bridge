    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "Wait... what's going on! ?"
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "Wha\u2014"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_089"
        }
    },
    {
        "command": "name",
        "value": "Seasoned Rhodes Island Operator",
        "text": "Grab on to me!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "Wait... the\u2014the fire's spreading?! What the hell's even flammable here?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_089"
        }
    },
    {
        "command": "name",
        "value": "Seasoned Rhodes Island Operator",
        "text": "High heat... It's just like the intel said, this is Talulah's doing...!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "Quit standing there! What do we do now?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_089"
        }
    },
    {
        "command": "name",
        "value": "Seasoned Rhodes Island Operator",
        "text": "Oh\u2014let's go this way, join up with everyone else! Wait up, is your leg okay now?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Tired Rhodes Island Operator",
        "text": "Distracting myself!"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
