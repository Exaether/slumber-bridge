    {
        "command": "name",
        "value": "Infected Patrol Unit",
        "text": "Nggaaaaah!"
    },
    {
        "command": "camerashake",
        "params": {
            "duration": 0.5,
            "xstrength": 0,
            "ystrength": 20,
            "vibration": 30,
            "randomness": 30,
