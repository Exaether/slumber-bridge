    {
        "tag": "image"
    },
    {
        "text": "This will do it."
    },
    {
        "text": "Talulah will not remember what happens next."
    },
    {
        "text": "She has no memories of anything after that."
    },
    {
        "text": "She melted away each and every last thing she should have remembered, along with the snow."
    },
    {
        "text": "She leaves behind only a trail of flames, and, with the exception of Alina, everything behind her is burned away in the inferno of her wake."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "And Talulah treks on in the snow toward her parting with her dear friend."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 3,
        "block": true
    },
    {
