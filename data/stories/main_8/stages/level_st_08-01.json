    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Spies! Ursus spies!",
        "tag": "name",
        "value": "Reunion Infected"
    },
    {
        "text": "They're right here! Tell everyone, they're right here!",
        "tag": "name",
        "value": "Reunion Infected"
    },
    {
        "text": "Kill them, kill them! Hang them above the connecting floor, crush them against the top of Lungmen!",
        "tag": "name",
        "value": "Reunion Infected"
    },
    {
        "tag": "character"
    },
    {
        "text": "Let's retreat, Rosmontis. They've occupied the entire commercial plaza. This entire block's been sealed off by them now.",
        "tag": "name",
        "value": "Rosmontis Squadmember"
    },
    {
        "text": "Rosmontis...!",
        "tag": "name",
        "value": "Rosmontis Squadmember"
    },
    {
        "tag": "character",
        "name": "avg_npc_042"
    },
    {
        "text": "Let me do this. If we take a diversion, we'll be attacked by Reunion somewhere else.",
        "tag": "name",
        "value": "Rosmontis"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
