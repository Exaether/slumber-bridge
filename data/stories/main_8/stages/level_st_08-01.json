    },
    {
        "tag": "dialog"
    },
    {
        "tag": "decision",
        "options": "Can you see that, Kal'tsit?",
        "values": 1
    },
    {
        "tag": "predicate",
        "references": 1
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
