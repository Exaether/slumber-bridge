    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "What are you doing?",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "avg_npc_082"
    },
    {
        "text": "Hm? Some girl from somewhere...",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
    {
        "text": "\u2014Hey. Your clothes there. Where'd you come from? No farmer could afford to wear those.",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
    {
        "tag": "character",
        "name": "avg_npc_078#4"
    },
    {
        "text": "\u2014\u2014",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "I'm asking. What are you doing?",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "avg_npc_082"
    },
    {
        "text": "Huh?",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
    {
        "text": "Not a step closer! What do you think you're doing? Have you seen your eyes...? Hah, don't you look terrifying!",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
    {
        "text": "\u2014Do I see a death wish?!",
        "tag": "name",
        "value": "Infected Patrol Unit"
    },
