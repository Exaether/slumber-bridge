    {
        "tag": "delay",
        "time": 3
    },
    {
        "text": "So you're finally here.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Hui-chieh."
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playmusic",
        "intro": "$drift_intro",
        "key": "$drift_loop",
        "crossfade": 3,
        "volume": 0.4
