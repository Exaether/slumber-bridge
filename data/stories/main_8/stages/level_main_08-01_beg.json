    {
        "command": "name",
        "value": "Ursus Farmer",
        "text": "Trouble! There's trouble...!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_093#2"
        }
    },
    {
        "command": "name",
        "value": "Old Woman",
        "text": "What's all the racket about?! Storming in without even knocking! I don't know what I'll do if the bolt's broken!"
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Ursus Farmer",
        "text": "The... The Infected Patrol Unit!"
    },
    {
        "command": "name",
