    {
        "text": "Third year without the Black Snake"
    },
    {
        "text": "A small Ursus hamlet"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_093#2",
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "name",
        "value": "Old Woman",
        "text": "Talulah, get back here! You can't let them see you like that, for heaven's sakes."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_078#2",
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "name",
        "value": "Talulah",
        "text": "Don't worry! I'm coming in now."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 1,
