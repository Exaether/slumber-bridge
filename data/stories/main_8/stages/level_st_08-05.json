            "fadetime": 2,
            "block": true
        }
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kalts_1"
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "A war cast in warmth and kindness is a much more dangerous form of war."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "I don't want to speak of such horrible cruelties, even if my fears should never come to pass."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Amiya and Rosmontis are in the care of Rhodes Island herself, and more directly the elite operators who take responsibility for them."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Further, they are the core of the squad's strategy, Dr. {@nickname}."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Trust in them, and you trust in yourself."
    },
    {
        "command": "dialog"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "background",
        "params": {
            "image": "bg_warehouse",
            "screenadapt": "coverall"
        }
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 0,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 3,
            "block": true
        }
    },
    {
        "command": "character",
        "params": {
            "name": "char_401_elysm",
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "Hey, Hawk, did you see that?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "How could I not?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "Shhh. Don't give us away."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Then why did you ask me? You're the one making noise.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(I said shhhh. You don't want the Captain to chew you out.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(She can't talk, how would I know if she's chewing me out, or if it's just you pretending for her?)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(I wouldn't do that.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(I know.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(......)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(......)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(I mean...)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Enough. I know you want to ask about this stuff.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(You've got all these weapon and armor cases, all this machinery laid out all nice. If it was just laying around I'd say I came up with a million Victorian pounds or so.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(I bet you two big ones that's Ursus stuff. I saw goods like this when I was smuggling around Laval. This is brand spanking new.)"
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(You got the Central Corps, but other units can't have had anything like this more than... Hmm, maybe five years?)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(You think it makes any sense that Reunion could've just looted all this equipment?)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(You mean the guys who go around swinging pipes? I don't think they'd even know how to grease it.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(What about the guerrillas? They're ex-Ursus Army.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(How long ago did they desert? Those big, heavy metal guys would sink if you pushed them into a lake.)"
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Even if they managed to bring some logistics units with them all those years ago, they'd probably all be dead by now.)"
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Think about it. With the stuff they're using now, it's a miracle they can keep their plates wiped clean.)"
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Let them get their hands on these weapons? I doubt they'd even know which end to point at the enemy.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(You're making them sound like a bunch of idiots.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Ignorance and idiocy aren't the same thing. Logistics is skill as much as it's knowledge. The guerrillas aren't dumb, but the odds that they'll come across some Infected logistics officers eager to run off with them are pretty slim.)"
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Saving an Infected officer from execution... that's a tall order.)"
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(Look... The serial number's been filed off. Sure, a deserter might do that, but you know who else might...?)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "(You might do it if you were trying to trick somebody.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "(It wasn't done very clean. Just looking at it I can tell what kind of file they used. Looks like somebody was short on time.)"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "But the most important thing for now..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "We have to tell them, and quick. Whether or not it's useful info."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "I just hope we're not too late. Captain, should we have Raidian tell Amiya's team? Or go report it direct?"
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "We should keep Reunion and the weird looking guys busy back here? Got it."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "Wait."
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "We've got bogeys closing on our position."
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "Mantra, you on it? Just make them forget what they're doing. No need to fabricate some orders or turn them into gibbering morons or whatever..."
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "Conserve your strength. If we run into Reunion, we'll need you to defuse the situation."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "Hm? Hm."
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "'Good. Be careful.'"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012",
            "name2": "char_401_elysm",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hawk",
        "text": "Right."
    },
    {
        "command": "character",
        "params": {
            "name": "char_401_elysm"
        }
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "Okay... And it's good to send, Captain. Here."
    },
    {
        "command": "name",
        "value": "Elysium",
        "text": "'The Ursus Army is in the core city.'"
    },
    {
        "command": "dialog"
    },
    {
        "command": "blocker",
        "params": {
            "fadetime": 3,
            "block": true
        }
    },
    {
        "command": "image"
    }
]