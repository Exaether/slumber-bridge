    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "One thing is clear. All the Sarkaz mercenaries in the core have turned."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "All operators, switch your self-cleansing devices on."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Protect yourselves before you try to protect anyone else."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Amiya... Are you really going to carry the burden of this unfortunate race's fate?"
