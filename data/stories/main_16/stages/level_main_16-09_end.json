    {
        "text": "Rankin!",
        "tag": "name",
        "value": "Nikto"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1963_1#6$1"
    },
    {
        "text": "What... what happened?",
        "tag": "name",
        "value": "Rankin"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1967_1#5$1"
    },
    {
        "text": "No idea. The fire started all of a sudden. We can't put it out!",
        "tag": "name",
        "value": "Nikto"
    },
    {
        "text": "All we can do is evacuate the others!",
        "tag": "name",
        "value": "Nikto"
    },
