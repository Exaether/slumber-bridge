    {
        "text": "Tap, click, tap, click."
    },
    {
        "text": "The footsteps are rhythmic, one stronger than the other."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_snowbootwalk",
        "volume": 1
