    },
    {
        "text": "<i>Uchitel</i>, I-I...!",
        "tag": "name",
        "value": "Vetochki"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1963_1#7$1"
    },
    {
        "text": "Didn't you hear me?!",
        "tag": "name",
        "value": "Rankin"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "Rankin tries to shake off Vetochki's hands, but the girl grabs his arm with all her strength."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4207_branch_1#10$1"
    },
    {
        "text": "B-Babushka, sh-she's gone!",
        "tag": "name",
        "value": "Vetochki"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1963_1#6$1"
    },
    {
        "text": "What? Wasn't she with you?",
        "tag": "name",
        "value": "Rankin"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "The stammering girl gestures furiously, trying to explain what happened, but the terror on her face says it all."
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1963_1#5$1"
    },
    {
        "text": "Nikto!",
        "tag": "name",
        "value": "Rankin"
    },
    {
        "text": "Continue the evacuation! We'll go find Nadia!",
        "tag": "name",
        "value": "Rankin"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1967_1#1$1"
    },
    {
        "text": "O-Okay!",
        "tag": "name",
        "value": "Nikto"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
