        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1963_1#7$1"
    },
    {
        "text": "Vetochki! Wait!",
        "tag": "name",
        "value": "Rankin"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "I have committed murder.",
        "tag": "name",
        "value": "Hawley"
    },
    {
        "text": "Not for food, nor for water, nor for abode.",
        "tag": "name",
        "value": "Hawley"
    },
    {
        "text": "He continues to walk as he chants, and pushes open a burning door."
    },
