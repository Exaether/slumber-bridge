    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "Here. Stop.",
        "tag": "name",
        "value": "Army Officer"
    },
    {
        "text": "Let's begin.",
        "tag": "name",
        "value": "Army Officer"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_082"
    },
    {
        "text": "Everyone, on the ice.",
        "tag": "name",
        "value": "Soldier"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1970_1#1$1"
    },
    {
        "text": "No, sir, please\u2014",
        "tag": "name",
        "value": "Fearful Miner"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
