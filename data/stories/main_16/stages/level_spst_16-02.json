    {
        "command": "name",
        "value": "Young Craftsman",
        "text": "This is..."
    },
    {
        "command": "name",
        "value": "Young Craftsman",
        "text": "A mining lamp?"
    },
    {
        "command": "name",
        "value": "Young Craftsman",
        "text": "And a letter\u2014"
    },
    {
        "command": "name",
        "value": "Young Craftsman",
        "text": "......"
    },
    {
        "command": "name",
        "value": "Young Craftsman",
        "text": "This was once the place of a struggle?"
    },
    {
