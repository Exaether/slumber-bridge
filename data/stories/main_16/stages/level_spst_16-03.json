    {
        "command": "name",
        "value": "Officer",
        "text": "I thought the Defender Regiments were supposed to be on the top deck."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1978_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Cold Soldier",
        "text": "...Sorry, sir. I was away from my post."
    },
    {
        "command": "name",
        "value": "Cold Soldier",
        "text": "I will report this to the commissar myself."
    },
    {
        "command": "name",
