    {
        "command": "name",
        "value": "Cold Soldier",
        "text": "...You had me leave my post to come to you for this little thing?"
    },
    {
        "command": "name",
        "value": "Cold Soldier",
        "text": "You're out of your mind."
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot"
    },
    {
        "command": "charslot",
        "params": {
