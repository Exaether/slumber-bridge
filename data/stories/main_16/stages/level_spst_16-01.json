    {
        "command": "image"
    },
    {
        "command": "bgeffect"
    },
    {
        "command": "background",
        "params": {
            "image": "66_g13_reunionfarm",
            "screenadapt": "coverall"
        }
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1983_1#1$1"
        }
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "blocker",
        "params": {
            "a": 0,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 2,
            "block": true
        }
    },
    {
        "command": "name",
        "value": "Nine",
        "text": "Well, you're wrong. I've never been afraid of it."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1968_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Talulah",
        "text": "But those who walked with us have felt that fear. After all, not everyone has such a grand outlook as you. Many of them just hope to see the next sunrise."
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot"
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_gen_walk_n",
