    {
        "tag": "background",
        "image": "64_g6_gokudouoffice",
        "screenadapt": "coverall"
    },
    {
        "tag": "charslot",
        "slot": "left",
        "name": "avg_npc_1896_1#1$1",
        "bstart": 0.3,
        "bend": 0.5
    },
    {
        "tag": "charslot",
        "slot": "right",
        "name": "avg_npc_1901_1#1$1",
        "bstart": 0.3,
        "bend": 0.5
    },
    {
        "tag": "charslot",
        "slot": "left",
        "posfrom": "0,-50",
        "posto": "0,-50"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "posfrom": "0,-50",
        "posto": "0,-50"
    },
    {
        "tag": "curtain",
