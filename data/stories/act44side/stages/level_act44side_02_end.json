    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "The Wanyuudou? The kaidan is real?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "Well, in any case, I'd better go take a look\u2014\u2014",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
