    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_136_hsguma_1#9$1"
    },
    {
        "text": "Wait... stop right there!",
        "tag": "name",
        "value": "Hoshiguma"
    },
