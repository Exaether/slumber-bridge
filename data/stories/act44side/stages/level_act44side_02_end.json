    {
        "text": "Is that a car horn?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "(Rubs eyes) Am I dreaming? Still asleep?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
