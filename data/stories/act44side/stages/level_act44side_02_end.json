    {
        "text": "Momoka's body goes limp as she falls onto her tatami mat."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1918_1#1$1"
    },
    {
        "text": "I can't sleep a wink.",
        "tag": "name",
        "value": "Momoka"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1918_1#3$1"
    },
    {
        "text": "Maybe I should go to the agency tomorrow morning...",
        "tag": "name",
        "value": "Momoka"
    },
    {
        "text": "First, I need to apologize properly, and really mean it\u2026 If that's not enough, I can take on some extra work. Then Mio-san will forgive me\u2014",
        "tag": "name",
        "value": "Momoka"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_largebell",
        "volume": 0.5
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "camerashake",
        "duration": 0.2,
        "xstrength": 20,
        "ystrength": 20,
        "vibrato": 20,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1918_1#10$1"
    },
    {
        "text": "Aahh!",
        "tag": "name",
        "value": "Momoka"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1918_1#9$1"
    },
    {
        "text": "Is that... a clock?",
        "tag": "name",
        "value": "Momoka"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1918_1#7$1"
    },
    {
        "text": "I think I'll sleep with the lights, and TV, on.",
        "tag": "name",
        "value": "Momoka"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_oldtvelectricity"
    },
    {
        "text": "Momoka kneels down in front of the TV and turns it on."
    },
    {
        "text": "An advertisement, loud, exaggerated, and contrived, yet as reassuring as Mitsukue itself, begins to sound."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1918_1#4$1"
    },
    {
        "text": "I guess I'll go to sleep then.",
        "tag": "name",
        "value": "Momoka"
    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_clothmovement"
    },
    {
        "tag": "charslot",
        "duration": 1
    },
