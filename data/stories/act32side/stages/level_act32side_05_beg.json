        "key": "$d_gen_walk_n"
    },
    {
        "tag": "charslot",
        "duration": 1.5
    },
    {
        "tag": "delay",
        "time": 2.5
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_524_1#1$1"
    },
    {
        "text": "Se\u00f1or Mi\u0142osz!",
        "tag": "name",
        "value": "Reporter"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
