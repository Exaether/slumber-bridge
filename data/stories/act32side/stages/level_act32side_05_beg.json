    {
        "text": "How's a single phone call taking so long?",
        "tag": "name",
        "value": "Reynell"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1213_1#7$1",
        "focus": "l"
    },
    {
        "text": "(Mouths) He won't shut up!",
        "tag": "name",
        "value": "Mi\u0142osz"
