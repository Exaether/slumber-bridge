        "volume": 0.6
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1211_1#2$1",
        "focus": "m"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
