        "screenadapt": "coverall"
    },
    {
        "tag": "delay",
        "time": 2.5
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "tag": "playsound",
        "key": "$rungeneral"
    },
    {
        "tag": "delay",
        "time": 2.5
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_201",
        "focus": "m"
    },
    {
        "text": "The gallery is just after the turn there!",
        "tag": "name",
        "value": "Sly Stranger"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_001",
        "focus": "m"
    },
    {
        "text": "Whew, I can't wait to give Reynell a shock.",
        "tag": "name",
        "value": "Community Hawker"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_201",
        "focus": "m"
    },
    {
        "text": "I like it! We'll smash up his gallery and loot every last piece of stupid crap in there!",
        "tag": "name",
        "value": "Sly Stranger"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_001",
        "focus": "m"
    },
    {
        "text": "Huh?",
        "tag": "name",
        "value": "Community Hawker"
    },
    {
        "text": "What's your deal?",
        "tag": "name",
        "value": "Community Hawker"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_201",
        "focus": "m"
    },
    {
        "text": "What...? What's my deal? Didn't we say we were gonna go big?",
        "tag": "name",
        "value": "Sly Stranger"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_001",
        "focus": "m"
    },
    {
