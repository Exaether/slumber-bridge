        "time": 2
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1211_1#9$1"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
