    {
        "text": "There... there...",
        "tag": "name",
        "value": "Gentle Woman"
    },
    {
        "text": "Don't cry. We're on our way home. We're almost there.",
        "tag": "name",
        "value": "Gentle Woman"
    },
    {
        "tag": "stopsound",
        "channel": "a",
        "fadetime": 2
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1616_1#4$1",
        "duration": 1
    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "text": "Pick up the pace, please... if you could.",
        "tag": "name",
        "value": "Anxious Man"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "text": "It's raining too hard. And I can't see too well. Couldn't go any faster, at this rate...",
        "tag": "name",
        "value": "Coachman"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1616_1#8$1"
    },
    {
        "text": "How much farther to the next stage station?",
        "tag": "name",
        "value": "Anxious Man"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "text": "At least thirty li...",
        "tag": "name",
        "value": "Coachman"
    },
    {
        "text": "Brother, just how urgent is your business... that you'd bring your whole family along to travel on a night like this?",
        "tag": "name",
        "value": "Coachman"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1616_1#4$1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Anxious Man"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1616_1#2$1"
    },
    {
        "text": "Please... just go faster.",
        "tag": "name",
        "value": "Anxious Man"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
