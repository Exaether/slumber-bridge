    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "focus": "n"
        }
    },
    {
        "text": "The man looks around, but the endless rain blocks his view. It is too dark for him to see anything."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1616_1#5$1"
        }
    },
    {
        "command": "name",
        "value": "Anxious Man",
        "text": "We'll have to get out here."
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_avg_goldcoin",
            "volume": 0.5
        }
    },
    {
        "command": "name",
        "value": "Anxious Man",
        "text": "Sir, I'll give you all the money I have. Take your carriage to the next stage station. If anyone asks, do not tell them you carried passengers with a baby tonight."
    },
    {
        "command": "name",
        "value": "Anxious Man",
        "text": "I beseech you, good sir."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "focus": "n"
        }
    },
    {
        "command": "name",
        "value": "Coachman",
        "text": "But.... what... huh?!"
    },
    {
        "command": "name",
        "value": "Coachman",
        "text": "Where are you going in this weather?"
    },
    {
        "command": "charslot",
