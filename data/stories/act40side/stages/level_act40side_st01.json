    },
    {
        "command": "charslot",
        "params": {
            "slot": "left",
            "name": "avg_2024_chyue_1#6$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Shuo",
        "text": "When?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "???",
        "text": "Two weeks ago."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "left",
            "name": "avg_2024_chyue_1#1$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Shuo",
        "text": "I think... if His Majesty had died of natural causes, you would not be coming to see me about it."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "left",
            "name": "avg_2024_chyue_1#8$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Shuo",
        "text": "Does this mean...?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_301_1#1$1",
