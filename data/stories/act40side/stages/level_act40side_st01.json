    {
        "text": "<p=2>April 21st, 1062      Guyu (Grain Rain)</>",
        "tag": "animtext",
        "id": "at1",
        "name": "group_location_stamp",
        "style": "avg_only_medium",
        "pos": "-400,-200",
        "block": false
    },
