    },
    {
        "command": "name",
        "value": "Hawking Shopworker",
        "text": "Haha. Some people want the rain to stop, some hope it carries on."
    },
    {
        "command": "name",
        "value": "Hawking Shopworker",
        "text": "The umbrella vendor is smiling from ear to ear, but the passersby are downright miserable."
    },
    {
        "command": "name",
