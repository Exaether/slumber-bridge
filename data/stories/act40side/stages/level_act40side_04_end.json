    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "What a skill you have... Could you be...",
        "tag": "name",
        "value": "Mo Bufu"
    },
    {
        "text": "...Duoxie.",
        "tag": "name",
        "value": "Mo Bufu"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1040_blaze2_1#1$1"
    },
    {
        "text": "You're welcome\u2014",
        "tag": "multiline",
        "name": "Blaze"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1040_blaze2_1#2$1"
    },
    {
        "text": "Hm?",
        "tag": "multiline",
        "name": "Blaze"
    },
