        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1617_1#1$1",
        "duration": 1
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1614_1#1$1",
        "duration": 1,
        "isblock": true
    },
    {
        "tag": "delay",
