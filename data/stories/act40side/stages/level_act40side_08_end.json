    },
    {
        "text": "One hundred years it has been."
    },
    {
        "text": "He returns once again, to where this game of weiqi started."
    },
    {
        "text": "The board is covered in cobwebs and dust, a single black stone at the center."
    },
    {
        "text": "He extends his hand to brush away the grime."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_gintcrturvive",
        "volume": 1
    },
