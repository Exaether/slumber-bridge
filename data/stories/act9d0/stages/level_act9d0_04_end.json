    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "...Of course.",
        "tag": "name",
        "value": "Hoederer"
    },
    {
        "text": "Yes, it'll be fine. I'll keep contact with the other teams.",
        "tag": "name",
        "value": "Hoederer"
    },
    {
        "text": "...By your command.",
        "tag": "name",
        "value": "Hoederer"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_transmissionget",
        "volume": 1
    },
    {
        "tag": "playmusic",
