        "command": "character",
        "params": {
            "name": "avg_npc_052",
            "name2": "avg_npc_046#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "W",
        "text": "I already told them to evacuate with Hoederer. I'm not stupid\u2014 Hah!"
