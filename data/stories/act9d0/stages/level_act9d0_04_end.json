        "command": "character",
        "params": {
            "name": "avg_npc_052",
            "name2": "avg_npc_046#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "W",
        "text": "You're the one who should stay back. You're not gonna make it if you fall down there\u2014"
