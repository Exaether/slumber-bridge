        "params": {
            "name": "avg_npc_055"
        }
    },
    {
        "command": "name",
        "value": "Confessarius",
        "text": "Hoederer, yes?"
    },
    {
        "command": "name",
        "value": "Confessarius",
        "text": "I look forward to seeing what else you uncover."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
