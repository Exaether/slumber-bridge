    },
    {
        "tag": "character",
        "name": "avg_npc_046"
    },
    {
        "text": "Hmmm...",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "Well, at least try to put up a bit of a fight. The more you struggle, the bigger our head start.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "But seriously, thanks a kiloton.",
        "tag": "name",
        "value": "W"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
