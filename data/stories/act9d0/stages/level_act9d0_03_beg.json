        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "text": "......"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "text": "They... for the moment..."
    },
    {
        "text": "Sarkaz... must..."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "text": "...You will... what?"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "text": "She is heavily injured... If we don't do something now..."
    },
    {
        "text": "...If... he... finds this place... We're out of time..."
    },
    {
        "text": "...Kal'tsit, give me a hand."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "text": "...*Sigh*. Fine."
    },
    {
        "tag": "stopmusic",
        "fadetime": 1
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
