    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_052"
        }
    },
    {
        "command": "name",
        "value": "Ines",
        "text": "Just one. Get out."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
