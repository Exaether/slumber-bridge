[
    {
        "text": "\u7b2c\u516d\u5173\uff08\u540e\uff09",
        "tag": "header",
        "key": "title_test",
        "is_skippable": true,
        "fit_mode": "BLACK_MASK"
    },
    {
        "tag": "blocker",
        "a": 0.6,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.6,
        "block": true
    },
    {
        "tag": "background",
        "image": "bg_emporium",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall",
        "fadetime": 2
    },
    {
        "tag": "playmusic",
        "intro": "$darkness01_intro",
        "key": "$darkness01_loop",
        "volume": 0.8,
        "crossfade": 1.5,
        "delay": 0.5
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#1",
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "Ugh...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "That's the third time today, Sleeping Beauty.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "text": "How long was I out for?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "A dozen seconds or so.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "text": "...Hoshiguma, step aside. I'll slash apart the debris.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "Sorry, but I can't do that. If I move, we're both done for. Let me handle this.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "text": "Your shoulder.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "It doesn't matter.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "text": "...You won't be able hold out much longer! You're holding up two floors' worth of rubble on top of your shield!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "I don't need to for much longer. Just until you woke up... Squat down, and get ready to dash out.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "No matter how heavy it is...",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma"
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 5,
        "ystrength": 3,
        "vibrato": 30,
        "randomness": 50,
        "fadeout": true,
        "block": true
    },
    {
        "text": "...as long as I can turn it over...",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 5,
        "ystrength": 3,
        "vibrato": 30,
        "randomness": 50,
        "fadeout": true,
        "block": true
    },
    {
        "text": "...it's not heavy at all!! AAAAAGH!!",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "camerashake",
        "duration": 2,
        "xstrength": 8,
        "ystrength": 8,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "text": "You...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "Gaaah, aagh... Ngh... It feels like I lost my shoulder just to give it that little push.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 2
    },
    {
        "text": "You saved me again.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#1",
        "focus": 1
    },
    {
        "text": "What's weird about that? How many times does that make now? And don't say that to me so earnestly... makes me feel gross just hearing it.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "Let me rest a little. I feel like I just broke every bone in my body... Maybe it's your turn to let me take a nap.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "stopmusic",
        "fadetime": 1
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "text": "...Blast, how did they even survive all that?!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "playmusic",
        "intro": "$epic_intro",
        "key": "$epic_loop",
        "volume": 0.8,
        "crossfade": 1.5,
        "delay": 0.5
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "text": "Sure, but the enemy's not going to let you.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "text": "No rest for the wicked, I suppose. Looks like I can still stand if I muster my strength.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "You should go reorganize the squads, quickly. Don't waste any more time on them - it's what they're after.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#5"
    },
    {
        "tag": "playsound",
        "key": "$e_skill_skulsrsword",
        "volume": 0.5,
        "delay": 0
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "I don't think it's too late to just take them all out first.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "text": "Why can't you go check to see who got injured first?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#4",
        "focus": 2
    },
    {
        "text": "And leave you here to face Reunion alone despite all your injuries?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#4",
        "focus": 1
    },
    {
        "text": "Ch'en. What do you think you're doing?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "Two years ago in Hua Shui, you were chasing after a bandit leader. My leg was injured, but you believed in me and left me to fight alone. Do you still remember that?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "text": "How long did it take me to catch him?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "text": "Three hours. You trusted me back then.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "text": "And I still do.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#2"
    },
    {
        "text": "You, Reunion! I'll take you all on!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_1011_wizard_1",
        "name2": "char_1002_nsabr_1"
    },
    {
        "text": "Damn it... She's looking down at us!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#2",
        "focus": 1
    },
    {
        "text": "I can still fight. Why are you staying behind? Why aren't you taking the squads to recapture the L.G.D. Headquarters? Did you forget your main mission?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "It's the same as it was three years ago, and it's a responsibility that only you can fulfill!",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "You did this back at the Muk Wo Warehouse earlier. When did you become so indecisive? Ch'en!",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "text": "I don't see any problem with protecting my colleague from these rioters.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 1
    },
    {
        "text": "You've changed. You used to be much tougher.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1#5",
        "focus": 2
    },
    {
        "text": "Leaving you here? Of course I could. I used to only look at the risks versus the benefits, but now, it's as you said...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "After what I did to Amiya, I've also been... conflicted.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_1011_wizard_1",
        "name2": "char_1002_nsabr_1"
    },
    {
        "text": "You'll taste the rage of the Infected! Attack!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.6,
        "block": true
    },
    {
        "tag": "image",
        "image": "avg_5_5_chen",
        "fadetime": 0,
        "xScale": 1,
        "yScale": 1
    },
    {
        "tag": "imagetween",
        "image": "avg_5_5_chen",
        "xScaleTo": 1.15,
        "yScaleTo": 1.15,
        "duration": 20
    },
    {
        "tag": "blocker",
        "a": 0,
        "fadetime": 0.6,
        "block": true
    },
    {
        "text": "Maybe I have changed. As time passed, I've had fewer grievances about Lungmen, and I've been able to place my trust in more people.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "You are no longer just Inspector Hoshiguma. You are my friend, and my partner.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Your shield has protected me all this time; so once in a while, you should let me be your shield.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Whew. You're not even going to blush after saying all that?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "Shut the **** up.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Hahaha.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "text": "All right, all right. In that case, Ch'en, I'm leaving it to you.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "delay",
        "time": 0.3
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "image"
    }
]