    },
    {
        "text": "You have nowhere left to run.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#3"
    },
    {
        "text": "...Damn... you!",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
