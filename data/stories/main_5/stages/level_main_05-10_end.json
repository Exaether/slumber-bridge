        "fadetime": 0.5,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_017_homura_3#1"
    },
    {
        "text": "Where do you think you're going?",
        "tag": "name",
        "value": "Blaze"
    },
    {
        "tag": "character",
        "name": "char_1508_Faust_1#1"
    },
    {
        "text": "Ngh...",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_017_homura_3#1"
    },
    {
        "text": "Put your hands where I can see them!",
        "tag": "name",
        "value": "Blaze"
    },
    {
        "text": "I've seen through all your tricks, kid with the scales!",
        "tag": "name",
        "value": "Blaze"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_1508_Faust_1#1"
    },
