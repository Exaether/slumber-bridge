    },
    {
        "tag": "background"
    },
    {
        "tag": "blocker",
        "a": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "text": "Keep all the toys orderly."
    },
    {
        "text": "Do not go outside."
    },
    {
        "text": "Do not talk to anyone without permission."
    },
    {
        "text": "Do not make eye contact with adults without permission."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
