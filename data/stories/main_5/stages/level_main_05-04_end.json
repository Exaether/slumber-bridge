        "tag": "delay",
        "time": 0.3
    },
    {
        "tag": "playmusic",
        "intro": "$darkness01_intro",
        "key": "$darkness01_loop",
        "volume": 0.8,
        "crossfade": 1.5,
        "delay": 0.5
    },
    {
        "tag": "background",
        "screenadapt": "coverall",
        "image": "bg_home"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "You really kept this room clean all this time.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Hmph. How generous of you to keep a tidy bed for me. Or is this some kind of malediction because you think I'm bad luck?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Wait, the photo... Right, the photo...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 0.3
    },
    {
        "tag": "background"
    },
    {
        "tag": "stopmusic",
        "fadetime": 1
    },
    {
        "tag": "blocker",
        "a": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "text": "You shall receive no love from me, not in the slightest."
    },
    {
        "text": "Sorry. I'm sorry, but I can't stand you. Just seeing you makes me want to peel my skin off my arms."
    },
    {
        "text": "I cannot tolerate any of you. I am too selfish, but I can't live like this anymore."
    },
    {
        "text": "One day, all of you will understand. If you hate me, so be it. Because I hate you too. And that's how it should be."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 0.3
    },
    {
        "tag": "playmusic",
        "intro": "$darkness01_intro",
        "key": "$darkness01_loop",
        "volume": 0.8,
        "crossfade": 1.5,
        "delay": 0.5
    },
    {
        "tag": "character"
    },
