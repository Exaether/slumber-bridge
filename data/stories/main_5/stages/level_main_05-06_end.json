        "crossfade": 1.5,
        "delay": 0.5
    },
    {
        "text": "Right under where you're standing!!",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "tag": "character",
        "name": "char_1011_wizard_1"
    },
    {
        "text": "L.G.D., prepare to meet your makers!",
        "tag": "name",
        "value": "Reunion Caster"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#1"
    },
    {
        "text": "...!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma"
    },
    {
        "text": "Ch'en! Over here! Get behind my shield!!",
        "tag": "name",
        "value": "Hoshiguma"
    },
