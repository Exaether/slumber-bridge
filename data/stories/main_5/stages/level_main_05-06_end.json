        "name": "char_015_lmg"
    },
    {
        "text": "Madam Ch'en! Run!! We've found a large number of explosives on the third floor!",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "tag": "playmusic",
        "intro": "$escapebattle_intro",
        "key": "$escapebattle_loop",
