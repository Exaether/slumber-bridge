    {
        "tag": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "text": "Enemies! We're under attack by enemies! The L.G.D.... It's the L.G.D.!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma"
    },
    {
        "text": "Hah! You'd better believe it!",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "playmusic",
        "intro": "$escapebattle_intro",
