    },
    {
        "text": "*cough* *cough*...",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#4",
        "name2": "char_1507_Mephisto_1#2",
        "focus": 1
    },
    {
        "text": "You're no match for me!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#4",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 2
    },
    {
        "text": "You defeated all my comrades single-handedly? Perhaps I must re-evaluate your abilities, Madam.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#4",
        "name2": "char_1507_Mephisto_1#1",
        "focus": 1
    },
    {
        "text": "That's enough.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "text": "No, far from it. Faust, give her a shake-down.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1508_Faust_1#2"
    },
    {
        "text": "Understood.",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#4"
    },
    {
        "text": "...!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#2"
    },
    {
        "text": "Those on the roof, get down!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_015_lmg"
    },
    {
        "text": "Ahh!",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
