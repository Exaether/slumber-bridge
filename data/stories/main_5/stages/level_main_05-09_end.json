    {
        "text": "Powder...?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "My comrades need healing. They need me.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "text": "Arts? All squads, be on alert! The enemy commander is casting wide-range Arts using some kind of powder!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Don't worry, Madam. This does not concern you, as you are not my comrade.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
