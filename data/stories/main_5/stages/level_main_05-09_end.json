    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "Ugh... argh... Ooaarrrggh!!!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#5"
    },
    {
        "text": "What did you do?!",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#4"
    },
    {
        "text": "The bits of Originium on their bodies... are growing?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "text": "The Originium will pierce through their bodies and become their new form.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "text": "Behold, Officer. These are my guards, my immortal guards.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "avg_npc_015",
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "GRAAAAAAGHHH!!",
        "tag": "name",
        "value": "Mephisto's Guard"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1"
    },
    {
        "text": "Take it all, my herd, my comrades...",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "text": "Fwoo...",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "dialog"
    },
