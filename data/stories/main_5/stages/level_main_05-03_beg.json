    {
        "command": "name",
        "value": "Ch'en",
        "text": "I'm ready, Hoshiguma."
    },
    {
        "command": "character",
        "params": {
            "name": "char_136_hsguma",
            "name2": "char_010_chen_1#1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hoshiguma",
        "text": "That's more like it. I'm going to flush them out of their ambush spots. Give me three minutes."
    },
    {
        "command": "character",
        "params": {
            "name": "char_136_hsguma",
            "name2": "char_010_chen_1#5",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "Doing all that by yourself in three minutes? That's way too reckless!"
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "If you show any signs of needing help, we're going to attack."
    },
    {
        "command": "character",
        "params": {
            "name": "char_136_hsguma",
            "name2": "char_010_chen_1#5",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Hoshiguma",
        "text": "No, just give me my three minutes."
    },
    {
        "command": "character",
        "params": {
            "name": "char_136_hsguma",
            "name2": "char_010_chen_1#5",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "...It's all I'm going to need."
    },
    {
        "command": "character",
        "params": {
            "name": "char_136_hsguma",
            "name2": "char_010_chen_1#5",
