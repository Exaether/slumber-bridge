    },
    {
        "tag": "character",
        "name": "char_219_meteo_1#3"
    },
    {
        "text": "(--Don't!)",
        "tag": "name",
        "value": "Meteorite"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "fadetime": 0
    },
    {
        "tag": "decision",
        "options": "(Quickly cover Amiya's eyes)",
        "values": 1
    },
    {
        "tag": "predicate",
        "references": 1
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
