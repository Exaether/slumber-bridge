        "fadetime": 0
    },
    {
        "tag": "blocker",
        "a": 0,
        "fadetime": 0.8,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#6"
    },
    {
        "text": "Doctor...? !",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#6",
        "focus": -1
    },
    {
        "tag": "decision",
        "options": "Don't look!;...",
        "values": "1;2"
    },
    {
        "tag": "predicate",
        "references": "1;2"
    },
    {
        "tag": "character",
        "name": "char_193_frostl_1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Frostleaf"
    },
    {
        "text": "It's... a burning hellscape of malevolence and madness...",
        "tag": "name",
        "value": "Frostleaf"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Doctor, let go of me.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "I'm fine.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "...No, you must let me see it.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "text": "One day, I must hold him accountable for his actions. Besides, I used to...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#7",
        "focus": -1
    },
    {
        "tag": "decision",
        "options": "(Let go of her)",
        "values": 1
    },
    {
        "tag": "predicate",
        "references": 1
    },
    {
        "tag": "dialog",
        "fadetime": 0
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.6,
        "block": true
    },
    {
        "tag": "image",
        "image": "avg_40_1",
        "y": -50,
        "fadetime": 0,
        "xScale": 1.1,
        "yScale": 1.1
    },
    {
        "tag": "imagetween",
        "image": "bg_0_guard",
        "yto": 0,
