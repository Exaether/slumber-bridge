        "block": true
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Doctor,",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "text": "I have to visit the slums in outer Lungmen again. I should be of assistance.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#7",
        "focus": -1
    },
    {
        "tag": "decision",
        "options": "Will you be fine by yourself?;Isn't that a bit dangerous...?;Amiya, should I go with you?",
        "values": "1;2;3"
    },
    {
        "tag": "predicate",
        "references": "1;2;3"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#3"
    },
    {
        "text": "Don't worry, Doctor.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Another member of Rhodes Island, Projekt Red, will be joining me in Lungmen.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "She's really good!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "With her there, you don't have to worry about me.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "block": true
    },
    {
        "tag": "image"
    }
]