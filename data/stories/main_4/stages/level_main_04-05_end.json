    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "text": "So, when are we heading out?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "text": "Right now.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 1
    },
    {
        "text": "I'll go get ready. Notify the other L.G.D. members.",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_136_hsguma",
        "name2": "char_010_chen_1",
        "focus": 2
    },
    {
        "text": "All right.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1"
    },
    {
        "text": "Amiya, we'll leave from here in ten minutes.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1"
    },
    {
        "text": "Okay.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "background",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "text": "Please be safe...",
        "tag": "name",
        "value": "Amiya"
    },
