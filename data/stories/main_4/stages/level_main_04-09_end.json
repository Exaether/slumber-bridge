        "name": "char_002_amiya_1#7",
        "name2": "char_219_meteo_1",
        "focus": 2
    },
    {
        "text": "Amiya! Frostleaf has broken the enemy's formation, and is now charging towards their commander!",
        "tag": "name",
        "value": "Meteorite"
    },
