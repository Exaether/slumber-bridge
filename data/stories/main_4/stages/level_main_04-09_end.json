        "tag": "character",
        "name": "char_002_amiya_1#7",
        "name2": "char_219_meteo_1",
        "focus": 1
    },
    {
        "text": "Snipers, casters, I need you to cover Frostleaf!",
        "tag": "name",
        "value": "Amiya"
