        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Aaah! Aaaagghhh!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "She sliced through the shield using a blade of frigid air?",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Wh-what?!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_193_frostl_1"
    },
    {
        "text": "Get lost!",
        "tag": "name",
        "value": "Frostleaf"
