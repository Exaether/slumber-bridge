            "name2": "char_219_meteo_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Jessica",
        "text": "(So... cold...)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_259_Jessica_1#5",
            "name2": "char_219_meteo_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Meteorite",
        "text": "(Could they be behind this...?!)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_259_Jessica_1#5",
            "name2": "char_219_meteo_1#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Meteorite",
        "text": "(...! Jessica, why are you biting your fingers--)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_193_frostl_1",
            "name2": "char_219_meteo_1#3",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Frostleaf",
        "text": "(So that her teeth don't chatter and make noise.)"
    },
    {
        "command": "name",
        "value": "Frostleaf",
        "text": "(I don't think that's necessary yet, but what a diligent kid.)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_193_frostl_1",
            "name2": "char_219_meteo_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Meteorite",
        "text": "(To me, you're just a kid too.)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_193_frostl_1",
            "name2": "char_219_meteo_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Frostleaf",
        "text": "(...Hah.)"
    },
    {
        "command": "name",
        "value": "Frostleaf",
        "text": "(As if.)"
    },
