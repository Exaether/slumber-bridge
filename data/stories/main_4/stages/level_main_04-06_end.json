    {
        "text": "We've retrieved the recon team that we were last in contact with.",
        "tag": "name",
        "value": "Medic"
    },
    {
        "text": "It's... looking really bad...",
        "tag": "name",
        "value": "Medic"
    },
    {
        "tag": "character",
        "name": "char_016_medic",
        "name2": "char_003_kalts_1",
        "focus": 2
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "text": "Rubor, hypothermia, and necrosis...",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "text": "What's going on here?",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "tag": "character",
        "fadetime": 0
    },
    {
        "text": "Ngh...",
        "tag": "name",
        "value": "Wounded Operator"
    },
    {
        "tag": "character",
        "name": "char_003_kalts_1#3"
    },
    {
        "text": "Completely frostbitten...?",
        "tag": "name",
        "value": "Kal'tsit"
