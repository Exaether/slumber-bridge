    },
    {
        "text": "Hmm...?",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Where is this...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "We're getting close to the coordinates that Frostleaf sent us, but...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "What a disgusting smell.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "It's the stench of something burning...?",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Where did Reunion lead us to?",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "blocker",
        "a": 1,
        "initr": 2,
        "r": 1,
        "g": 1,
        "b": 1,
        "fadetime": 0.5,
