        "name2": "char_136_hsguma",
        "focus": 2
    },
    {
        "text": "Ch'en, what do you think...",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#3",
        "name2": "char_136_hsguma",
        "focus": 2
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#3",
        "name2": "char_136_hsguma",
        "focus": 2
    },
    {
        "text": "Ch'en?",
        "tag": "name",
        "value": "Hoshiguma"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
