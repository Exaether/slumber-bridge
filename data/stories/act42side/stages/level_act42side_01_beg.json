    },
    {
        "text": "Can you hear me?",
        "tag": "name",
        "value": "Lemuen"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1811_1#8$2",
        "focus": "none"
    },
    {
        "text": "Lemuen?",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1811_1#14$2",
        "focus": "m"
    },
    {
        "text": "I'm near the Shrine of Nurtury, but something just came up and I need to be elsewhere.",
        "tag": "name",
        "value": "Lemuen"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1811_1#14$2",
        "focus": "none"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1811_1#11$2",
        "focus": "m"
    },
    {
        "text": "Did you say something? I couldn't make it out. Why are you whispering? You're not the type to keep your voice down.",
        "tag": "name",
        "value": "Lemuen"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
