            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Liberi Citizen",
        "text": "Do you mean we can have halos too? We can feel each other the way Sanktas do?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1786_1#1$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Nurturer",
        "text": "As you felt the arborbeast's heartbeat at the Nativity."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1784_1#6$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Hildegard",
        "text": "Why?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1786_1#1$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Nurturer",
        "text": "Why what?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1784_1#6$1",
            "focus": "m"
        }
    },
    {
        "command": "name",
        "value": "Hildegard",
        "text": "Why do we need halos?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "stopsound",
