    {
        "text": "Th-this woman...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "She's so hard to deal with!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#4"
    },
    {
        "text": "...Hard to deal with?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Foolish Infected...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1#4"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
