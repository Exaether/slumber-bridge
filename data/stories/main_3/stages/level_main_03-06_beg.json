        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "I know."
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "We don't have much time left."
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "This isn't like Chernobog... This time, it's our turn to stop Reunion!"
    },
