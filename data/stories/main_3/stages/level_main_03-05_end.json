    },
    {
        "command": "character",
        "params": {
            "name": "char_010_chen_1"
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "...It's too late."
    },
    {
        "command": "name",
        "value": "Ch'en",
