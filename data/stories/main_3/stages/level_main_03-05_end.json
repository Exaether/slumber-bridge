            "name2": "char_010_chen_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "W",
        "text": "Oh my, how scary~"
    },
    {
        "command": "name",
        "value": "W",
        "text": "But I'm not here to play with you today."
    },
    {
        "command": "name",
        "value": "W",
