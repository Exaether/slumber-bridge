    },
    {
        "text": "Madam...",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1",
        "name2": "char_015_lmg",
        "focus": 1
    },
    {
        "text": "Speak.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "text": "Most of Reunion's forces have retreated already.",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1",
        "name2": "char_002_amiya_1",
        "focus": 2
    },
    {
        "text": "Madam Ch'en, we're also done here.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1"
    },
    {
        "text": "Tsk...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "About those Reunion suspects that we rounded up a few days ago...",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Have we been able to get any information out of them?",
        "tag": "name",
        "value": "Ch'en"
    },
