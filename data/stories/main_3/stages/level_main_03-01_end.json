    {
        "text": "...",
        "tag": "name",
        "value": "Reunion Suspect"
    },
    {
        "text": "Does this crossbow look familiar to you?",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Reunion Suspect"
    },
    {
        "text": "You're able to draw it, aren't you?",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "text": "What's the structure of the ammunition? How does it work?",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "text": "What were you doing in the slums?",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "text": "What were you doing in Lungmen?",
        "tag": "name",
        "value": "L.G.D. Agent"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Reunion Suspect"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.6,
        "block": true
    },
    {
        "tag": "image",
        "fadetime": 0
    },
    {
        "tag": "character",
        "name": "char_010_chen_1",
        "name2": "char_015_lmg",
        "focus": 2
    },
    {
        "tag": "blocker",
