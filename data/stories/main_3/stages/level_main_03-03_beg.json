    {
        "text": "Curses...!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "There are only two enemies! Get in there already!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "What are you so scared of?!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "playsound",
        "key": "$p_imp_sword_n",
        "volume": 0.7
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 10,
        "ystrength": 8,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": false
    },
    {
        "tag": "character",
        "fadetime": 0
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "We've already lost over twenty soldiers!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Those two devils are no ordinary people...!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "text": "Watch your right!",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "text": "Give me a hand.",
        "tag": "name",
        "value": "Texas"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Keep pressuring her! I'll finish her off!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "text": "I don't have time to deal with that guy rushing at me.",
        "tag": "name",
        "value": "Texas"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "text": "You owe me a drink next time, all right?",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "text": "Sure, now hurry it up.",
        "tag": "name",
        "value": "Texas"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "text": "All right!",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "character",
        "name": "char_103_angel_1"
    },
    {
        "text": "Hey, Mister Reunion guy?",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Huh?",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_103_angel_1"
    },
    {
        "text": "This bullet is my gift to you. Make sure to accept it with gratitude~",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Bullet? What the...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "playsound",
        "key": "$p_atk_smg_h",
        "volume": 0.7,
        "block": true
    },
    {
        "text": "Guh... Ughh...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "fadetime": 0.2
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 2
    },
    {
        "text": "Heh, took care of him for you~",
        "tag": "name",
        "value": "Exusiai"
    },
    {
        "tag": "character",
        "name": "char_102_texas_1",
        "name2": "char_103_angel_1",
        "focus": 1
    },
    {
        "text": "Thank you very much.",
        "tag": "name",
        "value": "Texas"
    },
