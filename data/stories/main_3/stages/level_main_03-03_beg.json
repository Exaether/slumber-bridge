        "value": "Reunion Member"
    },
    {
        "text": "Her... her sword...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Aaaaahh! I'm sorry!!",
        "tag": "name",
        "value": "Texas"
    },
    {
        "text": "--Usually, I prefer to use two.",
        "tag": "name",
        "value": "Texas"
