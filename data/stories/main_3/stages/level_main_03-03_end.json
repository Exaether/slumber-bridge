[
    {
        "text": "\u7b2c\u4e8c\u5341\u4e94\u5173\uff08\u540e\uff09",
        "tag": "header",
        "key": "title_test",
        "is_skippable": true,
        "fit_mode": "BLACK_MASK"
    },
    {
        "tag": "background",
        "image": "bg_wild_a",
        "width": 1,
        "height": 1,
        "fadetime": 1
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2,
        "fadetime": 1,
        "block": true
    },
    {
        "text": "Look.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Hmm...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "This is the trigger.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Just load the ammo like this...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Aim at the enemy, and pull the trigger.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "This will launch the bullet...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Then concentrate, and grip the handle.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Concentrate... and channel your Arts.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "This will cause the bullet to detonate.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "I don't know if I can...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "I know you can do this.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "We have a lot in common. I can feel it within you.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Just picture it in your mind...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Here, hold on to this Originium shard.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Nnh...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "Concentrate.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "text": "My palm feels... hot.",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "That's right!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "I knew it, I knew it...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Yes, Misha, you really are... Haha, ahaha...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "You really are my...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playmusic",
        "intro": "$loading_intro",
        "key": "$loading_loop",
        "volume": 0.8,
        "crossfade": 1.5,
        "delay": 0.5
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_1"
    },
    {
        "text": "...We have to go! Skullshatterer, hurry!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "We can't hold this base anymore!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "What happened?!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Rhodes Island is attacking! We're being rushed!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Those bastards...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Don't panic. Regroup and prepare our counterattack!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Skullshatterer...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "text": "I'm sure... Rhodes Island will...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "Will what? You want me to have a chat with Rhodes Island?",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "They, they're surely trying to help the Infected.",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_1500_skulsr"
    },
    {
        "text": "They killed so many of my comrades...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "You're really asking me to talk to them?",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "All my comrades... they were Infected too!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Rhodes Island, those self-proclaimed saviors of the Infected... what did they do to help my comrades?",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 15,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "blocker",
        "a": 0.3,
        "r": 1,
        "g": 1,
        "b": 1,
        "afrom": 0,
        "rfrom": 0,
        "gfrom": 0,
        "bfrom": 0,
        "fadetime": 0.1,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 0,
        "fadetime": 0.1,
        "block": true
    },
    {
        "text": "What did they say to you to blind you?!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "I don't know...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "Sorry...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "I'm getting too emotional.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "But one thing is certain...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Reunion has finally provided a sliver of hope to the Infected after all this time...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "But Rhodes Island, despite being Infected, chose to hurt us, to slaughter us!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "What are they but traitors?!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "What is there to discuss with traitors?!",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Are the Infected doomed to always kill each other then?",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "Then, what am I supposed to do...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Should I just stand by and watch my comrades die?",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "Don't worry.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "We'll protect you.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "You'll also have to protect yourself though...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Don't get pulled into the fighting.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Please be careful...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Promise... you'll come back...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "text": "Just when I finally found you again...",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "character",
        "name": "char_1500_skulsr"
    },
    {
        "tag": "background",
        "fadetime": 1
    },
    {
        "text": "Yeah. I'll come back for you.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Then, we'll go home together...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_012_misa_1"
    },
    {
        "text": "...Mhm.",
        "tag": "name",
        "value": "Misha"
    },
    {
        "tag": "dialog",
        "fadetime": 0.5
    },
    {
        "tag": "character",
        "fadetime": 0.5
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "background",
        "screenadapt": "coverall",
        "image": "bg_wild_a",
        "width": 1,
        "height": 1,
        "fadetime": 1
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw"
    },
    {
        "text": "Hey there.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "So, you need my help after all?",
        "tag": "name",
        "value": "W"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "That's right.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Actually... the situation is a bit different from what Talulah told us.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "The enemy is more powerful than we expected.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "That's why... you have to protect Misha.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "I don't think I'm obligated to do that.",
        "tag": "name",
        "value": "W"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "You are.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Fine, fine.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "However, it's not enough to just protect Misha, is it?",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "If you fail, they'll still catch up to us.",
        "tag": "name",
        "value": "W"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "What do you have in mind?",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Skullshatterer, don't you remember what I told you before?",
        "tag": "name",
        "value": "W"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "...I do.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "We can turn the tables if we take out that target.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Dr. {@nickname}...",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "See, you were paying attention. All we have to do is take out their commander. Easy, right?",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "The hooded person who's always next to that bunny girl.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "The person who leads Rhodes Island's combat operations.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "If you can kill that one... Bang!",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "Just like that, their brain will be gone.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "Everything will be so easy after that~",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "We don't have many troops left, and we're running out of options.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "There's a location near the front of the mines that will be great for setting up our ambush.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "My casters will provide cover for you... You know what to do, don't you?",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "I'll use my troops to draw them here.",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "Don't miss this opportunity~",
        "tag": "name",
        "value": "W"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 2
    },
    {
        "text": "I understand.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "...Take care of Misha for me.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "character",
        "name": "char_1504_cqbw",
        "name2": "char_1500_skulsr",
        "focus": 1
    },
    {
        "text": "Sure thing~",
        "tag": "name",
        "value": "W"
    },
    {
        "text": "Hmph... Anyways, good luck.",
        "tag": "name",
        "value": "W"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "block": true
    },
    {
        "tag": "image"
    }
]