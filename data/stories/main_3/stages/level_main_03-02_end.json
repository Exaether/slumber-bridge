        "params": {
            "name": "char_012_misa_1#4",
            "name2": "char_1500_skulsr",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Skullshatterer",
        "text": "You couldn't see the truth. But it should be clear to you now..."
