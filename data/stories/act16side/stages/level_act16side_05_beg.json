            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Ezell",
        "text": "So once the funeral is over... I'm leaving with Cecelia."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_4036_forcer_1#1$1",
            "name2": "avg_npc_351_1#1$1",
            "focus": 2
