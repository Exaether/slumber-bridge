    },
    {
        "command": "name",
        "value": "Ezell",
        "text": "Andoain, I don't care about your grand ideals, and I'm not interested in discussing faith with you."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_4036_forcer_1#1$1",
