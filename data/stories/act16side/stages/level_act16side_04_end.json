    },
    {
        "text": "They grow only in the Central Garden of Saint Marcel, the Sunset Chapel, and the Ecclesia Requietum in Stevonus.",
        "tag": "name",
        "value": "Fiammetta"
    },
    {
        "tag": "character",
        "name": "avg_213_mostma_1#10$1"
    },
    {
        "text": "Yeah.",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "tag": "character",
        "name": "avg_213_mostma_1#10$1"
    },
    {
        "text": "Come on, we'll go together.",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "tag": "character",
        "name": "avg_213_mostma_1#7$1"
    },
    {
        "text": "You're my warden. Better make sure I'm not hurt on the job.",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "tag": "character",
        "name": "avg_300_phenxi_1#3$1"
    },
