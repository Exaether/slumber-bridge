    {
        "text": "Fiammetta, Fiammetta!",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "text": "Shimmering Vigil!",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "tag": "character",
        "name": "avg_300_phenxi_1#2$1"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 20,
        "ystrength": 50,
        "vibrato": 50,
        "randomness": 50,
        "fadeout": true,
        "block": false
    },
    {
        "text": "You want me to bash your face in?!",
        "tag": "name",
        "value": "Fiammetta"
    },
    {
        "tag": "character",
        "name": "avg_213_mostma_1#6$1"
    },
    {
        "text": "Listen to me!",
        "tag": "name",
        "value": "Mostima"
    },
    {
        "tag": "character",
        "name": "avg_300_phenxi_1#2$1"
    },
    {
        "text": "I've got something to say to you, Mostima!",
        "tag": "name",
        "value": "Fiammetta"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
