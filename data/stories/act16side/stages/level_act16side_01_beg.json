    {
        "text": "Are you this girl's relative?",
        "tag": "name",
        "value": "Reserved Hospital Attendant"
    },
    {
        "tag": "character",
        "name": "avg_4036_forcer_1#1$1"
    },
    {
        "text": "Functionally.",
        "tag": "name",
        "value": "Ezell"
    },
    {
        "tag": "character",
        "name": "avg_npc_365_1#1$1"
    },
    {
        "text": "Come with me. She's got somewhat special circumstances, and the doctor said he needs to talk with you in private.",
        "tag": "name",
        "value": "Reserved Hospital Attendant"
    },
    {
        "tag": "character",
        "name": "avg_4036_forcer_1#7$1"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Ezell"
    },
    {
        "text": "There was a strong gust of wind just now. I'll close the window, in case she'd catch a cold.",
        "tag": "name",
        "value": "Ezell"
    },
    {
        "tag": "character",
        "name": "avg_npc_365_1#1$1"
    },
    {
        "text": "Hm? Of course.",
        "tag": "name",
        "value": "Reserved Hospital Attendant"
    },
