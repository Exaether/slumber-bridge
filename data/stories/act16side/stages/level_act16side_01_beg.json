    },
    {
        "text": "You're sure you fetched the right report?",
        "tag": "name",
        "value": "Conscientious Doctor"
    },
    {
        "tag": "character",
        "name": "avg_npc_368_1#1$1"
    },
    {
        "text": "Yyyes. Is there a problem?",
        "tag": "name",
        "value": "Blabbermouth Hospital Attendant"
    },
    {
        "tag": "character",
        "name": "avg_npc_366_1#1$1"
    },
    {
        "text": "I've never seen a blood analysis this strange before.",
        "tag": "name",
        "value": "Conscientious Doctor"
    },
    {
        "text": "Once it's photocopied, send the original to the head doctor's office, along with this note from me.",
        "tag": "name",
        "value": "Conscientious Doctor"
    },
    {
        "text": "I need to pay a visit to Recovery.",
        "tag": "name",
        "value": "Conscientious Doctor"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
