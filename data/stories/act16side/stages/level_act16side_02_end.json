    {
        "tag": "character",
        "name": "avg_4036_forcer_1#5$1",
        "name2": "avg_npc_352_1#1$1",
        "focus": 1
    },
    {
        "text": "We're home, Cecelia.",
        "tag": "name",
        "value": "Ezell"
    },
    {
        "tag": "character",
        "name": "avg_4036_forcer_1#5$1",
        "name2": "avg_npc_352_1#1$1",
        "focus": 2
    },
    {
        "text": "Um... I don't have the key, I can't get in... Mister Ezell, can you...",
        "tag": "name",
        "value": "Cecelia"
    },
    {
        "tag": "character",
        "name": "avg_4036_forcer_1#5$1",
        "name2": "avg_npc_352_1#9$1",
        "focus": 2
    },
    {
        "text": "Are you really okay? Do you feel bad...? You've been looking down for a while.",
        "tag": "name",
        "value": "Cecelia"
    },
    {
        "tag": "character",
        "name": "avg_4036_forcer_1#7$1",
        "name2": "avg_npc_352_1#9$1",
        "focus": 1
    },
    {
        "text": "I'm fine. Let me get the door open...",
        "tag": "name",
        "value": "Ezell"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
