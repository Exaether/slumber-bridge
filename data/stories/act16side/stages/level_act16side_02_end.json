    },
    {
        "tag": "characteraction",
        "name": "left",
        "type": "move",
        "xpos": -50,
        "fadetime": 0.5,
        "block": false
    },
    {
        "tag": "characteraction",
        "name": "right",
        "type": "move",
        "xpos": 50,
