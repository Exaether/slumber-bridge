    {
        "text": "PCS\u7cfb\u7edf\uff0c\u4fdd\u5b58\u8005\u7684\u7ef4\u751f\u8231\uff0c\u5e78\u5b58\u7684\u5de8\u517d\uff0c\u7834\u635f\u7684\u661f\u95e8......\u90a3\u4e9b\u7834\u788e\u9057\u8ff9\uff0c\u7adf\u7136\u662f\u4ee5\u8fd9\u79cd\u65b9\u5f0f\u5851\u9020\u4e86\u65b0\u751f\u6587\u660e\u7684\u6837\u8c8c\u3002"
    },
    {
        "text": "\u51fa\u4eba\u610f\u6599\u7684\u7ed3\u679c\uff0c\u5374\u56e0\u8fc7\u4e8e\u8352\u5510\u800c\u663e\u5f97\u6709\u8da3\u3002"
