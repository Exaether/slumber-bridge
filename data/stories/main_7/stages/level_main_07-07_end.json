        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "What is it? ...Oh."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_012"
        }
    },
    {
        "command": "name",
        "value": "Rhodes Island Operator",
        "text": "Signs of combat using sharp, blade-type Arts. Made quick work of three Reunion guys, tossed them over here."
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "...still going."
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Dr. Kal'tsit!"
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Um, I'm asking you and the medic operators to take care of the Reunion people. They may have important information."
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "And we've picked up Madame Ch'en's trail here..."
