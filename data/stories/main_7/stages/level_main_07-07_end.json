    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "...Hold on, Madame Ch'en. We're coming..."
    },
    {
        "command": "decision",
        "params": {
            "options": "We're doing this again?;......;Feels like d\u00e9j\u00e0 vu.",
            "values": "1;2;3"
        }
    },
