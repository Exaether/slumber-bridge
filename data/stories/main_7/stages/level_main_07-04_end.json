        "volume": 0.4
    },
    {
        "text": "The device is fully functional! Amiya, we're ready to move!",
        "tag": "name",
        "value": "Nearl"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "text": "Roger!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_003_kalts_1"
    },
    {
        "text": "Drivers, maintain a steady speed! Check your maps. Use the sandstorm to cover your approach to the core city until you're in range to deploy boarding gear! Engage!",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "tag": "dialog"
    },
