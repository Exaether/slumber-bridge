    {
        "text": "Bloodied. Torn. Pierced."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "decision",
        "options": "This isn't right.",
        "values": 1
    },
    {
        "tag": "predicate",
        "references": 1
    },
    {
        "tag": "playsound",
        "key": "$e_skill_skulsrsword",
        "volume": 0.9
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
        "text": "Us. Enemies. People."
    },
    {
        "text": "Wailing, screaming, groaning."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "background",
        "image": "bg_cherunder",
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
