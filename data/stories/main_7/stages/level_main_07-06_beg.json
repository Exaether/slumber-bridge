    },
    {
        "command": "name",
        "value": "Rosmontis",
        "text": "Wait a second."
    },
    {
        "command": "name",
        "value": "Rosmontis",
        "text": "Some distant, vague feelings are coming to me."
    },
    {
        "command": "name",
        "value": "Rosmontis",
        "text": "An orderly, unchanging flow, with no conflict."
    },
    {
        "command": "name",
        "value": "Rosmontis",
        "text": "...Ironclad. And they're moving."
    },
    {
        "command": "playmusic",
        "params": {
            "intro": "$mist_intro",
            "key": "$mist_loop",
            "volume": 0.4
        }
    },
    {
        "command": "character",
