        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "text": "She's here.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "Finally.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "I'll kill her myself.",
        "tag": "name",
        "value": "Talulah"
    },
    {
