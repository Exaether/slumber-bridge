    {
        "text": "Runner Seven, destroyed!",
        "tag": "name",
        "value": "Rosmontis"
    },
    {
        "tag": "character",
        "name": "char_003_kalts_1"
    },
    {
        "text": "Runner Eight, intercepted.",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "text": "Raidian, execute the feint! Use your Arts to extend or hit their nervous systems directly!",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "text": "Pull all the enemies!",
        "tag": "name",
        "value": "Kal'tsit"
    },
