    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Sarkaz casters. They're the only ones who could interfere with Arts like Rosmontis's."
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Then it's up to me...!"
