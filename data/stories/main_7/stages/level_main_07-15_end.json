    {
        "command": "character",
        "params": {
            "name": "char_003_kalts_1"
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Raidian, how long can you keep it up?"
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "...We'll be quick."
