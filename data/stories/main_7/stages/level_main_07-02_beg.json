    {
        "command": "name",
        "value": "Rat King",
        "text": "...Yes. I understand."
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Greytail",
        "text": "Anything else, Master?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_034"
        }
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "No. Go and do what I told you for now. When you're finished, find somewhere to lay low for a while."
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Greytail",
        "text": "Got it."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_034"
        }
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "Now go. Hurry."
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "Ah."
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "\u2014\u2014*Sigh*. It turns out there really is someone who can outplay Wei Yenwu."
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "Talulah, Talulah... is this really just fate?"
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "Oh, Young Master, if you could see us now from up there, you also would not wish to see this, would you?"
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "But alas, Lungmen's finally come to this."
    },
    {
        "command": "name",
        "value": "Rat King",
        "text": "But Hui-chieh... Hui-chieh! Be careful, Hui-chieh... You mustn't get yourself killed!"
    },
