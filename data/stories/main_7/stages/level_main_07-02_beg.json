    {
        "command": "name",
        "value": "L.G.D. Officer",
        "text": "A secret arrest warrant? For Ch'en Sir?!"
    },
    {
        "command": "name",
        "value": "L.G.D. Officer",
        "text": "It's gotta be a mistake? There's no way..."
    },
    {
        "command": "name",
        "value": "L.G.D. Officer",
        "text": "Hey! Get back here! I asked you if this was a mistake or not!"
    },
    {
        "command": "name",
        "value": "L.G.D. Officer",
        "text": "Damn it, Ch'en Sir, what the hell... who's behind this?!"
    },
    {
        "command": "name",
        "value": "L.G.D. Officer",
        "text": "I have to find her. I have to hear her side of the story!"
    },
