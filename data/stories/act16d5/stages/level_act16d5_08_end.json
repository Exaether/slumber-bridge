    },
    {
        "command": "name",
        "value": "Saga",
        "text": "Hoh?!"
    },
    {
        "command": "name",
        "value": "Saga",
        "text": "A-Am I returning to the painting...?"
    },
    {
        "command": "name",
        "value": "Saga",
        "text": "Oh, this must be what the head priest saw\u2014"
    },
    {
        "command": "name",
        "value": "Saga",
        "text": "\u2014"
    },
    {
        "command": "dialog"
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "playsound",
        "params": {
