    {
        "tag": "character",
        "name": "char_1011_purgatory_1#1",
        "name2": "char_362_Saga#2",
        "focus": 2
    },
    {
        "text": "I do not know at all... Only, I know not why, but I feel I have seen this object somewhere in the past...",
        "tag": "name",
        "value": "Saga"
    },
    {
        "tag": "character",
        "name": "char_1011_purgatory_1#2",
        "name2": "char_362_Saga#2",
        "focus": 1
    },
    {
        "text": "Really?!",
        "tag": "name",
        "value": "Lava"
    },
    {
        "tag": "character",
        "name": "char_1011_purgatory_1#2",
        "name2": "char_362_Saga#4",
        "focus": 2
    },
    {
        "text": "Allow me to think... ho... this texture... this material... I have, somewhen, somewhere, experienced it before...",
        "tag": "name",
        "value": "Saga"
    },
    {
        "tag": "dialog"
    },
