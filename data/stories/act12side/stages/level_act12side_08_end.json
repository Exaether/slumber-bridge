    },
    {
        "tag": "character",
        "name": "avg_npc_198_1#4"
    },
    {
        "tag": "charactercutin",
        "widgetID": 1,
        "fadetime": 0
    },
    {
        "tag": "largebg",
        "imagegroup": "bg_20_G04_1/bg_20_G04_2",
        "solidwidth": "920/920",
        "solidheight": 720,
        "x": -720
    },
    {
