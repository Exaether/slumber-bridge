        "width": 200,
        "block": true
    },
    {
        "text": "*Cough*... Testing, 1, 2, 3. Can you hear me?",
        "tag": "name",
        "value": "Candela"
    },
    {
        "text": "My dear citizens and friends, as well as our beloved tourists from afar, Candela speaking.",
        "tag": "name",
        "value": "Candela"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
