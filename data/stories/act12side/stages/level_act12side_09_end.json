            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Pancho",
        "text": "Meaning? You call wasting your life away on entertainment meaning?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_192_1#8",
            "name2": "avg_npc_198_1#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Candela",
        "text": "*Sigh*, look at how stubborn you are. You will never understand what money represents."
    },
    {
        "command": "name",
        "value": "Candela",
        "text": "Okay, take this old bastard away. I will talk to him some other time."
    },
    {
        "command": "name",
        "value": "Candela",
        "text": "If you come across anyone trying to resist, you know what to do."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_207"
        }
    },
    {
        "command": "name",
        "value": "Bodyguard",
        "text": "Yes, ma'am."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
