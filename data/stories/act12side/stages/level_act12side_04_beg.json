    {
        "tag": "character",
        "name": "avg_NPC_017_3"
    },
    {
        "text": "Let's welcome\u2014LUNG wRATh!",
        "tag": "name",
        "value": "D.D.D."
    },
    {
        "tag": "dialog"
    },
