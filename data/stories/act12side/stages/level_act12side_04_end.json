    {
        "command": "name",
        "value": "D.D.D.",
        "text": "They've been the target of collusion from the very start of the event, but LUNG wRATh have once again put on a marvelous breakthrough act."
    },
    {
        "command": "dialog"
    },
    {
        "command": "playsound",
