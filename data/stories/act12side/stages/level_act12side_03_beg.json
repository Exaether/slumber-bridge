    {
        "tag": "subtitle",
        "text": "After Rafaela parts with the stranger, Lin Y\u00fchsia noiselessly drops down from a beam in the roof, and lands where they stood just a moment ago.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
