    {
        "tag": "character",
        "name": "avg_1013_spchen_1#7",
        "name2": "avg_npc_196_1#5",
        "focus": 1
    },
    {
        "text": "You're sure?",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "character",
        "name": "avg_1013_spchen_1#7",
        "name2": "avg_npc_196_1#5",
        "focus": 2
    },
    {
        "text": "I'll ride, you sort out anyone in the way.",
