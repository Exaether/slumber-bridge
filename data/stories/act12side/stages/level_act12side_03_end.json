        "text": "I guess."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_196_1#1",
            "name2": "avg_1013_spchen_1#1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "What about you?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_196_1#1",
