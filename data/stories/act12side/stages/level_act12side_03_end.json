    {
        "command": "name",
        "value": "Lin Y\u00fchsia",
        "text": "Having fun acting the hero, Hui-chieh?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_196_1#1",
            "name2": "avg_1013_spchen_1#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "Not really, but I don't need you worrying."
