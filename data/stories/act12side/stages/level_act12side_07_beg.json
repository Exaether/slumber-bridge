    },
    {
        "command": "name",
        "value": "Terrified Male Tourist",
        "text": "Was that an explosion?! Where was it?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_202"
        }
    },
    {
        "command": "name",
        "value": "Terrified Female Tourist",
        "text": "I think it came from the place where the first round took place! Look, there's smoke in that direction!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_201"
        }
    },
    {
        "command": "name",
        "value": "Terrified Male Tourist",
        "text": "Hey, hey, hey! You're kidding! Is old man Pancho serious?!"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
