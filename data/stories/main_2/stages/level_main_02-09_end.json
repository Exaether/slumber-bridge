    {
        "tag": "character",
        "name": "char_1500_skulsr"
    },
    {
        "text": "Continue the chase.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "text": "Don't give them any room to breathe.",
        "tag": "name",
        "value": "Skullshatterer"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
