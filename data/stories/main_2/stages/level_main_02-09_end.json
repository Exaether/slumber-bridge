    {
        "command": "character",
        "params": {
            "name": "char_010_chen_1",
            "name2": "char_012_misa_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Misha",
        "text": "...I'm not sure."
    },
    {
        "command": "name",
        "value": "Misha",
        "text": "I can't think of any reason why you'd want me."
