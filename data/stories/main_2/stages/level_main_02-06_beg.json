    {
        "text": "...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Exusiai, the enemy showed up unexpectedly...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_106_franka_1"
    },
    {
        "text": "I already sealed off the entrance, so how...",
