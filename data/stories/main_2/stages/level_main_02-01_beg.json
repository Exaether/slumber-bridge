        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "text": "Both of you, please complete your combat preparations. Doctor, once you've decided on your squad assignments, please let the operators know so that they also have time to prepare.",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "We'll set out 15 minutes after you finish your drills.",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "image",
        "fadetime": 0
    },
    {
        "tag": "delay",
        "time": 0.4
    },
    {
        "text": "Oh, and make sure you're not late this time.",
        "tag": "name",
        "value": "Dobermann"
    }
