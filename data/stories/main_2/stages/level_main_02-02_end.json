    {
        "command": "character",
        "params": {
            "name": "char_2005_weiyw_1",
            "name2": "char_010_chen_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Wei Yenwu",
        "text": "Ah, right, Talulah."
    },
    {
        "command": "name",
        "value": "Wei Yenwu",
        "text": "Madam Ch'en, what do you think?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_2005_weiyw_1",
            "name2": "char_010_chen_1#5",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "..."
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "I... I know."
    },
    {
        "command": "dialog"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
