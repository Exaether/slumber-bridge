    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "text": "Phew... she's really hard to talk to.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "text": "Dr. {@nickname}, from here on, Dr. Kal'tsit will be handling the negotiations.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Please have confidence in her.",
        "tag": "name",
        "value": "Amiya"
    },
