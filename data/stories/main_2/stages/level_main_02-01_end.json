        "fadetime": 1,
        "block": true
    },
    {
        "text": "I'll remind you once more.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Lungmen is the next Chernobog.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#2"
    },
    {
        "text": "Dr. Kal'tsit...!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_010_chen_1"
    },
    {
        "text": "Rhodes Island's representative has already met with Chief Wei.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "Please wait here.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "text": "I'll notify you shortly.",
        "tag": "name",
        "value": "Ch'en"
    },
    {
        "tag": "dialog",
        "fadetime": 0.6
    },
    {
