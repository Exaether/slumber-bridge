        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7",
            "name2": "char_012_misa_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Misha",
        "text": "...Do you know why they're after me?"
