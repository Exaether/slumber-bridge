    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "Yes.",
        "tag": "name",
        "value": "Shu"
    },
    {
        "text": "You've truly lived now."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopsound",
        "channel": "a",
