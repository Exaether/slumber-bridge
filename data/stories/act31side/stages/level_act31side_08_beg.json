        "tag": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "text": "Sir, a young man asked me to deliver this to package to you before the day of Dongzhi.",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avgnew_2014_nian_1#8$1"
    },
    {
        "text": "Don't have the guts to see me in person?",
        "tag": "name",
        "value": "Nian"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "text": "I suppose... he's passed on by now...",
        "tag": "name",
        "value": "Old Man"
    },
    {
        "text": "The bag is empty."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avgnew_2014_nian_1#6$1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Nian"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
