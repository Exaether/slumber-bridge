        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "background",
        "image": "bg_cottage",
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
