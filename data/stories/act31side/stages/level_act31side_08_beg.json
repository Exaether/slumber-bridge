    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "Is this a painting?",
        "tag": "name",
        "value": "Dusk"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_799_1#1$1"
    },
    {
        "text": "My painting.",
        "tag": "name",
        "value": "Mr. Ruan"
    },
    {
        "text": "This is the view we ignorant mortals see.",
        "tag": "name",
        "value": "Mr. Ruan"
    },
    {
        "text": "Even one like you with all the views you have seen are only a drop in the ocean when compared to the tumultuous changes this land has experienced over the last millennium.",
        "tag": "name",
        "value": "Mr. Ruan"
    },
    {
        "text": "Please, take a good look once more.",
        "tag": "name",
        "value": "Mr. Ruan"
    },
    {
        "text": "For we only have this one dusk.",
        "tag": "name",
        "value": "Mr. Ruan"
    },
    {
        "tag": "dialog"
    },
    {
