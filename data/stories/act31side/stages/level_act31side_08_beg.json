    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "background",
        "image": "bg_indoor",
        "screenadapt": "coverall"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_gatecloz"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
