    {
        "text": "Uncle?",
        "tag": "name",
        "value": "Grain Buds"
    },
    {
        "text": "Mute Uncle? Where are you?",
        "tag": "name",
        "value": "Grain Buds"
    },
    {
        "text": "Don't try to fight those monsters, okay? Come out already, and let's get out of here together!",
        "tag": "name",
        "value": "Grain Buds"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
