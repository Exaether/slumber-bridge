    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1249_1#1$1",
        "focus": "l"
    },
    {
        "text": "It's working! We did it!",
        "tag": "name",
        "value": "Excited Farmer"
    },
    {
        "text": "I get it now! These things were transformed from the pests in the field!",
        "tag": "name",
        "value": "Excited Farmer"
    },
    {
        "text": "Ma le ge ba zi! They're not monsters at all!",
        "tag": "name",
        "value": "Excited Farmer"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Nothing to be scared of! Gather up, and let's get rid of the beasts messin' with our crops!",
        "tag": "name",
        "value": "Excited Farmer"
