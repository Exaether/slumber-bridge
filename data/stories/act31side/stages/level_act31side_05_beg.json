        "block": false
    },
    {
        "tag": "sticker",
        "id": "st3",
        "text": "You've always been able to see that future, haven't you?",
        "x": 500,
        "y": 400,
        "alignment": "center",
        "size": 22,
        "delay": 0.001,
        "width": 700,
        "block": true,
        "duration": 0.5
    },
    {
        "tag": "sticker",
        "id": "st3",
        "duration": 0.5,
        "block": false
    },
    {
        "tag": "sticker",
        "id": "st4",
        "text": "...",
        "x": 0,
        "y": 300,
        "alignment": "center",
        "size": 22,
        "delay": 0.001,
        "width": 700,
        "block": true,
        "duration": 0.5
    },
    {
        "tag": "sticker",
        "id": "st4",
        "duration": 0.5,
        "block": false
    },
    {
        "tag": "sticker",
        "id": "st5",
        "text": "In the end, you'll...",
        "x": 0,
        "y": 300,
        "alignment": "center",
        "size": 22,
        "delay": 0.001,
        "width": 700,
        "block": true,
        "duration": 0.5
    },
    {
        "tag": "sticker",
        "id": "st5",
        "duration": 0.5,
        "block": false
    },
    {
        "tag": "sticker",
        "id": "st6",
        "text": "No... Don't tell me. I don't want to know when I'll die.",
        "x": 500,
        "y": 400,
        "alignment": "center",
        "size": 22,
        "delay": 0.001,
        "width": 700,
        "block": true,
        "duration": 0.5
    },
    {
        "tag": "sticker",
        "id": "st6",
        "duration": 0.5,
        "block": false
    },
    {
        "tag": "sticker",
        "id": "st6",
        "text": "I just want to ask...",
        "x": 500,
        "y": 400,
        "alignment": "center",
        "size": 22,
        "delay": 0.001,
        "width": 700,
        "block": true,
        "duration": 0.5
    },
    {
        "tag": "sticker",
        "id": "st6",
        "duration": 1,
        "block": false
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "tag": "sticker",
        "id": "st6",
        "text": "Will our dream of The Ten Thousand Qing of Fertile Fields come true?",
        "x": 500,
        "y": 400,
        "alignment": "center",
        "size": 22,
        "delay": 0.001,
        "width": 700,
        "block": true,
        "duration": 1
    },
    {
        "tag": "sticker",
        "id": "st6",
        "duration": 1,
        "block": false
    },
