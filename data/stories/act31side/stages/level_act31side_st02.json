    },
    {
        "text": "What did you do?!",
        "tag": "name",
        "value": "Dusk"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1236_1#4$1"
    },
    {
        "text": "What ever do you mean?",
        "tag": "name",
        "value": "Ji"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avgnew_2015_dusk_1#5$1"
    },
    {
        "text": "She's gone!",
        "tag": "name",
        "value": "Dusk"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "What are you up to?!",
        "tag": "name",
        "value": "Dusk"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1236_1#4$1"
    },
    {
        "text": "Why ask me?",
        "tag": "name",
        "value": "Ji"
    },
    {
        "text": "It has always been her decision alone to stay here and guard this place. When have I ever interfered in any way?",
        "tag": "name",
        "value": "Ji"
    },
    {
        "text": "Was it not 'man' who locked her away in this land for a millennium?",
        "tag": "name",
        "value": "Ji"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avgnew_2014_nian_1#3$1",
