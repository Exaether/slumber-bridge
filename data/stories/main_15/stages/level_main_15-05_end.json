            "slot": "m",
            "focus": "n"
        }
    },
    {
        "command": "decision",
        "params": {
            "options": "When it's all over, we'll go apologize to her together.;It's not this plan she's opposed to, per se.",
            "values": "1;2"
        }
    },
    {
        "command": "predicate",
        "params": {
            "references": "1;2"
        }
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
