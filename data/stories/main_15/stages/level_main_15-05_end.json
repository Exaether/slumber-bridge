    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "npc_10002",
        "focus": "r"
    },
    {
        "text": "(Passionate cry)",
        "tag": "name",
        "value": "Mon3tr"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_003_kalts_1#1$1",
        "focus": "l"
    },
    {
        "text": "Mon3tr, I will protect the Doctor and Amiya.",
        "tag": "name",
        "value": "Kal'tsit"
    },
