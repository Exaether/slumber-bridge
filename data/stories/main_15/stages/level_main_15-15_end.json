    },
    {
        "text": "Mon3tr appears by your side, but its stance is slightly different than usual."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 30,
        "ystrength": 30,
