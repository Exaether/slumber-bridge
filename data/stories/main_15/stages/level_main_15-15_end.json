    {
        "tag": "subtitle",
        "text": "Unconsciously, I seem to have grown accustomed to having someone at my side, guiding me.",
        "x": 300,
        "y": 350,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "Until now. I finally am sure of what I want to do.",
        "x": 300,
        "y": 350,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "No matter what happens, I will continue down this path. I will not abandon hope.",
        "x": 300,
        "y": 350,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle",
        "text": "But...",
        "x": 300,
        "y": 350,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
