    },
    {
        "text": "How\u2014",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
