    {
        "tag": "dialog"
    },
    {
        "tag": "decision",
        "options": "Hopefully I'm not too late.;Sorry, I couldn't sit back and do as I was told.",
        "values": "1;2"
    },
    {
        "tag": "predicate",
        "references": "1;2"
    },
    {
        "text": "Doctor... Thank goodness...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "That moment just now...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_messagewave"
    },
    {
        "tag": "imagetween",
        "xScaleTo": 1.05,
