    },
    {
        "text": "Popukar was awakened by the continuous flashing. She looks out of the porthole, but sees nothing unusual outside."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_281_popka_1#1$1"
    },
    {
        "text": "Looks like a nice day. No sign of rain.",
        "tag": "name",
        "value": "Popukar"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_erthshkng",
        "volume": 0.7
    },
    {
        "tag": "camerashake",
        "duration": 1.5,
        "xstrength": 10,
        "ystrength": 10,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_281_popka_1#8$1"
    },
    {
        "text": "Maybe somebody was training noisily outside?",
        "tag": "name",
        "value": "Popukar"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_281_popka_1#2$1"
    },
    {
        "text": "Hm... PRTS comms are still down?",
        "tag": "name",
        "value": "Popukar"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_281_popka_1#4$1"
    },
    {
        "text": "Looks like today's assignment is in the isolation zone outside the ship. I should report to Orchid.",
        "tag": "name",
        "value": "Popukar"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "background",
        "image": "bg_rhodesupperdeck",
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
