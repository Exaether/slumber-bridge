    },
    {
        "text": "Doctor, be careful!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1037_amiya3_1#6$3"
    },
    {
        "text": "Originium activity in this area far exceeds Dr. Kal'tsit's estimations. Originium crystals are growing at a breakneck pace...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Plus those strange enemies that keep appearing\u2014",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "Yet your attention is drawn to the Originium in front of you."
    },
    {
        "text": "Every shard, every facet..."
    },
    {
        "text": "Reflects the same scene in your eyes\u2014"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "decision",
        "options": "I see...",
        "values": 1
    },
    {
        "tag": "predicate",
        "references": 1
    },
    {
        "tag": "decision",
        "options": "Her silhouette appears on every facet.",
        "values": 1
    },
