    {
        "text": "I've received your inquiry, Closure.",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "text": "PRTS is denying all access requests. We've lost administrator permissions and we do not have the ability to retake PRTS.",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "interlude",
        "channel": 3,
        "switch": false
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1723_1#8$1",
        "duration": 0.5
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "Kal'tsit?!",
        "tag": "name",
        "value": "Closure"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 15,
        "ystrength": 15,
        "vibrato": 20,
        "randomness": 70,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1723_1#9$1",
        "focus": "r"
    },
    {
        "text": "Finally, an answer!",
        "tag": "name",
        "value": "Closure"
    },
    {
        "text": "Where are you? The Doctor and Amiya are coming over to help!",
        "tag": "name",
        "value": "Closure"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1723_1#6$1",
        "focus": "r"
    },
    {
        "text": "Bad news. PRTS is taking over all equipment on the ship, including the engines.",
        "tag": "name",
        "value": "Closure"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "focus": "n"
    },
    {
        "tag": "interlude",
        "channel": 3,
        "switch": true
    },
    {
        "text": "I know. I'm fighting for Rhodes Island's last chance.",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
        "tag": "interlude",
        "channel": 3,
        "switch": true,
        "type": 3,
        "slot": "m",
        "pfrom": "-230,0",
        "pto": "-230,0",
        "name": "avg_003_kalts_1#6$1",
        "duration": 0
    },
    {
        "text": "Closure, warn the Doctor and Amiya\u2014",
        "tag": "name",
