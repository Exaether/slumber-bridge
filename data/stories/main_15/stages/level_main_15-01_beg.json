        "focus": "m"
    },
    {
        "text": "You're skilled, but you're merely using the skills I've taught you.",
        "tag": "name",
        "value": "Theresis"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_4132_ascln_1#1$1",
        "duration": 1.5,
        "afrom": 1,
        "ato": 0,
