    },
    {
        "tag": "playsound",
        "key": "$d_avg_crwddiscuss_outside",
        "loop": true,
        "channel": "bgs",
        "volume": 0
    },
    {
        "tag": "soundvolume",
        "volume": 0.2,
        "channel": "bgs",
