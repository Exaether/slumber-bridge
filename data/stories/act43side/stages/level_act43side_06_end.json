    {
        "text": "......",
        "tag": "name",
        "value": "Moira"
    },
    {
        "text": "Wh-What was he talking about...",
        "tag": "name",
        "value": "Moira"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
