    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Laura had no younger sister.",
        "tag": "name",
        "value": "Lucian"
    },
    {
        "text": "She was never a part of your life.",
        "tag": "name",
        "value": "Lucian"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$flashback",
        "volume": 0.8
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 255,
        "g": 255,
        "b": 255,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
