        "time": 2
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1846_1#5$1"
    },
    {
        "text": "Ahh\u2014!",
        "tag": "name",
        "value": "Unlucky Stagehand"
    },
    {
        "tag": "dialog"
    },
    {
