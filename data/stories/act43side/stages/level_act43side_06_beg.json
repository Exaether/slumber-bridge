    {
        "command": "name",
        "value": "Moira",
        "text": "Hmm... I see how it is."
    },
    {
        "command": "name",
        "value": "Moira",
        "text": "The structure and systems look complex, but once you figure out the theory behind it..."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1831_1#9$2"
        }
    },
    {
        "command": "name",
        "value": "Moira",
        "text": "Even a prop-maker can operate it."
    },
    {
        "command": "name",
        "value": "Moira",
        "text": "For example, here, adjust its direction first..."
    },
    {
        "command": "dialog"
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_avg_keyboard_console",
