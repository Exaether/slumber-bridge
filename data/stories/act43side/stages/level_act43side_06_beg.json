    {
        "command": "subtitle",
        "params": {
            "text": "'...Greta... sent out compensation to everyone and officially disbanded the crew.'",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "'...Greta... sent out compensation to everyone and officially disbanded the crew.'"
    },
    {
        "command": "subtitle",
        "params": {
            "text": "'Whether you're scared of the killer, worried about the Catastrophe, or want to stay and finish the shoot, we're all free to do as we please.'",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "'Whether you're scared of the killer, worried about the Catastrophe, or want to stay and finish the shoot, we're all free to do as we please.'"
    },
    {
        "command": "subtitle",
        "params": {
            "text": "Finish the shoot? Greta is still thinking about her movie right now?",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "Finish the shoot? Greta is still thinking about her movie right now?"
    },
    {
        "command": "subtitle",
        "params": {
            "text": "She must have noticed the connection between the murders of the crew and the one five years ago.",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "She must have noticed the connection between the murders of the crew and the one five years ago."
    },
    {
        "command": "subtitle",
        "params": {
            "text": "So she's doing it on purpose...",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "So she's doing it on purpose..."
    },
    {
        "command": "subtitle"
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_avg_openftstpwalk",
            "volume": 1
        }
    },
    {
        "command": "delay",
        "value": 1.5
    },
    {
        "command": "subtitle",
        "params": {
            "text": "'Frankly, my dear, I don't give a damn, and I don't see why you should either.'",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "'Frankly, my dear, I don't give a damn, and I don't see why you should either.'"
    },
    {
        "command": "subtitle",
        "params": {
            "text": "'Or, as Greta said, you can leave the truth to whoever feels like playing detective.'",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "'Or, as Greta said, you can leave the truth to whoever feels like playing detective.'"
    },
    {
        "command": "subtitle",
        "params": {
            "text": "The truth?",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "The truth?"
    },
    {
        "command": "subtitle",
        "params": {
            "text": "The cast and crew both mercilessly bully newcomers. The producer even massaged a tragic and fatal fall into a scene that straddles the line between truth and lie.",
            "x": 300,
            "y": 350,
            "alignment": "center",
            "size": 24,
            "delay": 0.04,
            "width": 700
        },
        "text": "The cast and crew both mercilessly bully newcomers. The producer even massaged a tragic and fatal fall into a scene that straddles the line between truth and lie."
