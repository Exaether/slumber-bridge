        "volume": 0.6
    },
    {
        "tag": "sticker",
        "id": "st1",
        "multi": true,
        "text": "Announcement:",
        "x": 220,
        "y": 270,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 800,
        "block": true
    },
    {
        "tag": "sticker",
        "id": "st1",
        "multi": true,
        "text": "\\n\\nVictoria's famous Crimson Troupe is here in Daremont for three days! Don't miss it!",
        "block": true
    },
    {
        "tag": "sticker",
        "id": "st1",
        "multi": true,
        "text": "\\n\\nTickets are first-come, first-served!",
        "block": true
    },
    {
        "tag": "sticker",
        "id": "st1",
        "duration": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
