        "block": false
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1838_1#3$1"
    },
    {
        "text": "Aaaahhhhhh\u2014!!",
        "tag": "name",
        "value": "Michael"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1839_1#3$1"
    },
    {
        "text": "Michael?",
        "tag": "name",
        "value": "Marion"
    },
    {
        "text": "What's going on? What were you thinking about?",
        "tag": "name",
        "value": "Marion"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1839_1#6$1"
    },
    {
        "text": "I came with you to the makeup room for an explanation, not to watch you melt down.",
        "tag": "name",
        "value": "Marion"
    },
    {
        "text": "What did Moira mean when she said you wanted to leave the plate?",
        "tag": "name",
        "value": "Marion"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1838_1#4$1"
    },
    {
        "text": "We have to get out of here, babe!",
        "tag": "name",
        "value": "Michael"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
