    {
        "text": "It is late at night. Muffled sounds and suppressed screams can be heard from the prop room, which should be empty at this hour."
    },
    {
        "text": "In a dark corner, the faceless faces of mannequins are illuminated by flashing lights."
    },
    {
        "text": "Tippi cowers into a sofa, hugging a cushion tightly. The knife-wielding killer laughs maniacally, whose blade reflecting the bright white lights. In the very next instant\u2014"
    },
    {
        "tag": "bgeffect"
    },
    {
        "tag": "stopsound",
        "channel": "c",
        "fadetime": 0
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4191_tippi_1#8$1"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_orangefall"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "EEK\u2014",
        "tag": "name",
        "value": "Tippi"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_clothmovement",
        "volume": 0.5
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1836_1#3$1"
    },
    {
        "tag": "camerashake",
