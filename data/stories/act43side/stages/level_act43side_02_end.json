        "block": false
    },
    {
        "text": "EEK\u2014",
        "tag": "name",
        "value": "Shelly"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1831_1#1$1"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Moira"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
