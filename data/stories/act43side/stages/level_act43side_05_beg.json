            "key": "$d_avg_clothmovement",
            "volume": 0.6
        }
    },
    {
        "text": "The Liberi gives a gentle hug to her most precious friend in the whole crew."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "left",
            "name": "avg_4191_tippi_1#1$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Tippi",
        "text": "Once this is all over, we're totally gonna have a movie marathon at your place. Twenty-four hours of non-stop screams, paired with our favorite drinks and fried finballs."
    },
    {
        "command": "name",
        "value": "Tippi",
        "text": "I wanna see what the house you grew up in looks like, and meet that sister you're always bragging about."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "right",
            "name": "avg_npc_1831_1#9$1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Moira",
        "text": "...Sure."
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot"
    },
    {
        "command": "delay",
        "value": 0.5
    },
    {
