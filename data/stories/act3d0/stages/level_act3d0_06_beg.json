    {
        "command": "name",
        "value": "Cronin",
        "text": "It's about time. As long as Schwarz and Rhodes Island can fight each other to a standstill, things will go smoothly here."
    },
    {
        "command": "name",
        "value": "Cronin",
        "text": "I knew pitting them against each other would be a masterful move. Heh."
    },
    {
        "command": "name",
        "value": "Cronin",
        "text": "Hurry up! Move these things out of here! Pick up the pace, or you won't be seeing your paychecks!"
    },
    {
        "command": "name",
        "value": "Cronin",
        "text": "Hmm? What's that sound coming from outside?"
    },
    {
        "command": "dialog"
    },
