    {
        "tag": "background",
        "image": "bg_hotel",
        "screenadapt": "coverall",
        "fadetime": 2
    },
    {
        "tag": "playsound",
        "key": "$phonevibration",
        "volume": 0.6
    },
    {
        "tag": "character",
        "name": "avg_NPC_017_3#2"
    },
    {
        "text": "Hmm? A message... Good thing Siesta really is a city built for tourists - the network sure is fast here.",
        "tag": "name",
        "value": "D.D.D."
    },
    {
        "text": "Hmm, who's on this channel?",
        "tag": "name",
        "value": "D.D.D."
    },
    {
        "tag": "background",
        "fadetime": 2
    },
    {
        "tag": "playmusic",
        "intro": "$fesready_intro",
        "key": "$fesready_loop",
        "volume": 0.8,
        "crossfade": 1.5
    },
    {
        "text": "'From Ada.Closure.Church.' ...Wait, it's Closure?",
        "tag": "name",
        "value": "D.D.D."
    },
    {
        "tag": "character",
        "name": "avg_NPC_017_3#2",
        "focus": -1
    },
    {
        "text": "'I heard the festival was a great success. Congrats :P'",
        "tag": "name",
        "value": "D.D.D."
    },
    {
        "tag": "character"
    },
    {
        "tag": "image",
        "image": "ac3_title1",
        "fadetime": 3,
        "block": true
    },
    {
        "text": "'Long time no see, Grace. Are you still in touch with Dijkstra? Let's find a chance to get him and do something great together next time!'"
    },
    {
        "text": "'Oh right, make sure to take care of yourself :3'"
    },
    {
        "text": "God...",
        "tag": "name",
        "value": "D.D.D."
    },
    {
        "text": "I knew today was gonna be awesome!",
        "tag": "name",
        "value": "D.D.D."
    },
