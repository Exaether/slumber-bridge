    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Is, is that so? Miss Savage picked it out for me... I was so worried that you wouldn't like it--"
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_summer_2#1"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "W-wait! Don't you try to play that trick on me, Dr. {@nickname}!"
    },
    {
        "command": "decision",
        "params": {
            "options": "We did go a bit overboard this time...",
            "values": "1"
