    {
        "command": "character",
        "params": {
            "name": "char_348_ceylon_4#8",
            "name2": "char_340_shwaz_2#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Schwarz",
        "text": "...It doesn't hurt, but, I will die because of it."
    },
    {
        "command": "name",
        "value": "Schwarz",
        "text": "There is no cure for this disease, milady."
    },
    {
        "command": "name",
        "value": "Schwarz",
