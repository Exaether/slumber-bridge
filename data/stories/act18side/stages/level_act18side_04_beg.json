    },
    {
        "text": "Hibiscus?",
        "tag": "name",
        "value": "Kreide"
    },
    {
        "tag": "character",
        "name": "avg_npc_482_1#6$1"
    },
    {
        "text": "Good morning... You're up early today. It's barely light out\u2013\u2013",
        "tag": "name",
        "value": "Kreide"
    },
    {
        "tag": "character",
        "name": "avg_1024_hbisc2_1#5$1"
    },
    {
        "text": "Where's Ebenholz?",
        "tag": "name",
        "value": "Hibiscus"
    },
    {
        "tag": "character",
        "name": "avg_npc_482_1#6$1"
    },
    {
        "text": "Hm? He's still asleep.",
        "tag": "name",
        "value": "Kreide"
    },
    {
        "tag": "character",
        "name": "avg_npc_482_1#12$1"
    },
    {
        "text": "Your eyes are all bloodshot... Did you stay up all night?",
        "tag": "name",
        "value": "Kreide"
    },
    {
        "tag": "character",
        "name": "avg_1024_hbisc2_1#5$1"
    },
    {
        "text": "\u2013\u2013Wake him too. Hurry.",
        "tag": "name",
        "value": "Hibiscus"
    },
    {
