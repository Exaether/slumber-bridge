        "name": "avg_npc_484_1#4$1",
        "name2": "avg_4046_ebnhlz_1#10$2",
        "focus": 1
    },
    {
        "text": "Your footsteps sound rather unsteady. Are you getting a headache?",
        "tag": "name",
        "value": "Gertrude"
    },
    {
        "tag": "character",
        "name": "avg_npc_484_1#4$1",
        "name2": "avg_4046_ebnhlz_1#10$2",
        "focus": 2
    },
    {
        "text": "I already told you...",
        "tag": "name",
        "value": "Ebenholz"
    },
    {
        "tag": "character",
        "name": "avg_npc_484_1#4$1",
        "name2": "avg_4046_ebnhlz_1#8$2",
        "focus": 2
    },
    {
        "text": "It's none of your business!",
        "tag": "name",
        "value": "Ebenholz"
