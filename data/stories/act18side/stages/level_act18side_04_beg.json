    },
    {
        "text": "Judging by the markers, one of you is a completely healthy man, and the other is in the stable phase of Oripathy...",
        "tag": "name",
        "value": "Hibiscus"
    },
    {
        "tag": "character",
        "name": "avg_1024_hbisc2_1#7$1"
    },
    {
        "text": "How could this be...?",
        "tag": "name",
        "value": "Hibiscus"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "avg_1024_hbisc2_1#7$1",
