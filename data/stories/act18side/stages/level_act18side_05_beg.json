    {
        "tag": "character",
        "name": "avg_npc_488_1$1",
        "name2": "avg_npc_492_1$1",
        "focus": 1
    },
    {
        "text": "This is the best opportunity we're going to get.",
        "tag": "name",
        "value": "Suspicious Infected"
    },
    {
        "text": "The longer things drag on, the less time we'll have. It'll only make things harder.",
        "tag": "name",
        "value": "Suspicious Infected"
    },
    {
        "tag": "character",
        "name": "avg_npc_488_1$1",
        "name2": "avg_npc_492_1$1",
        "focus": 2
    },
    {
        "text": "Alright, hurry it up then. I'll go report to the higher-ups. I'm counting on you, Herr Lachmann.",
        "tag": "name",
        "value": "Frivolous Noble"
    },
