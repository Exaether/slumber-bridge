    {
        "text": "We're almost there, Kreide.",
        "tag": "name",
        "value": "Ebenholz"
    },
    {
        "text": "Just a little longer.",
        "tag": "name",
        "value": "Ebenholz"
    },
    {
        "tag": "character",
        "name": "avg_4046_ebnhlz_1#6$2",
        "focus": -1
    },
    {
        "text": "Thank you.",
        "tag": "name",
        "value": "Kreide?"
    },
    {
        "tag": "dialog"
    },
