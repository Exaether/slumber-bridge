    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "Ebenholz no longer hears the voice."
    },
    {
        "text": "He walks toward the lounge in Afterglow Hall, Kreide's body growing heavier in his arms with each step."
    },
