    {
        "text": "*cough* \u2013\u2013 *cough* *cough* *cough*!!",
        "tag": "name",
        "value": "Czerny"
    },
    {
        "tag": "character",
        "name": "avg_4047_pianst_1#5$1",
        "name2": "avg_1024_hbisc2_1#4$1",
        "focus": 2
    },
    {
        "text": "Mr. Czerny, here, water!",
        "tag": "name",
        "value": "Hibiscus"
    },
    {
        "tag": "dialog"
    },
