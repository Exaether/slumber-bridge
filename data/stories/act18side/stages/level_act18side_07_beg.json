    },
    {
        "tag": "character",
        "name": "avg_4047_pianst_1#3$1",
        "name2": "avg_1024_hbisc2_1#4$1",
        "focus": 1
    },
    {
        "tag": "delay",
        "time": 0.51
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
