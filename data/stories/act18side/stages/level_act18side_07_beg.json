    {
        "tag": "character",
        "name": "avg_npc_489_1#3$1"
    },
    {
        "text": "Mein Herr?!",
        "tag": "name",
        "value": "Ursula"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "musicvolume",
        "volume": 0,
