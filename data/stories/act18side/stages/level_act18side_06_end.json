    },
    {
        "tag": "character",
        "name": "char_empty",
        "name2": "avg_4046_ebnhlz_1#4$1",
        "focus": 2
    },
    {
        "text": "Kreide?!",
        "tag": "name",
        "value": "Ebenholz"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
