        "name2": "avg_npc_490_1#1$1",
        "focus": 1
    },
    {
        "text": "I'm sorry!",
        "tag": "name",
        "value": "Hibiscus"
    },
    {
        "tag": "character",
        "name": "avg_1024_hbisc2_1#4$1",
        "name2": "avg_npc_490_1#1$1",
        "focus": 2
    },
    {
        "text": "That's alright, I should be the one apologizing. I was so preoccupied, admiring this magnificent building, I got in the way of your motif.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
