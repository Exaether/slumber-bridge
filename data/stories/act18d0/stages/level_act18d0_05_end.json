        "value": "Elliot",
        "text": "......"
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn07_1#3",
            "name2": "avg_npc_173",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Are you okay...?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_173"
        }
    },
    {
        "command": "camerashake",
        "params": {
            "duration": 0.5,
            "xstrength": 15,
            "ystrength": 15,
            "vibration": 20,
            "randomness": 70,
            "fadeout": true,
            "block": false
        }
    },
    {
        "command": "name",
        "value": "Mysterious Fortune Teller",
        "text": "Agh... It hurts... Please, don't worry. Old Isin's gotten used to it long ago..."
    },
    {
        "command": "name",
        "value": "Mysterious Fortune Teller",
        "text": "Old Isin cannot save them. Old Isin cannot get them to come around... Old Isin can do nothing but watch as they draw ever closer to their destruction day after day."
    },
    {
        "command": "name",
        "value": "Mysterious Fortune Teller",
        "text": "Please accept Old Isin's apologies, but as you can see, Old Isin is being thrown out of this place. If there is anywhere willing to take in poor Old Isin, that's where Old Isin will go."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn07_1",
            "name2": "avg_npc_173",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "(Sargonian) Wait."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn07_1",
            "name2": "avg_npc_173",
            "focus": 2
        }
    },
    {
        "command": "camerashake",
        "params": {
            "duration": 0.5,
            "xstrength": 15,
            "ystrength": 15,
            "vibration": 20,
            "randomness": 70,
            "fadeout": true,
            "block": false
        }
    },
    {
        "command": "name",
        "value": "Mysterious Fortune Teller",
        "text": "(Sargonian) Old Isin mustn't... Old Isin mustn't..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_073",
            "name2": "char_003_kaltsn07_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Sargon Villager",
        "text": "(Sargonian) Stay out of this. If he doesn't leave, it's gonna be on our heads. Just let him go!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn07_1",
            "name2": "avg_npc_173",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Mysterious Fortune Teller",
        "text": "(Sargonian) She's right. Her master calls the shots here, and she mustn't be trifled with. Let Old Isin leave, kind traveler. Let Old Isin return to his ice-cold home."
    },
    {
        "command": "playsound",
        "params": {
