    },
    {
        "command": "name",
        "value": "Elliot",
        "text": "Why are we wasting our time here on this old conman again?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn07_1#2",
            "name2": "avg_npc_171_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "At least you can tell he's old."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn07_1#2",
            "name2": "avg_npc_171_1#4",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Elliot",
        "text": "What do you mean...?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn07_1",
            "name2": "avg_npc_171_1#4",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "But you can't imagine how old he is."
    },
