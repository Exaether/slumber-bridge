            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "The nearest town to where we are heading. More accurately, it's a settlement formed of several towns that had been drifting in the desert with their hauling equipment."
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "At the same time, this place covers a large swath of Sargon's no man's land, more than anywhere else. This is the way out for illegal immigrants, bounty hunters, and Messengers."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
