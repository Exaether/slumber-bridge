    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "name",
        "value": "Elliot",
        "text": "I'm the new craftsman apprentice. My name's El\u2014"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Black Market Merchant",
        "text": "Alright, enough talk. Get moving!"
    },
    {
        "command": "name",
        "value": "Black Market Merchant",
        "text": "Hey, you lot! Use him however you want. He's apparently one of those bookworm types from Columbia, even younger than your kids!"
    },
    {
        "command": "name",
        "value": "Black Market Merchant",
        "text": "Just treat him like those slaves that got sold to us. As long as it doesn't kill him, that is. It's not like he's got a guardian angel watching his back."
    },
    {
        "command": "name",
        "value": "Black Market Merchant",
        "text": "We'll work you to bone, kid."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_171_1"
        }
    },
    {
        "command": "name",
        "value": "Elliot",
        "text": "Alright..."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
