    {
        "command": "name",
        "value": "Black Market Merchant",
        "text": "Hey, come check this out. We got ourselves a new lackey! You, stop lazing around. Go!"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character",
        "params": {
