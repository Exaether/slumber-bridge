    {
        "command": "name",
        "value": "Lillia",
        "text": "Excuse me, we're currently making rounds... It seems you weren't on the list of scheduled visitors. Can I ask who you are?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_076"
        }
    },
    {
        "command": "name",
        "value": "???",
        "text": "Just an Ursus citizen here on a whim, looking to meet an old friend. Do carry on, madam."
    },
    {
        "command": "name",
        "value": "???",
        "text": "I hope I don't bother any of you in your work."
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Veteran-Like Person",
        "text": "Witte, are you off?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_076"
        }
    },
    {
        "command": "name",
        "value": "???",
        "text": "No, old friend, I'll see you again in a bit. You should be more mindful of your health, with winter here. Don't set off that asthma of yours."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_168_1",
            "name2": "avg_npc_076",
            "focus": 2
        }
    },
    {
        "command": "name",
