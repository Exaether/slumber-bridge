            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Lillia",
        "text": "Kal'tsit."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn09_1",
            "name2": "avg_npc_168_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Doctor."
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Elderly Caretaker",
        "text": "Oh, oh, so you know each other... then I'll get out of your way. Definitely not break time, after all. Take care, and don't let the head caretaker see you."
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_gen_walk_n",
            "volume": 0.6
        }
    },
    {
        "command": "dialog"
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn09_1"
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "......"
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn09_1",
            "name2": "avg_npc_168_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Lillia",
        "text": "She cares a lot about us newcomers. She's a good one."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn09_1",
            "name2": "avg_npc_168_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "You're right, Dr. Louisa. We cannot let her down."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn09_1",
            "name2": "avg_npc_168_1#6",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Lillia",
        "text": "Will you still be busy with work in a bit? There's some things I'd like to tell you."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn09_1",
            "name2": "avg_npc_168_1#6",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Apologies, doctor... I still need to brew a new cup of coffee. If that count's pet doesn't continue to pick bones with me, I'll find you right after."
    },
    {
        "command": "character",
        "params": {
            "name": "char_003_kaltsn09_1",
            "name2": "avg_npc_168_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Lillia",
        "text": "Alright, then... remember to be careful, Kal'tsit."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
