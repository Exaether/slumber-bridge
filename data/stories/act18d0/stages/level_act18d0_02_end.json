    {
        "command": "character",
        "params": {
            "name": "avg_npc_082"
        }
    },
    {
        "command": "name",
        "value": "Ursus Officer",
        "text": "What's wrong with you! In the presence of the Minister\u2014"
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Veteran-Like Person",
        "text": "Oh, nothing, just some alcohol spilled on the bedsheets."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_168_1#6",
            "name2": "avg_npc_076",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "???",
        "text": "Calm down. Madam, what happened?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_168_1#6",
            "name2": "avg_npc_076",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Lillia",
        "text": "I'm sorry, the cap on the isopropyl bottle was too tight, and I applied too much force..."
