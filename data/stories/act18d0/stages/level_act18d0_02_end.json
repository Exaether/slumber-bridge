    {
        "command": "name",
        "value": "Elderly Caretaker",
        "text": "Oh, doctor, here you are! Perfect, if you were any later, the head caretaker would've gone ballistic."
    },
    {
        "command": "name",
        "value": "Elderly Caretaker",
        "text": "Hm? Doctor, what's got your eyes all red? Did something happen?"
