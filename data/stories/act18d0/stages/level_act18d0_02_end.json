    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Elderly Caretaker",
        "text": "It's time to make rounds."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_168_1"
        }
    },
    {
        "command": "name",
        "value": "Lillia",
        "text": "I wasn't even paying attention... right, I understand."
    },
    {
        "command": "name",
        "value": "Lillia",
        "text": "Is there some kind of commotion over there?"
    },
    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Elderly Caretaker",
        "text": "Yes, seems an old nobleman's come from far off. Don't know for what."
    },
    {
        "command": "name",
        "value": "Elderly Caretaker",
        "text": "As long as the days go by smooth, that's what matters."
    },
