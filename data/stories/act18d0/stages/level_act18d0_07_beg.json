    {
        "text": "You're the leader of those squads... I remember you.",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "text": "How did you find us, Columbian?",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "tag": "character",
        "name": "char_003_kaltsn07_1"
    },
    {
        "text": "Sarkaz... I'm not from Columbia.",
        "tag": "name",
        "value": "Kal'tsit"
    },
    {
