        "randomness": 70,
        "fadeout": true,
        "block": false
    },
    {
        "text": "What's that behind the smoke...? Is that the monster?",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "text": "Not even a scratch...?",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 15,
        "ystrength": 15,
        "vibrato": 20,
        "randomness": 70,
        "fadeout": true,
        "block": false
    },
    {
        "text": "You, 'Kazdel' Caster. What are you?",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
