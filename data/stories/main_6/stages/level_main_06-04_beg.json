    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_015_lmg"
    },
    {
        "text": "We're being overrun!",
        "tag": "name",
        "value": "L. G. D. Officer"
    },
    {
        "text": "We're dead if we don't retreat!",
        "tag": "name",
        "value": "L. G. D. Officer"
    },
    {
        "tag": "character"
    },
    {
        "text": "Don't panic.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_015_lmg"
    },
    {
        "text": "Huh?! Who's...?",
        "tag": "name",
        "value": "L. G. D. Officer"
    },
    {
        "text": "That uniform... You're...",
        "tag": "name",
        "value": "L. G. D. Officer"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n"
    },
    {
        "tag": "character",
        "name": "avg_npc_041",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "The cavalry is here. Stand firm.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Form two teams and move on their flanks.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_015_lmg"
    },
    {
        "text": "But, Master...",
        "tag": "name",
        "value": "L. G. D. Officer"
    },
    {
        "tag": "character",
        "name": "avg_npc_041"
    },
    {
        "text": "Trust me. While I cannot take action myself, this method will succeed.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Execute a pincer attack, hold the enemy in place, and leave the stragglers to your reinforcements.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "background",
        "screenadapt": "coverall",
        "image": "bg_indoor_n"
    },
    {
        "tag": "blocker",
        "a": 0,
