        "command": "character",
        "params": {
            "name": "char_015_lmg",
            "name2": "avg_npc_039_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "L. G. D. Captain",
        "text": "...We never thought..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_015_lmg",
            "name2": "avg_npc_039_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Censor",
        "text": "I found your spirit laudable. How disappointing it was to see you hopping about aimlessly, leaving me to do your work. Honestly, what were you doing?"
    },
    {
        "command": "name",
        "value": "Censor",
        "text": "Now! To your place!"
