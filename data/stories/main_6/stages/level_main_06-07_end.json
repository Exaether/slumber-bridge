    {
        "tag": "character",
        "name": "char_1505_frstar_1"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "FrostNova"
    },
    {
        "text": "Why are you running away?",
        "tag": "name",
        "value": "FrostNova"
    },
