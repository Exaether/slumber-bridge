        "text": "Put me down!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#9",
            "name2": "char_002_amiya_1#7",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Amiya, go. I'll get the Doctor! I'm an elite operator, I can do it!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#9",
            "name2": "char_002_amiya_1#7",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "......"
    },
    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#9",
            "name2": "char_002_amiya_1#7",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Welp, looks like we're not quite done."
    },
    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#6"
        }
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Doctor, I'm going to use airflow and pressure to slow your fall and push away the building beside you. Don't worry, it won't crush you!"
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Just don't panic! I've got you!"
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "...See you soon!"
    },
    {
        "command": "dialog"
    },
