[
    {
        "text": "\u7b2c\u4e00\u5173\uff08\u540e\uff09",
        "tag": "header",
        "key": "title_test",
        "is_skippable": true,
        "fit_mode": "BLACK_MASK"
    },
    {
        "tag": "dialog"
