    {
        "command": "name",
        "value": "Swire",
        "text": "L. G. D. defender squad, shields up! Play it just like we have a million times before. And never forget, your brothers and sisters are right behind you! Stand firm!"
    },
    {
        "command": "character",
        "params": {
