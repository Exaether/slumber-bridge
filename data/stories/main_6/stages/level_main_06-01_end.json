        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "Hold!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_308_swire_1#6"
        }
    },
    {
        "command": "name",
        "value": "Swire",
        "text": "Crossbows, nock!"
    },
