            "fadetime": 2,
            "block": true
        }
    },
    {
        "command": "delay",
        "value": 2
    },
    {
        "command": "name",
        "value": "Talulah",
        "text": "I'm a rebel, an ordinary woman. I'm nobody. But for now, you can call me Talulah"
    },
    {
        "command": "dialog"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 2,
            "block": true
        }
    },
    {
        "command": "character"
    },
    {
        "text": "And Talulah didn't say much to me."
    },
    {
        "text": "She held me tight and rapped three times on my back."
    },
    {
        "text": "Talulah trusted me. Yelena, Buldrokkas'tee, Lyudmila. They all believed in me."
    },
    {
        "text": "I thought I could put the childhood I spent in that city behind me."
    },
    {
        "text": "Only, things changed quickly. It started with what happened in that village."
    },
    {
        "text": "It was a tragedy. But why did that tragedy make her this way?"
    },
    {
        "text": "Why did things turn out like this?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "background",
        "params": {
            "image": "bg_windows",
            "width": 1,
            "height": 1,
            "screenadapt": "coverall"
        }
