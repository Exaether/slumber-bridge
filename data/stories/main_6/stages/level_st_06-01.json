[
    {
        "text": "\u7b2c\u516d\u5173\uff08\u540e\uff09",
        "tag": "header",
        "key": "title_test",
        "is_skippable": true,
        "fit_mode": "BLACK_MASK"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "cameraeffect",
        "effect": "Grayscale",
        "fadetime": 0,
        "keep": true,
        "initamount": 0,
        "amount": 1
    },
    {
        "tag": "background",
        "image": "bg_cherbefore_1",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall",
        "fadetime": 1
    },
    {
        "tag": "playmusic",
        "intro": "$newhope01_loop",
        "key": "$newhope01_loop",
        "volume": 0.8,
        "crossfade": 1.5,
        "delay": 0.5
    },
    {
        "text": "Eno, what's this book about?",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Ah, I read it. So I brought it for you.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I think you'll like it, Sasha! It's a book about ideals.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Ideals?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Yes.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "What are your ideals, Eno?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "...Ideals, huh.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I don't know. Can I have ideals?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Of course you can! Why couldn't you?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Ah, crap, it's time to go home...",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "You don't want to go?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "...I don't want to go home.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "But Eno, you said that if you didn't go home, your father would beat you...",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "But I'll see you tomorrow, right? I can still see you tomorrow.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "I know. I'll put the book and some bread in here.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "...Sasha, I don't want to go. It's terrible. I'll get beaten even if I go back now.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "So come out tomorrow. If you get hit, you can hit me.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Huh...? Hahaha, Sasha, did you get in another fight? Did they knock your head around?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "You have bruises, so many wounds.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "This way, people know you're hurting. At least someone will know.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Well, I know what you're thinking. But I won't.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "If those kids are still picking on you, let me know! I'll take them all down!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "I know!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "See you tomorrow! I'll come and sing to you again!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "I don't even know what happened to him."
    },
    {
        "text": "All I know is that he gave me food."
    },
    {
        "text": "I only know that he could read, and I wanted to read, and he taught me."
    },
    {
        "text": "I only know that the other kids liked to bully him because he gave me bread and I was stronger, and I hit them and they hit me."
    },
    {
        "text": "But I don't know what happened to him."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "cameraeffect",
        "effect": "Grayscale",
        "fadetime": 0,
        "keep": true,
        "initamount": 0,
        "amount": 1
    },
    {
        "tag": "background",
        "image": "bg_indoor_u",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "I'm scared. Sasha, I'm really scared.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I think.... I don't belong in that home. I overheard that my mom.... My mom isn't even in the house.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "The way they look at me, they're all terrifying, and I don't want to go back. I don't want to go back....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "But there's no food, or anywhere to stay here, it's just.... Just sewers.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "I don't care.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "But....",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Do you hate me too?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "What...? Why?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Because I like to laugh?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "No.... No. Why would I?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Because I shouldn't laugh.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Nonsense! Eno, you should keep laughing.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Really?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Really.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Would things be different if he didn't go back that day?"
    },
    {
        "text": "Just because I thought my place was too cold and dirty, I sent him home?"
    },
    {
        "text": "If he hadn't gone back, would it have changed everything?"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "cameraeffect",
        "effect": "Grayscale",
        "fadetime": 0,
        "keep": true,
        "initamount": 0,
        "amount": 1
    },
    {
        "tag": "background",
        "image": "bg_indoor_u",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "You're hurt! The wound on your stomach.... What happened, what happened?!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Sasha.... I've been laughing.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "You see, you told me I could laugh, so I kept laughing.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I never stopped laughing....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Sasha, do you still want to hear me sing?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "After that, he visited me from time to time."
    },
    {
        "text": "And each time he had more and more scars...."
    },
    {
        "text": "So many more."
    },
    {
        "text": "I realized how much the things I said influenced him. So I started talking less."
    },
    {
        "text": "Would that make things better?"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "cameraeffect",
        "effect": "Grayscale",
        "fadetime": 0,
        "keep": true,
        "initamount": 0,
        "amount": 1
    },
    {
        "tag": "background",
        "image": "bg_cherbefore_1",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Your back!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Your back....",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "......Does it hurt?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "This can't keep happening.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Who the hell did this?! Why are they doing this to you?!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Whoever it is.... they need to be punished! Whatever it is, it needs to be destroyed!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Eno, take me with you!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "...All right.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Huh?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "I will.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "I didn't know what I'd said."
    },
    {
        "text": "I didn't know if I could say anything anymore."
    },
    {
        "text": "What did I do? What the hell did I do?"
    },
    {
        "text": "I've read a lot of books too, but no book ever told me."
    },
    {
        "text": "Nothing ever told me."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "background"
    },
    {
        "tag": "background",
        "image": "bg_cherbefore_1",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Look. Look at it, Sasha...",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "You told me you wanted to destroy everything that hurt me, didn't you?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Come on.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Your wounds...",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "They're not important. It doesn't matter.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "You see, with one little breath.... It's all better. It's all fine.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Come on, I'll bandage you up! There must be some cloth around here...!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "That man cut my leg.... Then with one breath, it's better.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "An old man slashed my back. One light touch, and it was fine.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "And it's all thanks to that Originium rock that fat woman shoved down my throat!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "That's enough, Eno. Really...",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "I can't sing anymore, but you see, it's all from the Originium!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "There's nothing I can't do!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Eno!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "...You're unhappy. Why? I only did what you told me.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Why are you unhappy?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Obviously they're all happy. Just do what they say and they'll all be happy....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "...Because all of your family are assholes. All of them.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Yes!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "So the kids killed them.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "...What?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "The Infected kids who hadn't been driven out of town....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "What did you do to them?",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "They hit me, too. They hurt you too.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Now, they are like pieces on a chess board. My literal pawns.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "As soon as I healed their wounds, they obeyed my every command.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I'll take that bunch of ugly, disgusting people, all of them.... All of them!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "You see, Sasha? You see what I've done?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "We'll burn it down in one magnificent blaze! All of it!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Sasha, what's wrong with you?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Don't do anything like that ever again.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "But I thought you said....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I didn't think it would turn out this way.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Eno, do what you really want to do. Not this.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "I can help you. You don't have to do this.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "But I....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "That's enough! Just do what you truly want, Eno!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Not what you're forced to do. Not the bloodshed, not the heartbreak, not the revenge!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "You don't even like this kind of thing...!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "...Sasha...",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "I want to.... Sing....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "Ugh....",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "I couldn't do anything."
    },
    {
        "text": "I was useless."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "background"
    },
    {
        "tag": "background",
        "image": "bg_indoor_u",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Eno....",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "I can't sing anymore.",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "We'll go together. We'll survive.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Survive?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "What's so great about that?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Nothing.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "But we can do it together.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "What are you going to do?",
        "tag": "name",
        "value": "Eno"
    },
    {
        "text": "This is the Originium I stole from the mine, I was going to sell it for some food.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Sasha!",
        "tag": "name",
        "value": "Eno"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 15,
        "ystrength": 10,
        "vibrato": 30,
        "randomness": 30,
        "fadeout": false
    },
    {
        "text": "Mmm!",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "This way, we're both infected.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "text": "Let's survive together.",
        "tag": "name",
        "value": "Sasha"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "background"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "Such things? I'm not interested.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "There is no reason for anything you do. There is no meaning to your life on this planet.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "No, you don't need anyone to save you...",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Pick a name you like.",
        "tag": "name",
        "value": "????"
    },
    {
        "text": "This one? Good.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Mephisto...",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Mephisto. From now on, you are Mephisto. You are no longer what you were.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "I don't trust you. I have no right to trust you. The only person you can trust is yourself.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "What you did cannot be written off. You will always carry your past, even if you forget, even if you cannot understand what you did.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Everything you do, everything you go through, will become your kindling. They compel you, to keep the fire burning within you....",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Until the whole earth is free, until you throw away all that others have given you, until you finally understand yourself.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "At that point, you can even discard the name. It's your choice whether you stay or go, live or die.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Mephisto, I can't change your ideals. If you don't have it, go find it. We'll help ourselves.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Who am I? That's not important.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "What should you call me?",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "......Talulah",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "I'm a rebel, an ordinary woman. I'm nobody. But for now, you can call me Talulah",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "character"
    },
    {
        "text": "And Talulah didn't say much to me."
    },
    {
        "text": "She held me tight and rapped three times on my back."
    },
    {
        "text": "Talulah trusted me. Yelena, Buldrokkas'tee, Lyudmila. They all believed in me."
    },
    {
        "text": "I thought I could put the childhood I spent in that city behind me."
    },
    {
        "text": "Only, things changed quickly. It started with what happened in that village."
    },
    {
        "text": "It was a tragedy. But why did that tragedy make her this way?"
    },
    {
        "text": "Why did things turn out like this?"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "background",
        "image": "bg_windows",
        "width": 1,
        "height": 1,
        "screenadapt": "coverall"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1"
    },
    {
        "text": "I'll do whatever you want me to do....",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_011_talula_1",
        "focus": 2
    },
    {
        "text": "No need. Do as you please.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "I allow it. You are Mephisto, after all.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_011_talula_1",
        "focus": 1
    },
    {
        "text": "But, you said before....",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_011_talula_1",
        "focus": 2
    },
    {
        "text": "That was years ago.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "It's only natural that some things change over the course of a career.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "If we don't keep up with the times, we're doomed.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "So we, and our fellow Infected, must fight for our collective future.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "Anyone can be sacrificed for that ideal.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_011_talula_1",
        "focus": 1
    },
    {
        "text": "I can trust you, can't I?",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_011_talula_1",
        "focus": 2
    },
    {
        "text": "Yes. Because I am Talulah.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_011_talula_1",
        "focus": 1
    },
    {
        "text": "Then I will!",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_011_talula_1",
        "focus": 2
    },
    {
        "text": "You will, I'm sure you will.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "We can't do it without you. You can do anything, and you can accomplish anything.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_011_talula_1"
    },
    {
        "text": "Come in.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "character",
        "name": "char_1508_Faust_1#1",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "You should have seen it all.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "Who are you?",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "I am Talulah, of course.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "The Talulah I knew... is not you.",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "Talulah is just a name. Talulah is just Talulah",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "text": "Help him. Mephisto needs your help. Mephisto needs you to give him value. He trusts only you and me.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "Talulah would never do that. You're taking advantage of his trust in you!",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "None of us have the power to choose.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_011_talula_1",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "You'll do it for him. Everything.",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "background"
    },
    {
        "text": "Or would you rather watch him die?",
        "tag": "name",
        "value": "Talulah"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "Don't you realize what happened? After passing through that village, Talulah changed completely! She's not the same person!",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "I know.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "Then why are you doing this?",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "I don't trust anyone but you and her.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "text": "And I don't want to choose.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "........",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "Faust, where are we going?",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "........I........",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "Faust, tell me. What should we do?",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "......We survive.",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_1508_Faust_1#1",
        "focus": 1
    },
    {
        "text": "Isn't it painful to be alive?",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_1508_Faust_1#1",
        "focus": 2
    },
    {
        "text": "It's painful.",
        "tag": "name",
        "value": "Faust"
    },
    {
        "text": "But we can do it together.",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
