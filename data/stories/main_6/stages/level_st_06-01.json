    {
        "command": "character",
        "params": {
            "name": "char_1507_Mephisto_1#1",
            "name2": "char_1508_Faust_1#1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Faust",
        "text": "Then why are you doing this?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_1507_Mephisto_1#1",
            "name2": "char_1508_Faust_1#1",
            "focus": 1
