        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
        "text": "This book, it's a book about ideals."
    },
    {
        "text": "My ideals are...."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "fadetime": 2,
        "block": true
