    {
        "command": "character",
        "params": {
            "name": "avg_npc_039_1",
            "name2": "avg_npc_041",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Censor",
        "text": "You speak of Wei Yenwu's history?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_040"
        }
    },
    {
        "command": "name",
        "value": "Taihe",
        "text": "Delve not into such things."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_039_1",
            "name2": "avg_npc_041",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "???",
        "text": "Forgive me. But how do the skills of the Black Cloaks compare to those of the Imperial Guard?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_039_1",
            "name2": "avg_npc_041",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Censor",
        "text": "Hmph. You overestimate them. But they do indeed have some exceptional skill..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_040"
        }
    },
    {
        "command": "name",
        "value": "Taihe",
        "text": "Look out!"
    },
    {
        "command": "character"
    },
    {
        "command": "name",
