    {
        "command": "character",
        "params": {
            "name": "avg_npc_037",
            "name2": "avg_npc_037",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Yeti Squad Member A",
        "text": "He says okay!"
    },
    {
        "command": "name",
        "value": "Yeti Squad Member A",
        "text": "I don't think Sister's body can take much more. She can't keep the temperature down!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_037"
        }
    },
    {
        "command": "name",
        "value": "Yeti Squad Member B",
        "text": "We can't break the pavement?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_037",
            "name2": "avg_npc_037",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Yeti Squad Member C",
        "text": "No way! If we do that, how will our people and the locals get to the exit?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_037",
            "name2": "avg_npc_037",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Yeti Squad Member B",
        "text": "We're sure this is the only way out?"
