            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "GreyThroat",
        "text": "What about... the Reunion men? And the children?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_367_swllow_1",
            "name2": "char_017_homura_3#5",
