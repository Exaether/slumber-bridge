        }
    },
    {
        "command": "name",
        "value": "Reunion Member",
        "text": "You're..."
    },
    {
        "command": "name",
        "value": "Reunion Member",
        "text": "You're not with them."
    },
    {
        "command": "name",
        "value": "Reunion Member",
        "text": "You're... from Rhodes Island?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_367_swllow_1#4"
        }
    },
    {
        "command": "name",
        "value": "GreyThroat",
        "text": "Child, stay back. Don't come closer."
    },
    {
        "command": "name",
        "value": "GreyThroat",
        "text": "Drop your weapon and come out with your hands up."
    },
    {
        "command": "character",
        "params": {
            "name": "char_367_swllow_1#4",
            "name2": "char_1002_nsabr_1",
