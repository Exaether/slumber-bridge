[
    {
        "text": "\u7b2c\u56db\u5173\uff08\u524d\uff09",
        "tag": "header",
        "key": "title_test",
        "is_skippable": true,
        "fit_mode": "BLACK_MASK"
    },
    {
        "tag": "background",
        "screenadapt": "coverall",
