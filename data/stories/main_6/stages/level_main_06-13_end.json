    {
        "command": "name",
        "value": "FrostNova",
        "text": "Warriors willing to sacrifice themselves are the strongest, in my eyes."
    },
    {
        "command": "character",
        "params": {
            "name": "char_193_frostl_1",
            "name2": "char_1505_frstar_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Frostleaf",
        "text": "......"
    },
    {
        "command": "name",
        "value": "Frostleaf",
        "text": "Thank you."
    },
