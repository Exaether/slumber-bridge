    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "text": "Here! Right here!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "...A wall? Did I get it wrong?",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Just smash it! Break through...!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "But if it collapses, I...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "text": "I... got it wrong.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character"
    },
    {
        "text": "It's open!",
        "tag": "name",
        "value": "Yeti #1"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
