    {
        "command": "character",
        "params": {
            "name": "char_1505_frstar_1"
        }
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "......"
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "They're not. This was once the cloak of the 'Patriot.' I wove it into a coat."
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#1",
            "name2": "char_1505_frstar_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "......Oh......"
    },
    {
        "command": "character",
        "params": {
            "name": "char_1505_frstar_1"
        }
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "How can you tell?"
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "Never mind..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_1505_frstar_1#7"
        }
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "......"
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "Everyone has some things they can't say, I suppose."
    },
