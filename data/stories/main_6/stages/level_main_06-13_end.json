        "command": "character",
        "params": {
            "name": "char_002_amiya_1#4"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "FrostNova..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#8"
        }
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Hey, wait. I have something to say too."
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Yeti #1!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_037"
        }
    },
    {
        "command": "name",
        "value": "Yeti #1",
        "text": "Oh... huh?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_1505_frstar_1"
        }
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "......?"
    },
    {
        "command": "name",
        "value": "FrostNova",
        "text": "What's happening?"
    },
    {
