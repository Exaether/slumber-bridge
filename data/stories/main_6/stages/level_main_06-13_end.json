    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#5",
            "name2": "char_219_meteo_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Meteorite",
        "text": "(But...)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#5",
            "name2": "char_219_meteo_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "(Leave her be.)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "If we let them get there first..."
    },
