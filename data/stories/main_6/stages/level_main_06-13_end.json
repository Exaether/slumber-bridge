    },
    {
        "text": "......!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Blaze! Meteorite!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_219_meteo_1"
    },
    {
        "text": "On it.",
        "tag": "name",
        "value": "Meteorite"
    },
    {
        "tag": "character",
        "name": "char_017_homura_3#5"
    },
    {
        "text": "Get ready.",
        "tag": "name",
        "value": "Blaze"
    },
