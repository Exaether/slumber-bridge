    {
        "command": "name",
        "value": "Meteorite",
        "text": "Amiya, stop!"
    },
    {
        "command": "name",
        "value": "Meteorite",
        "text": "Your fingers are bleeding! Stop digging with your hands!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "But... I can feel something down there... Right down here!"
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "I can't feel it if I'm using a tool... I have to use my fingers to pick up on that tiny whisper of a feeling..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_219_meteo_1",
            "name2": "char_002_amiya_1#7",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Meteorite",
        "text": "Amiya!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
