        "params": {
            "name": "char_308_swire_1#5",
            "name2": "char_010_chen_1#5",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "Lungmen's special forces are on the move. And I don't know if the people of this district are piled in a mass grave somewhere."
    },
    {
        "command": "character",
        "params": {
            "name": "char_308_swire_1#5",
            "name2": "char_010_chen_1#5",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Swire",
        "text": "Huh? What are you talking about...?"
