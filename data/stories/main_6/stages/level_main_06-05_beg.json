        "text": "Amiya..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7",
            "name2": "avg_npc_012",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Yeah. I'm fine."
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Can we still reach Blaze, Doctor, and GreyThroat?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7",
            "name2": "avg_npc_012",
            "focus": 2
        }
    },
    {
