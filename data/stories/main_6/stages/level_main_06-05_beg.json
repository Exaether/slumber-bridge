        "text": "No problem."
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7",
            "name2": "avg_npc_012",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Good. Keep in touch with them. Help them find their way."
    },
    {
        "command": "dialog"
    },
