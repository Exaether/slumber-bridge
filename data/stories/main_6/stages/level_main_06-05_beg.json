        "command": "character",
        "params": {
            "name": "char_308_swire_1#6",
            "name2": "char_010_chen_1#2",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "Being sick in bed means he can't run Lungmen anymore? You know better than I what kind of man your grandfather is!"
