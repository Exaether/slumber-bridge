    {
        "command": "character"
    },
    {
        "command": "name",
        "value": "Reunion Member",
        "text": "Go on! Get out of here! We don't want to fight!"
    },
    {
        "command": "name",
        "value": "L. G. D. Officer",
        "text": "Hmph... we won't yield to the Infected!"
    },
    {
        "command": "name",
        "value": "Reunion Member",
        "text": "You're outnumbered! What's the point?"
    },
    {
        "command": "name",
        "value": "L. G. D. Officer",
        "text": "Duty!"
    },
    {
        "command": "name",
        "value": "Reunion Member",
        "text": "Don't blame us for what happens! You see those monsters behind us? Just run already!"
    },
    {
        "command": "name",
        "value": "L. G. D. Officer",
        "text": "What monsters?!"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "character"
    },
    {
        "command": "background",
        "params": {
            "image": "bg_building_3",
            "screenadapt": "coverall"
        }
    },
    {
        "command": "blocker",
        "params": {
            "a": 0,
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "character",
        "params": {
            "name": "char_017_homura_3#4"
        }
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "See that Reunion group cutting through the alleys? They're picking at Lungmen's vanguard units. They won't hold for long..."
    },
    {
        "command": "name",
        "value": "Blaze",
        "text": "Give me a path."
    },
    {
        "command": "decision",
        "params": {
            "options": "The usual, or...?",
            "values": "1;2;3"
        }
    },
    {
        "command": "predicate",
        "params": {
            "references": 1
        }
