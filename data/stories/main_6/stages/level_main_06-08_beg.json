        }
    },
    {
        "command": "name",
        "value": "Ch'en",
        "text": "Did you know we have three guests?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "blocker",
        "params": {
            "a": 1,
