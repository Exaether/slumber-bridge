    {
        "text": "Now, we must fight.",
        "tag": "name",
        "value": "FrostNova"
    },
    {
        "text": "If you can defeat me, it means some will be able to survive\u2014\u2014",
        "tag": "name",
        "value": "FrostNova"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
