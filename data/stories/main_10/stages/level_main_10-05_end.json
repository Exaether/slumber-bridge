    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "character",
        "name": "avg_npc_406_1#1$1"
    },
    {
        "text": "W-What's going on?",
        "tag": "name",
        "value": "Dublinn Soldier"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "character",
        "name": "avg_4039_horn_1#1$1",
        "fadetime": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Don't move.",
        "tag": "name",
        "value": "Horn"
    },
    {
        "tag": "character",
        "name": "avg_npc_406_1#1$1"
    },
    {
        "text": "I-It's you...! M-601, call for... argh!",
        "tag": "name",
        "value": "Dublinn Soldier"
    },
    {
        "tag": "character",
        "name": "avg_4039_horn_1#1$1"
    },
    {
        "text": "Don't speak either.",
        "tag": "name",
        "value": "Horn"
    },
    {
        "tag": "character",
        "name": "avg_npc_406_1#1$1"
    },
    {
        "text": "Urgh...",
        "tag": "name",
        "value": "Dublinn Soldier"
    },
    {
        "tag": "character",
        "name": "avg_4039_horn_1#1$1"
    },
    {
        "text": "Hand over the comms.",
        "tag": "name",
        "value": "Horn"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.51
    },
    {
        "tag": "playsound",
        "key": "$fightgeneral",
        "volume": 0.3
    },
    {
        "tag": "playsound",
