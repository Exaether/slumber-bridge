        "volume": 0.6
    },
    {
        "text": "Dagda, Indra, we\u2019ve got incoming! I'd suggest we bail!",
        "tag": "name",
        "value": "Rhodes Island Operator"
    },
    {
        "tag": "character",
        "name": "avg_npc_396_1#1$1"
    },
    {
        "text": "Got it.",
        "tag": "name",
        "value": "Dagda"
    },
    {
        "tag": "character",
        "name": "avg_155_tiger_1#9$1"
    },
    {
        "text": "Grr... They sure move fast.",
        "tag": "name",
        "value": "Indra"
    },
    {
        "tag": "character",
        "name": "avg_npc_396_1#1$1"
    },
    {
        "text": "You were in charge of recon, you didn't spot anyone nearby?",
        "tag": "name",
        "value": "Dagda"
    },
    {
        "tag": "character",
        "name": "avg_155_tiger_1#6$1"
    },
    {
        "text": "Too much work. We'll just take 'em out as they come.",
        "tag": "name",
        "value": "Indra"
    },
    {
        "tag": "character",
        "name": "avg_npc_396_1#7$1"
    },
    {
        "text": "Balin... please stay hidden. Indra and I will take care of the incoming hostiles.",
        "tag": "name",
        "value": "Dagda"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "text": "They're inside!",
        "tag": "name",
