    },
    {
        "text": "What just happened?",
        "tag": "name",
        "value": "Dublinn Soldier B"
    },
    {
        "tag": "character",
        "name": "avg_npc_416_1#1$1"
    },
    {
        "text": "Sir, my heart's pounding too loud... I couldn't hear anything.",
        "tag": "name",
        "value": "Londinium Citizen"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
