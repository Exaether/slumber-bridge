            "name": "avg_npc_2034_1#6$1"
        }
    },
    {
        "command": "name",
        "value": "Gordon",
        "text": "Who's that?!"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_2034_1#9$1"
        }
    },
    {
        "command": "name",
        "value": "Gordon",
        "text": "...A letter?"
    },
    {
        "command": "dialog"
    },
