    {
        "command": "name",
        "value": "Ferne",
        "text": "Good thing you only hit the window rail, instead of getting your whole head stuck in there."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "right",
            "name": "avg_npc_1000_1#1$1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Oakley",
        "text": "The expo's about to begin. Aren't you nervous at all?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "left",
            "name": "avg_4214_cairn_1#3$1",
            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Ferne",
        "text": "Relax. Professionals always have an escape plan ready. I'll get you out when the time's right."
    },
    {
        "command": "charslot"
    },
    {
        "command": "stopmusic",
        "params": {
            "fadetime": 2
        }
    },
    {
        "command": "name",
        "value": "???",
        "text": "You want to leave already?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_gen_walk_n"
        }
    },
    {
        "command": "charslot",
