    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_npc_2037_1#13$1",
            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Mercia",
        "text": "I think you should go buy your cotton candy planets. They won't be coming."
