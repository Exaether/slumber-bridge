        "command": "delay",
        "value": 2
    },
    {
        "command": "name",
        "value": "Tester",
        "text": "Look! This high-altitude adaptive balloon in the shape of the President is one of our hot souvenirs!"
    },
    {
        "command": "name",
        "value": "Tester",
        "text": "A thin film on the balloon's surface automatically adjusts its molecular structure according to the environment, so it won't explode, even if it collides with the Barrier."
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_npc_2037_1#1$1",
