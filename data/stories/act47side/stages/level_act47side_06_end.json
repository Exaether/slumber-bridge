            "focus": "l"
        }
    },
    {
        "command": "name",
        "value": "Tester",
        "text": "Think about it, Miss! Just how many balloons could we fit under the Barrier?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "r",
            "name": "avg_npc_2037_1#9$1",
            "focus": "r"
