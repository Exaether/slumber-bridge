    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "Are you feeling better?",
        "tag": "name",
        "value": "Mercia"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "(Weak breathing)",
        "tag": "name",
        "value": "V\u00e6la"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2037_1#4$1"
    },
    {
        "text": "You're in poor shape.",
        "tag": "name",
        "value": "Mercia"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2037_1#11$1",
        "focus": "m"
    },
    {
        "text": "You've already seen Director Lunorey. Perhaps I should send you back to the Convallis\u2014",
        "tag": "name",
        "value": "Mercia"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "No... no...",
        "tag": "name",
        "value": "V\u00e6la"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2037_1#12$1",
        "focus": "m"
    },
    {
        "text": "Another no, just like last night.",
        "tag": "name",
        "value": "Mercia"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2037_1#13$1",
        "focus": "m"
    },
    {
        "text": "Things will only get messier on Propeller Paradise in the coming days.",
        "tag": "name",
        "value": "Mercia"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2037_1#13$1",
        "focus": "m"
    },
    {
        "text": "It'll be even more difficult to leave.",
        "tag": "name",
        "value": "Mercia"
    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
    {
        "tag": "dialog"
    },
