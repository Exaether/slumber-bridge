    },
    {
        "tag": "charslot",
        "slot": "right",
        "name": "avg_npc_2041_1#3$1",
        "focus": "r"
    },
    {
        "text": "Phew... nothing wrong with the components. They'll last till the show ends. Let's go.",
        "tag": "name",
        "value": "Aspen"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
