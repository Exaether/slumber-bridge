    },
    {
        "text": "Grr, why isn't the line moving? Drag this out any longer and the broadcast is gonna start!",
        "tag": "name",
        "value": "Anxious Company Representative"
    },
    {
        "text": "Calm down, Maylander guys are on their way to handle it... they've got someone surrounded. Seems like a Rhine Lab researcher, judging by the uniform?",
        "tag": "name",
        "value": "Curious Tester"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopsound",
        "channel": "bgs",
        "fadetime": 2
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
