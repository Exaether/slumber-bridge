        "name": "avg_npc_2041_1#5$1",
        "focus": "r"
    },
    {
        "text": "Why's the door locked?",
        "tag": "name",
        "value": "Aspen"
    },
    {
        "tag": "charslot",
        "slot": "left",
        "name": "avg_4214_cairn_1#8$1",
        "focus": "l"
    },
    {
        "text": "Wait, did you hear that?",
        "tag": "name",
        "value": "Ferne"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_devicebeep",
        "loop": true,
        "channel": "bgs",
        "volume": 0.7
    },
    {
        "tag": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "charslot",
        "slot": "right",
        "name": "avg_npc_2041_1#5$1",
        "focus": "r"
    },
    {
        "text": "I did... don't tell me something's really up with my product?",
        "tag": "name",
        "value": "Aspen"
    },
    {
        "tag": "charslot",
        "slot": "left",
        "name": "avg_4214_cairn_1#9$1",
        "focus": "l"
    },
    {
        "text": "No, I don't mean the exhibit. From\u2014",
        "tag": "name",
        "value": "Ferne"
    },
    {
        "tag": "charslot",
        "slot": "left",
        "name": "avg_4214_cairn_1#5$1",
        "focus": "l"
    },
    {
        "text": "Under our feet?",
        "tag": "name",
        "value": "Ferne"
    },
