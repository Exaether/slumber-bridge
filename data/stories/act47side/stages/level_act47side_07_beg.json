    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2039_1#5$1",
        "focus": "m"
    },
    {
        "text": "Wait... the tree looks strange.",
        "tag": "name",
        "value": "Sky Jagger"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2046_1#1$1"
    },
    {
        "text": "You used the same excuse ten minutes ago.",
        "tag": "name",
        "value": "Council Member"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2039_1#12$1"
    },
    {
        "tag": "charslot",
        "slot": "right",
        "name": "avg_npc_2046_1#1$1",
        "focus": "m",
        "posfrom": "50,0",
        "posto": "50,0"
    },
    {
        "tag": "charslot",
        "slot": "left",
        "name": "avg_npc_2046_1#1$1",
        "focus": "m",
        "posfrom": "-50,0",
        "posto": "-50,0"
    },
    {
        "text": "No, no! It really looks weird! Look for yourself!",
        "tag": "name",
        "value": "Sky Jagger"
    },
    {
        "tag": "charslot",
        "duration": 1
    },
    {
        "tag": "dialog"
    },
