    },
    {
        "text": "......",
        "tag": "name",
        "value": "Gordon"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4213_skybx_1#1$1"
    },
    {
        "text": "Everything ready, Five-Four?",
        "tag": "name",
        "value": "Gordon"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_2040_1#1$1"
    },
    {
        "text": "Preparations complete.",
        "tag": "name",
        "value": "Space Finbeast"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4213_skybx_1#1$1"
    },
    {
        "text": "Let's go. I have an opening speech to make.",
        "tag": "name",
        "value": "Gordon"
    },
