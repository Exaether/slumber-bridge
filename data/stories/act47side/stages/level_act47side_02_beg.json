    },
    {
        "tag": "delay",
        "time": 1.2
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4212_nasti_1#2$1",
        "focus": "l"
    },
    {
        "text": "(In Sarkaz) Unravel!",
        "tag": "name",
        "value": "Nasti"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_magic_1"
    },
    {
        "tag": "dialog"
    },
