        "tag": "charslot",
        "slot": "l",
        "name": "avg_4212_nasti_1#2$1",
        "focus": "l"
    },
    {
        "text": "Hmph.",
        "tag": "name",
        "value": "Nasti"
    },
    {
        "tag": "dialog"
    },
