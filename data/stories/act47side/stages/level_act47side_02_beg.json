    },
    {
        "text": "Floating botanical unit connected.",
        "tag": "name",
        "value": "Nasti"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_activation"
    },
    {
        "tag": "delay",
