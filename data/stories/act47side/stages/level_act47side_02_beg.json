        "focus": "r"
    },
    {
        "text": "Bioelectrical signal detected. Charging drive unit.",
        "tag": "name",
        "value": "Veteran Researcher"
    },
    {
        "text": "Phew... that's the smoothest these experiments have gone, isn't it?",
        "tag": "name",
        "value": "Veteran Researcher"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_signlntrfrnc"
    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4212_nasti_1#6$1",
        "focus": "l"
    },
    {
        "text": "No, this voice... the short-circuit protection has kicked in.",
        "tag": "name",
        "value": "Nasti"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4212_nasti_1#1$1",
        "focus": "l"
    },
    {
        "text": "(In Sarkaz) Unravel.",
        "tag": "name",
        "value": "Nasti"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_magic_1"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 0.8
    },
    {
