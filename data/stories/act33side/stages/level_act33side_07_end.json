    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_404_1#1$1",
        "duration": 1.5,
        "isblock": true
    },
    {
        "text": "Have you been on duty this entire time?",
        "tag": "name",
        "value": "Manfred"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_419_1#1$1"
    },
    {
        "text": "Yes, sir.",
        "tag": "name",
        "value": "Military Commission Guard"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_404_1#1$1"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Manfred"
    },
    {
        "text": "Stand down for now. I wish to be alone for a while.",
        "tag": "name",
        "value": "Manfred"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_419_1#1$1"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_419_1#1$1"
    },
    {
        "text": "Of course, sir.",
        "tag": "name",
        "value": "Military Commission Guard"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n",
        "volume": 1
    },
    {
