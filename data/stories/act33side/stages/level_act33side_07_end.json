        "fadetime": 2,
        "block": false
    },
    {
        "tag": "charslot",
        "slot": "r",
        "focus": "none",
        "afrom": 1,
        "ato": 0,
        "duration": 1.5,
        "isblock": true
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "The silent assassin stows her blade up her sleeve, then slowly steps back into the shadows."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_404_1#1$1"
    },
    {
        "text": "...Neither will I.",
        "tag": "name",
        "value": "Manfred"
    },
    {
        "text": "If only this was our last meeting.",
        "tag": "name",
        "value": "Manfred"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
