    {
        "text": "Early 1094"
    },
    {
        "text": "The nomadic city of Kazdel, Kazdel"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n",
        "volume": 1
    },
    {
        "tag": "charslot",
