    {
        "text": "Londinium, Victoria"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_248"
    },
    {
        "text": "Mercenaries!",
        "tag": "name",
        "value": "Victorian Soldier"
    },
    {
        "text": "Message from His Grace the Duke: Storming Londinium like this was well done.",
        "tag": "name",
        "value": "Victorian Soldier"
    },
    {
        "text": "Assemble in Central in an hour. You'll be reviewed there, then you'll receive your bounty.",
        "tag": "name",
        "value": "Victorian Soldier"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Hey! Did you get all that?",
        "tag": "name",
        "value": "Victorian Soldier"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n",
        "volume": 1
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1297_1#1$1",
        "duration": 2,
        "isblock": true
