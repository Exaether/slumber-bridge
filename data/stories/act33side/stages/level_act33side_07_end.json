        "name": "avg_npc_404_1#1$1"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Manfred"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n",
        "volume": 1
    },
    {
