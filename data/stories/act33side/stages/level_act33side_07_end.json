    {
        "tag": "charslot"
    },
    {
        "tag": "background",
        "image": "49_g14_rhodesdeck_d",
        "screenadapt": "coverall"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playsound",
        "key": "$d_avg_snowstormflp",
        "volume": 0,
        "loop": true,
        "channel": "s"
    },
    {
        "tag": "soundvolume",
