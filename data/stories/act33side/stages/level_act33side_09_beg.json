        "name": "avg_npc_1296_1#1$1",
        "focus": "l"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Theresa"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1295_1#1$1",
        "focus": "r"
    },
    {
        "text": "Why did you stop, Theresa? We just got to the important part of the story!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1296_1#8$1",
        "focus": "l"
    },
    {
        "text": "I thought I'd leave a little suspense for you, Amiya. Would you mind if I used another, more comfortable way to tell you this story?",
        "tag": "name",
        "value": "Theresa"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1295_1#2$1",
        "focus": "r"
    },
    {
        "text": "But... Okay.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1296_1#8$1",
        "focus": "l"
    },
    {
        "text": "Watch out, Amiya.",
        "tag": "name",
        "value": "Theresa"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1295_1#1$1",
        "focus": "r"
    },
    {
        "text": "A bubble! Huh? This is\u2014",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playmusic",
        "intro": "$distressed_intro",
        "key": "$distressed_loop",
        "volume": 0.6
    },
    {
        "tag": "charslot",
        "slot": "r",
        "afrom": 1,
        "ato": 0,
        "duration": 3
    },
    {
        "tag": "blocker",
        "a": 0.4,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 3,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "Black ripples continuously wash over the pure white room, as though Amiya has plunged into a pool filled with ink."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_underwtr",
        "volume": 0,
        "loop": true,
        "channel": "un"
