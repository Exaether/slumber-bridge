    {
        "text": "......",
        "tag": "name",
        "value": "Nezzsalem"
    },
    {
        "text": "Stand back, Duq'arael.",
        "tag": "name",
        "value": "Nezzsalem"
    },
    {
        "text": "You are covered in the blood of the mediocre.",
        "tag": "name",
        "value": "Nezzsalem"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n",
        "volume": 1
    },
    {
        "tag": "charslot",
        "slot": "l",
