    {
        "text": "This one's handled. Proceed.",
        "tag": "name",
        "value": "Cautious Assassin"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_1307_1#1$1",
        "focus": "r"
    },
    {
        "text": "Our men on the inside are already on standby at every ambush spot. We can begin a coordinated assault at any time.",
        "tag": "name",
        "value": "Determined Assassin"
    },
    {
        "text": "If you see anyone, don't hesitate. Those left on the ship are no threat.",
        "tag": "name",
        "value": "Determined Assassin"
    },
