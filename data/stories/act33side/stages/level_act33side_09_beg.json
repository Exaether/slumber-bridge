    {
        "text": "The wreath of reeds slowly sinks into the riverbed. The gloomy mists have not dispersed for days."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1071_1#5$1"
    },
    {
        "text": "Aefanyl... Are you still by her side?",
        "tag": "name",
        "value": "Laqeramaline"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_1071_1#2$1"
    },
    {
        "text": "For whom does the elegy ring out?",
        "tag": "name",
        "value": "Laqeramaline"
    },
    {
        "tag": "dialog"
    },
