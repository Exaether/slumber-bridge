    {
        "text": "I brought my book, Theresa\u2014",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Huh? Why is the door shut?",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "dialog"
    },
