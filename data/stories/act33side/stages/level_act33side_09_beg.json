    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "text": "Theresa, it's me! Are you in there?",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
