    {
        "tag": "charslot",
        "slot": "r",
        "focus": "r"
    },
    {
        "text": "Hey, careful. That's enough pushing. Amiya, you good?",
        "tag": "name",
        "value": "Scout"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_1295_1#8$1",
        "posfrom": "-80,0",
        "posto": "-80,0",
        "duration": 0.5,
        "block": true
    },
    {
        "tag": "charslot",
        "slot": "l",
        "focus": "l"
    },
    {
        "text": "I'm okay!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Doctor! Come with me, Theresa and I made you a cake!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "Look, the oven was so hot I got a blister on my finger.",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "focus": "n"
    },
    {
        "text": "Thank you... Oh! Are you okay? Does anyone have some burn cream...?",
        "tag": "name",
        "value": "Doctor"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "A gentle cough sounds in the room, and the crowd splits into two."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "stopsound",
        "channel": "in",
        "fadetime": 2
    },
    {
