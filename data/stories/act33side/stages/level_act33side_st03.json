        }
    },
    {
        "command": "name",
        "value": "Doctor",
        "text": "What brings you here, Kal'tsit?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_003_kalts_1#11$1"
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "Should I not be present at this celebration of your latest victory?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_048"
        }
    },
    {
        "command": "name",
        "value": "Doctor",
        "text": "It's been a long time since I last... days like these were rare back then, you know."
    },
    {
        "command": "name",
        "value": "Doctor",
        "text": "Or I should say, I've grown so unaccustomed to it now."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_003_kalts_1#11$1"
        }
    },
    {
        "command": "name",
        "value": "Kal'tsit",
        "text": "No matter, you will get used to it again, in time. Babel will be a new beginning."
    },
    {
        "command": "dialog"
    },
