    {
        "tag": "charslot"
    },
    {
        "text": "Theresa sees a woman dressed in white passing by, smiling as she extends a hand to the Doctor with a still healing needle wound."
    },
    {
        "text": "She is looking at herself."
    },
    {
        "tag": "dialog"
    },
    {
