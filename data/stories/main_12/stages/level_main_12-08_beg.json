    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_407_1#9$1",
        "focus": "l"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Siege"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_863_1#1$1",
        "focus": "r"
    },
    {
        "text": "Something on your mind, Vina?",
        "tag": "name",
        "value": "Baird"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_407_1#9$1",
        "focus": "l"
    },
    {
        "text": "These clothes are too heavy. I can't catch my breath sleeping in them.",
        "tag": "name",
        "value": "Siege"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_407_1#1$1",
        "focus": "l"
    },
    {
        "text": "I'm looking for stuff that fits me better.",
        "tag": "name",
        "value": "Siege"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_863_1#9$1",
        "focus": "r"
    },
    {
        "text": "In that drawer.",
        "tag": "name",
        "value": "Baird"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_407_1#1$1",
        "focus": "all"
    },
