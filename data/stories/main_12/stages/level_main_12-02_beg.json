    {
        "text": "The Sarkaz ambushed... the Camden Borough safe house... We.... Their forces...",
        "tag": "name",
        "value": "Self-Salvation Corps Fighter"
    },
    {
        "text": "Urghh\u2014",
        "tag": "name",
        "value": "Self-Salvation Corps Fighter"
    },
