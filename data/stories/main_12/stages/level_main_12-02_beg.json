    },
    {
        "text": "Everyone, the Sarkaz assault is fierce. They've had their eyes on this place for a long time, and the routes on the surface have already fallen.",
        "tag": "name",
        "value": "Horn"
    },
    {
        "text": "They\u2014",
        "tag": "name",
        "value": "Horn"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "playsound",
        "key": "$e_atk_magic_m",
        "volume": 1
    },
    {
