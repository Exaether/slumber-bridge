    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_867_1#1$1",
        "focus": "m"
    },
    {
        "text": "I see you're finally here, Miss Ines.",
        "tag": "name",
        "value": "'Trilby Asher'"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_867_1#1$1",
        "focus": "m"
    },
    {
        "text": "I thought I wouldn't catch you in time.",
        "tag": "name",
        "value": "'Trilby Asher'"
    },
