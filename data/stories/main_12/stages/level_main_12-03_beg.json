    },
    {
        "text": "The evacuation's almost complete!",
        "tag": "name",
        "value": "Self-Salvation Corps Fighter"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_229_1#6",
        "focus": "l"
    },
    {
        "text": "Good, we need to get out of here ASAP.",
        "tag": "name",
        "value": "Horn"
    },
