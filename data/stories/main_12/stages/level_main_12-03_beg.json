    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_npc_863_1#9$1",
        "focus": "r"
    },
    {
        "text": "Looks like Delphine's back.",
        "tag": "name",
        "value": "Baird"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
