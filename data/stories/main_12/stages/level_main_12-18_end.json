        "tag": "background"
    },
    {
        "tag": "image",
        "image": "37_i12",
        "screenadapt": "coverall",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "imagetween",
        "xScaleFrom": 1.1,
        "yScaleFrom": 1.1,
        "xFrom": -20,
