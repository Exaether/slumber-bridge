    },
    {
        "text": "Stay away! All of you stay away!",
        "tag": "name",
        "value": "Timid Citizen"
    },
    {
        "text": "This gutless man suddenly pulls out something and brandishes it in the air. It's a fountain pen, and even in the dark, you can tell clearly just how fancy it's decorated."
    },
    {
        "text": "He's a scholar of heraldry, claims he could be the next Fellow of the Royal Victorian Academy of Sciences. Maybe that's the pen from which all sorts of marvelous criticisms used to flow."
    },
    {
        "text": "But now, it's just a pathetic, utterly shameful weapon, clutched in a trembling hand."
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_dropspanner",
        "volume": 0.5
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 20,
        "ystrength": 20,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playsound",
        "key": "$d_avg_cloakmovement",
        "volume": 1
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_177",
        "posfrom": "0,0",
        "posto": "0,-150",
        "duration": 1.5,
        "isblock": false
    },
    {
        "tag": "charslot",
