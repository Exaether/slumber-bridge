        "ato": 0,
        "duration": 0.5
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4071_peper_1#10$1",
        "focus": "l"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Paprika"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4071_peper_1#12$1",
        "focus": "l"
    },
    {
        "text": "He's gone.",
        "tag": "name",
        "value": "Paprika"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4071_peper_1#12$1",
        "focus": "all"
    },
    {
        "tag": "delay",
        "time": 0.2
    },
    {
