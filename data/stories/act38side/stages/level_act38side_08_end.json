    },
    {
        "command": "name",
        "value": "Lavinia",
        "text": "Scusi, is Eirene not here right now?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1550_1#1$1",
            "duration": 0.5
        }
    },
    {
        "command": "delay",
        "value": 0.6
    },
    {
        "command": "name",
        "value": "Truck Driver",
        "text": "...Y-Your Honor?"
    },
    {
        "command": "name",
        "value": "Truck Driver",
        "text": "U-Uh, Eirene's not here. Everyone went to celebrate her acquittal, that's why."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4065_judge_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Lavinia",
        "text": "So why aren't you with them?"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1550_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Truck Driver",
        "text": "I-I'm just servicing these trucks. See?"
    },
    {
        "command": "name",
        "value": "Truck Driver",
        "text": "Carnevale's tomorrow, and they'll need a lot of our cars..."
    },
    {
        "command": "name",
        "value": "Truck Driver",
        "text": "Someone has to do it."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_4065_judge_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Lavinia",
        "text": "..."
    },
    {
        "command": "name",
        "value": "Lavinia",
        "text": "You're lying, Signore."
    },
    {
        "command": "name",
        "value": "Lavinia",
        "text": "When you see her, please let Eirene know I need to meet her, even outside of office hours."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_1550_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Truck Driver",
        "text": "...Got it."
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
