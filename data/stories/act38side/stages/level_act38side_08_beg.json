    },
    {
        "tag": "charslot"
    },
    {
        "tag": "curtain"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "background",
        "image": "bg_vipward",
        "screenadapt": "coverall"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
