    {
        "text": "<p=2>November 7th, 1100    2:30 P.M.</>",
        "tag": "animtext",
        "id": "at1",
        "name": "group_location_stamp",
        "style": "avg_only_medium",
        "pos": "-400,-200",
        "block": false
    },
    {
        "tag": "delay",
        "time": 3
    },
    {
        "tag": "animtextclean"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1502_crosly_1#5$1",
        "duration": 1
    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "text": "This is the only place left.",
        "tag": "name",
        "value": "Lyudmila"
    },
    {
        "tag": "charslot",
        "duration": 1
    },
    {
        "text": "Lyudmila stands between the shipping containers, looking out at the bustling port in front of her."
    },
    {
        "text": "Over the course of the entire day, she searched everywhere she could, but found nothing."
    },
    {
        "text": "She was once able to make her way through Catastrophe-torn Chernobog with ease, and lead her team on precision strikes in the middle of a chaotic battlefield, yet now, she could not locate even an ordinary truck driver."
    },
    {
        "text": "She feels like the target of some sick joke. An inkling of helplessness suddenly worms its way into her mind."
    },
    {
        "tag": "dialog"
    },
    {
