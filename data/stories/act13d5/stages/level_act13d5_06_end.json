        "tag": "blocker",
        "a": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "text": "This event is joint sponsored by Mieszko Group, Rose Paper Union, S\u0142oma Food Company and the Roar Guards!",
        "tag": "name",
        "value": "Greatmouth Mob"
    },
    {
        "text": "The entire audience will get product coupons for goods from the aforementioned companies at any time! And once again, I'm gonna personally recommend a must-have for all you watching the game\u2014Blue Ear Beer!",
        "tag": "name",
        "value": "Greatmouth Mob"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
