        "name2": "char_204_platnm_1",
        "focus": 0
    },
    {
        "text": "Hm...?",
        "tag": "name",
        "value": "Maria & Platinum"
    },
    {
        "tag": "character",
        "name": "avg_npc_061#5",
        "name2": "char_204_platnm_1",
        "focus": 1
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Maria"
    },
    {
        "tag": "character",
        "name": "avg_npc_061#5",
        "name2": "char_204_platnm_1",
        "focus": 2
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Platinum"
    },
    {
        "tag": "dialog"
    },
