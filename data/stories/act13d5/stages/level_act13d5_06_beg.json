        }
    },
    {
        "command": "name",
        "value": "Old Craftsman",
        "text": "\u2014What's wrong, girl?"
    },
    {
        "command": "name",
        "value": "Old Craftsman",
        "text": "Not looking too good there. You and Zofia haven't patched things up yet?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_061#7",
            "name2": "avg_npc_101",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Maria",
        "text": "I'm fine... Has Auntie been here again?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_107",
            "name2": "avg_npc_061#7",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Bald Marcin",
        "text": "She was pacing around right by the door, but then she left just a minute ago. She's worried about you."
    },
    {
        "command": "name",
        "value": "Bald Marcin",
        "text": "I say you go find her."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_107",
            "name2": "avg_npc_061#7",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Maria",
        "text": "......"
    },
    {
        "command": "name",
        "value": "Maria",
        "text": "They've already decided my next opponent."
    },
    {
        "command": "name",
        "value": "Maria",
        "text": "If I can win, do you think my auntie... do you think everyone will understand me then?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_061#2",
            "name2": "avg_npc_101#4",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Old Craftsman",
        "text": "There, girl..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_120#3",
            "name2": "avg_npc_061#2",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Old Knight",
        "text": "...Things aren't that simple, Maria."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_120#3",
            "name2": "avg_npc_101#2",
            "focus": 2
        }
