        "command": "name",
        "value": "Spokesman Czarny",
        "text": "\u2014Pardon?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_106",
            "name2": "avg_npc_061#7",
            "focus": 2
        }
