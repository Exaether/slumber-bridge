    },
    {
        "command": "name",
        "value": "Sona",
        "text": "Ashley... you think we went overboard this time? Hey, Ashley, come on. Did you pass out?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_122",
            "name2": "avg_npc_123",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ashlock Knight",
