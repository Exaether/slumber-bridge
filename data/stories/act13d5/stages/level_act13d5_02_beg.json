    },
    {
        "tag": "character",
        "name": "avg_npc_121"
    },
    {
        "text": "And now without further ado! May our contestants please step forward! On your marks!",
        "tag": "name",
        "value": "Greatmouth Mob"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "character",
        "name": "avg_npc_061#5",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "...Grandpa... Margaret... here I go.",
        "tag": "name",
        "value": "Maria"
    },
    {
        "tag": "character",
        "name": "avg_npc_061#5"
    },
    {
        "text": "My name is Maria Nearl! My family motto is, 'Fear neither hardship nor darkness!'",
        "tag": "name",
        "value": "Maria"
    },
