    },
    {
        "command": "name",
        "value": "Tourist",
        "text": "I bet my entire fortune on you! Nearl!"
    },
    {
        "command": "name",
        "value": "Tourist",
        "text": "*Whistle* Radiant Knight! Lil' Radiant Knight!"
    },
    {
        "command": "dialog"
