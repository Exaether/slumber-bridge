    },
    {
        "command": "name",
        "value": "Maria",
        "text": "(Mmn... There's so many people looking at me...!)"
    },
    {
        "command": "name",
        "value": "Maria",
        "text": "(No, I shouldn't worry about my surroundings so much... Deep breath... Deep breath...)"
