    {
        "command": "name",
        "value": "Greatmouth Mob",
        "text": "Laaaaadies and gentlemen! Welcommmmme to the Roar Arena!"
    },
    {
        "command": "name",
        "value": "Greatmouth Mob",
        "text": "You're in for a treat today at this arena, fully sponsored by the Roar Guards Company! 'Roar Guards, even the winds will bow to you!'"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_121"
        }
    },
    {
        "command": "name",
        "value": "Greatmouth Mob",
        "text": "If you don't have an independent knight to put your money on yet, then let me introduce to you once again\u2014"
    },
    {
        "command": "name",
        "value": "Greatmouth Mob",
        "text": "It's been a long month since she became the talk of the town with her debut match, and who knows what kind of training she's gone through in preparation for this day!"
    },
    {
        "command": "name",
        "value": "Greatmouth Mob",
        "text": "Please join me and welcome the cutest contestant to ever grace the Roar Arena, sister to the legend, the Nearl family's youngest ever competition knight!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_121#3"
        }
    },
    {
        "command": "name",
        "value": "Greatmouth Mob",
        "text": "Maaaaarrriiiiiia Nearllll!"
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_061#2",
