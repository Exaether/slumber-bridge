        }
    },
    {
        "command": "name",
        "value": "Old Knight",
        "text": "Nah... 'Points Off?' They ever have a 'Points Off' in the melees before?"
    },
    {
        "command": "name",
        "value": "Old Knight",
        "text": "And they announced this all-new system right before the match started. What, they can just do that?!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_120",
            "name2": "avg_npc_101#2",
