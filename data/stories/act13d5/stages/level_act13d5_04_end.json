    },
    {
        "tag": "playmusic",
        "intro": "$sjoyasorrow_intro",
        "key": "$sjoyasorrow_loop",
        "volume": 0.4
    },
    {
        "tag": "character",
        "name": "avg_npc_064_weapon_1"
    },
    {
        "text": "I'm back! Where's the chef? Let's get him going!",
        "tag": "name",
        "value": "Zofia"
    },
    {
        "text": "He's got a big meal to make tonight, and Maria'll be here soon... she needs a feast and then some! Don't say it was me who called for it.",
        "tag": "name",
        "value": "Zofia"
    },
    {
        "tag": "character"
    },
    {
        "text": "Madam Zofia, you have a guest. One who claims urgent business with you.",
        "tag": "name",
        "value": "Servant"
    },
    {
        "tag": "character",
