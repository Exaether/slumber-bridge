        "fadeout": true,
        "block": true
    },
    {
        "text": "Ungh... ugh...",
        "tag": "name",
        "value": "Maria"
    },
    {
        "tag": "character",
        "name": "avg_npc_105"
    },
    {
        "text": "Do not rise again. No matter your armor's resilience, your pain must be excruciating.",
        "tag": "name",
        "value": "Left-hand Knight"
    },
    {
        "tag": "character",
        "name": "avg_npc_061#6"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Maria"
    },
    {
        "tag": "character",
        "name": "avg_npc_105"
    },
    {
        "text": "You silently raise your arm again. Your tenacity at least deserves recognition.",
