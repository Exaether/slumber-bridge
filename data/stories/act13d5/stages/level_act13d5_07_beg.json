    },
    {
        "tag": "character",
        "name": "avg_npc_061#6"
    },
    {
        "text": "(One flick of his hand\u2014?!)",
        "tag": "name",
        "value": "Maria"
    },
    {
        "tag": "character",
        "name": "avg_npc_105"
    },
    {
        "text": "Enough! Insult me no longer with the Arts you used on Ingra!",
        "tag": "name",
        "value": "Left-hand Knight"
    },
