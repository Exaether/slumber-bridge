    {
        "command": "character",
        "params": {
            "name": "avg_npc_107"
        }
    },
    {
        "command": "name",
        "value": "Bald Marcin",
        "text": "Where are you two going, carrying all that stuff with you?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_120",
            "name2": "avg_npc_107",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Old Knight",
        "text": "We're going to pay Maria a visit."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_120",
            "name2": "avg_npc_101",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Old Craftsman",
        "text": "I will never forgive Ingra for doing that to our girl..."
    },
