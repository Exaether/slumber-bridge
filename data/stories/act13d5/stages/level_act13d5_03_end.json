    {
        "text": "Maria! Just forfeit!",
        "tag": "name",
        "value": "Zofia"
    },
    {
        "text": "It's one match! There are other chances to score the points you need\u2014!",
        "tag": "name",
        "value": "Zofia"
    },
    {
        "tag": "character",
        "name": "avg_npc_064_weapon_1#6"
    },
    {
        "text": "Maria\u2014!",
        "tag": "name",
        "value": "Zofia"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "text": "Auntie Zofia... What are you talking about?"
    },
    {
        "text": "I can't hear you... I feel dizzy... My shield feels so heavy..."
    },
    {
        "text": "What am I... doing... The knight competitions... In the arena..."
    },
    {
        "text": "I need to... open my eyes!"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
