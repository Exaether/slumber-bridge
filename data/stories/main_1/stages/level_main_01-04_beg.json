    {
        "text": "...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "fadetime": 0
    },
    {
        "text": "...Aaaargh!! !",
        "tag": "name",
        "value": "Civilian"
    },
    {
        "tag": "character",
        "name": "char_014_riope"
    },
    {
        "text": "\u2014\u2014\u2014\u2014!",
        "tag": "name",
        "value": "Ace"
    },
    {
        "text": "Civilians?",
        "tag": "name",
        "value": "Ace"
    },
    {
        "tag": "character",
        "name": "char_014_riope",
        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "text": "I can't hear anything anymore.",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "We can't tell who they are from this distance.",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "text": "...!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#7"
    },
    {
        "text": "Reunion is attacking them...!",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_014_riope"
    },
    {
        "text": "We can't leverage the terrain to our advantage here. We don't have the capacity to save everybody.",
        "tag": "name",
        "value": "Ace"
    },
    {
        "text": "Life is very precious, Amiya. Each and every one.",
        "tag": "name",
        "value": "Ace"
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#4"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "Regardless, we're already too late.",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "After all, we're in for some trouble ourselves.",
        "tag": "name",
        "value": "Dobermann"
