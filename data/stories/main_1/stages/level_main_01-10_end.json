        "name2": "char_130_doberm_ex",
        "focus": 2
    },
    {
        "text": "Shh...",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "...Don't let Amiya hear you.",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "tag": "character",
        "name": "char_148_nearl_1#7",
        "name2": "char_130_doberm_ex",
        "focus": 1
    },
    {
        "text": "Amiya's kept a clear head through this! She's a lot more mature than we thought...!",
        "tag": "name",
        "value": "Nearl"
    },
    {
        "text": "...Ngh...",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "text": "...Mmh...?",
        "tag": "name",
        "value": "Amiya"
    },
    {
        "tag": "blocker",
