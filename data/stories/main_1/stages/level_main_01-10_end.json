    {
        "text": "We've broken through Reunion's encirclement!",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "But... they...",
        "tag": "name",
        "value": "Nearl"
    },
    {
        "text": "... I... Aaaagh...",
        "tag": "name",
