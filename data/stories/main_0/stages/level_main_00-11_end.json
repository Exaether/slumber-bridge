        "fadetime": 2,
        "block": true
    },
    {
        "text": "Sorry... I failed.",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1",
        "focus": 1
    },
    {
        "text": "No, don't apologize. It was my mistake. I lost my temper.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "text": "Can you help me track Rhodes Island? I'll report the situation to Talulah first.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "text": "She should have taken over Chernobog's core command tower by now.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "text": "...She will decide the fate of these insects.",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1",
        "focus": 2
    },
    {
        "text": "...Understood.",
        "tag": "name",
        "value": "Faust"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#2",
        "name2": "char_1508_Faust_1",
        "focus": 1
    },
    {
        "text": "Be careful. Your safety is the most important thing, all right?",
        "tag": "name",
        "value": "Mephisto"
    },
    {
        "tag": "character",
        "name": "char_1507_Mephisto_1#1",
        "name2": "char_1508_Faust_1",
        "focus": 2
    },
    {
        "text": "...I will.",
        "tag": "name",
        "value": "Faust"
    },
