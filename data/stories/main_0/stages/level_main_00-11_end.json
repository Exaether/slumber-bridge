    {
        "command": "character",
        "params": {
            "name": "char_1508_Faust_1",
            "fadetime": 2,
            "block": true
        }
    },
    {
        "command": "name",
        "value": "Faust",
        "text": "Sorry... I failed."
    },
    {
        "command": "character",
        "params": {
            "name": "char_1507_Mephisto_1#1",
            "name2": "char_1508_Faust_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Mephisto",
        "text": "No, don't apologize. It was my mistake. I lost my temper."
    },
    {
        "command": "name",
        "value": "Mephisto",
        "text": "Can you help me track Rhodes Island? I'll report the situation to Talulah first."
    },
    {
        "command": "name",
        "value": "Mephisto",
        "text": "She should have taken over Chernobog's core command tower by now."
    },
    {
        "command": "name",
        "value": "Mephisto",
        "text": "...She will decide the fate of these insects."
    },
    {
        "command": "character",
        "params": {
            "name": "char_1507_Mephisto_1#1",
            "name2": "char_1508_Faust_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Faust",
        "text": "...Understood."
    },
    {
        "command": "character",
        "params": {
            "name": "char_1507_Mephisto_1#2",
            "name2": "char_1508_Faust_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Mephisto",
        "text": "Be careful. Your safety is the most important thing, all right?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_1507_Mephisto_1#1",
            "name2": "char_1508_Faust_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Faust",
        "text": "...I will."
    },
