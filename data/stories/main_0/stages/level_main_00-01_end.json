    {
        "text": "Ugh...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "You bunch... aren't from Ursus...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "fadetime": 0.7
    },
    {
        "tag": "dialog"
