    {
        "text": "Search all these houses! I want every single room turned inside out!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Let go of me...! No! You can't...",
        "tag": "name",
        "value": "Female"
    },
    {
        "text": "Trying to resist? Too late, you filthy Chernos!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Just run! Don't worry about me... Save... our child...",
        "tag": "name",
        "value": "Male"
    },
    {
        "text": "Mama... Mama...!",
        "tag": "name",
        "value": "Child"
    },
    {
        "text": "Forget about the civilians! Hold the line first! There are too many masked goons coming!",
        "tag": "name",
        "value": "Ursus Guard"
    },
    {
        "text": "Don't give the cops any time to rest! Keep attacking!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Where are our reinforcements?! We're going to get overrun...",
        "tag": "name",
        "value": "Ursus Guard"
    },
    {
        "text": "Attack, attack!!",
        "tag": "name",
        "value": "Reunion Member"
