    {
        "command": "name",
        "value": "Dobermann",
        "text": "..."
    },
    {
        "command": "name",
        "value": "Dobermann",
        "text": "I can't bring myself to trust a stranger so easily."
    },
    {
        "command": "name",
        "value": "Dobermann",
        "text": "But I trust you, Amiya."
