        "volume": 0.4
    },
    {
        "tag": "character",
        "name": "char_002_amiya_1#3",
        "focus": -1
    },
    {
        "text": "I am not sure why you did not speak, but the action of touching the interface is sufficient\u2014",
        "tag": "name",
        "value": "PRTS"
    },
    {
        "text": "\u2014Fingerprint match found. Verification complete. Security clearance: 8",
        "tag": "name",
        "value": "PRTS"
    },
