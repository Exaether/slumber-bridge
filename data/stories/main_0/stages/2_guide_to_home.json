            "name": "char_002_amiya_1"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Yes."
    },
    {
        "command": "character",
        "params": {
            "name": "char_130_doberm_ex"
        }
    },
    {
        "command": "name",
        "value": "Dobermann",
        "text": "Dr. {@nickname}, you probably don't know who I am, but you know Amiya. For your safety..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1",
            "name2": "char_130_doberm_ex",
            "focus": 1
