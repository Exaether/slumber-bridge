    {
        "command": "character",
        "params": {
            "name": "char_014_riope",
            "name2": "char_130_doberm_ex",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Dobermann",
        "text": "Ace, wait a minute."
    },
    {
        "command": "character",
        "params": {
            "name": "char_014_riope"
        }
    },
    {
        "command": "name",
        "value": "Ace",
        "text": "Dr. {@nickname}, enemy light-armored troops are stationed in front of us."
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#7"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Have we been found?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_014_riope"
        }
    },
    {
        "command": "name",
        "value": "Ace",
        "text": "Not yet."
    },
    {
        "command": "character",
        "params": {
            "name": "char_014_riope",
            "name2": "char_130_doberm_ex",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Dobermann",
        "text": "However..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_014_riope",
            "name2": "char_130_doberm_ex",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Ace",
        "text": "We won't be able to avoid them. The route we're on is the shortest one; if we take a detour, we'll lose time we don't have."
    },
    {
        "command": "character",
        "params": {
            "name": "char_014_riope",
            "name2": "char_130_doberm_ex",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Dobermann",
        "text": "No need for further discussion then. Thugs or pawns, all that matters is that we clear them out of our way!"
    },
