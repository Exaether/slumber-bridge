    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Hmm?",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Why is there an armed force here? !",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "text": "All teams, prepare for combat! Don't give them any chance to retaliate!",
        "tag": "name",
        "value": "Dobermann"
    },
