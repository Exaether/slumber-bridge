    },
    {
        "text": "...This is way beyond my expectations...",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "Explosions, rioting, fires, fighting in the streets...",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "text": "Has Chernobog completely fallen into chaos?",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.6,
        "block": true
    },
