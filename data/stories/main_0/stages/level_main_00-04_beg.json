    },
    {
        "text": "Looks like you all made it out alive.",
        "tag": "name",
        "value": "Ace"
    },
    {
        "tag": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "text": "This isn't the rendezvous point... Why are you here alone?",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
