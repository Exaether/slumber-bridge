    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "They're over here! Hurry, let's get them! !",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "text": "Are you done chatting yet? I'm going to go crack some skulls!",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "tag": "character",
        "name": "char_014_riope"
    },
    {
        "text": "Dr. {@nickname}, please give us your orders.",
        "tag": "name",
        "value": "Ace"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2"
    },
    {
        "text": "Go. Release your inner beast, and let them feel your fangs!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "char_130_doberm_ex"
    },
    {
        "text": "Doctor! Ace! The enemy is right in front of us!",
        "tag": "name",
        "value": "Dobermann"
    },
    {
        "tag": "character",
        "name": "char_014_riope"
    },
    {
        "text": "\u2014\u2014",
        "tag": "name",
        "value": "Ace"
    },
    {
        "tag": "decision",
        "options": "Move out immediately!;...Got it.;Seize the opportunity to disrupt the enemy's plans.",
        "values": "1;2;3"
    },
    {
        "tag": "predicate",
        "references": "1;2;3"
    },
    {
        "tag": "character",
        "name": "char_014_riope"
    },
    {
        "text": "Understood.",
        "tag": "name",
        "value": "Ace"
    },
    {
        "text": "Team E3! Back up Dobermann!",
        "tag": "name",
        "value": "Ace"
