    {
        "tag": "character",
        "name": "avg_222_bpipe_1#4"
    },
    {
        "text": "Oh, it's just more and more rottin' leaves...",
        "tag": "name",
        "value": "Bagpipe"
    },
    {
        "tag": "character",
        "name": "avg_479_sleach_1#8$1"
    },
    {
        "text": "Come this way.",
        "tag": "name",
        "value": "Janie"
    },
    {
        "tag": "character",
        "name": "avg_222_bpipe_1#2"
    },
    {
        "text": "Eh, what?",
        "tag": "name",
        "value": "Bagpipe"
    },
