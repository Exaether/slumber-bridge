        "name2": "avg_npc_238",
        "focus": 2
    },
    {
        "text": "Oh, just... just a boy.",
        "tag": "name",
        "value": "Captain Kelly"
    },
    {
        "text": "Are you... *cough* *cough*\u2014are you hurt? Don't run too fast now. It's been decades, and they've still never levelled the road here...",
        "tag": "name",
        "value": "Captain Kelly"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_npc_238",
        "focus": 1
    },
    {
        "text": "Traitor!",
        "tag": "name",
        "value": "Craig"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_npc_238",
        "focus": 2
    },
    {
        "text": "Wh\u2014What did you say?",
        "tag": "name",
        "value": "Captain Kelly"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_npc_238",
        "focus": 1
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Traitor!!!",
        "tag": "name",
        "value": "Craig"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_npc_238",
        "focus": 2
    },
    {
        "text": "I...",
        "tag": "name",
        "value": "Captain Kelly"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_npc_238",
        "focus": -1
    },
    {
        "text": "Craig! What are you doing?! Get back here now!",
        "tag": "name",
        "value": "Sorrowful Woman"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
