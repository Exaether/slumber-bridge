    {
        "text": "Lieutenant.",
        "tag": "name",
        "value": "Adjutant Hill"
    },
    {
        "tag": "character",
        "name": "avg_npc_229_1#1"
    },
    {
        "text": "How are my people?",
        "tag": "name",
        "value": "Horn"
    },
    {
        "tag": "character",
        "name": "avg_npc_248"
    },
    {
        "text": "Your subordinates are here. Rest assured, they're only unconscious.",
        "tag": "name",
        "value": "Adjutant Hill"
    },
    {
        "tag": "character",
        "name": "avg_npc_229_1#1"
    },
    {
        "text": "I don't mean Cello's group.",
        "tag": "name",
        "value": "Horn"
    },
    {
        "text": "You know who I mean.",
        "tag": "name",
        "value": "Horn"
    },
    {
        "tag": "character",
        "name": "avg_npc_248"
    },
    {
        "text": "\u2014",
        "tag": "name",
        "value": "Adjutant Hill"
    },
    {
        "tag": "dialog"
    },
    {
