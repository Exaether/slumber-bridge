    {
        "tag": "character",
        "name": "avg_222_bpipe_1#2"
    },
    {
        "text": "This... this isn't lightning!",
        "tag": "name",
        "value": "Bagpipe"
    },
    {
        "tag": "character",
        "name": "avg_222_bpipe_1#6"
    },
    {
        "text": "No, Mr. Chef\u2014",
        "tag": "name",
