    {
        "text": "I'm...",
        "tag": "name",
        "value": "Craig"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_479_sleach_1#1$1",
        "focus": -1
    },
    {
        "text": "Craig! It's your ma lookin' for you. Quick, you've gotta go!",
        "tag": "name",
        "value": "Anxious Child A"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
