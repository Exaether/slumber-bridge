    {
        "text": "Whose ball is this?",
        "tag": "name",
        "value": "Janie"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_479_sleach_1#1$1",
        "focus": 1
    },
    {
        "text": "Um...",
        "tag": "name",
        "value": "Craig"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_479_sleach_1#1$1",
        "focus": 2
    },
    {
        "text": "Is it yours?",
        "tag": "name",
        "value": "Janie"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_479_sleach_1#1$1",
        "focus": -1
    },
    {
        "text": "Craig... Craig, come on, run! Forget the ball...",
        "tag": "name",
        "value": "Anxious Child A"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_479_sleach_1#1$1",
        "focus": 1
    },
    {
        "text": "No... that ball's left by my da...",
        "tag": "name",
        "value": "Craig"
    },
    {
        "tag": "character",
        "name": "avg_npc_240",
        "name2": "avg_479_sleach_1#1$1"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "characteraction",
        "name": "right",
