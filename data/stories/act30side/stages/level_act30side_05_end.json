    },
    {
        "text": "Grab my hand.",
        "tag": "name",
        "value": "Leto"
    },
    {
        "text": "Hrh\u2014Hah!",
        "tag": "name",
        "value": "Leto"
    },
    {
        "text": "Alright!",
        "tag": "name",
        "value": "Leto"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_snowbodyfall"
    },
