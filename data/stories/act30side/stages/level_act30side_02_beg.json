    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4114_harold_1#15$1",
        "focus": "m"
    },
    {
        "text": "Rosalind!",
        "tag": "name",
        "value": "Harold"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_194_leto_1#14$1",
        "focus": "m"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 25,
        "ystrength": 25,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Waugh!",
        "tag": "name",
        "value": "Leto"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "delay",
        "time": 0.2
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4114_harold_1#15$1",
        "focus": "r"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_194_leto_1#6$1",
        "focus": "r"
    },
    {
        "text": "Oh, it's you. You spooked me...",
        "tag": "name",
        "value": "Leto"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_194_leto_1#13$1",
        "focus": "r"
    },
    {
        "text": "What are you doing? Are you running from somebody?",
        "tag": "name",
        "value": "Leto"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4114_harold_1#12$1",
        "focus": "l"
    },
    {
        "text": "Terribly sorry, but now is not the time to discuss this.",
        "tag": "name",
        "value": "Harold"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4114_harold_1#16$1",
        "focus": "l"
    },
    {
        "text": "Rosalind, why didn't you stay in the cabin?",
        "tag": "name",
        "value": "Harold"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "name": "avg_194_leto_1#9$1",
        "focus": "r"
    },
    {
        "text": "Uh, I wanted some fresh air.",
        "tag": "name",
        "value": "Leto"
    },
    {
        "text": "Got a problem with that?",
        "tag": "name",
        "value": "Leto"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4114_harold_1#12$1",
        "focus": "l"
    },
    {
        "text": "Oh, not at all. Fresh air is a fine thing.",
        "tag": "name",
        "value": "Harold"
    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_4114_harold_1#15$1",
        "focus": "l"
    },
    {
        "text": "It's just\u2014",
        "tag": "name",
        "value": "Harold"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
