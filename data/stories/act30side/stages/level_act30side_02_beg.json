        "tag": "charslot",
        "slot": "m",
        "name": "avg_194_leto_1#11$1",
        "focus": "m"
    },
    {
        "text": "This should take care of it...",
        "tag": "name",
        "value": "Leto"
    },
    {
        "tag": "dialog"
    },
