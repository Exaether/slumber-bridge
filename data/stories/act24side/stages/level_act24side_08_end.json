    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_753_1#3$1"
        }
    },
    {
        "command": "name",
        "value": "Ataru Takii",
        "text": "What?"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_755_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Yoshitaka Kashiwau",
        "text": "Not you! The beast!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_753_1#4$1"
        }
    },
    {
        "command": "name",
        "value": "Ataru Takii",
