    },
    {
        "tag": "character",
        "name": "avg_npc_753_1#4$1"
    },
    {
        "text": "Up above!",
        "tag": "name",
        "value": "Ataru Takii"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#6$1"
    },
    {
        "text": "That monster... it's coming.",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "character",
        "name": "avg_npc_753_1#4$1"
    },
    {
        "tag": "playmusic",
        "intro": "$nervous_intro",
        "key": "$nervous_loop",
        "volume": 0.6
    },
    {
        "text": "The beasts are coming again! Chikushou, how could there be so many!",
        "tag": "name",
        "value": "Ataru Takii"
    },
    {
        "tag": "character",
        "name": "avg_npc_753_1#4$1"
    },
    {
        "text": "We don't have enough hands!",
        "tag": "name",
        "value": "Ataru Takii"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#3$1"
    },
    {
        "text": "You stay here! Set up those traps and stop the beasts!",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#3$1"
    },
    {
        "text": "THAT one is mine.",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#3$1"
    },
    {
        "text": "I'm a hunter. That's my quarry.",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
