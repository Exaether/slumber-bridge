    {
        "text": "Come on!",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#3$1"
    },
    {
        "text": "Face me, monster!",
        "tag": "name",
