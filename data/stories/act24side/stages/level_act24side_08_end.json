            "name": "avg_npc_755_1#3$1"
        }
    },
    {
        "command": "name",
        "value": "Yoshitaka Kashiwau",
        "text": "You stay here! Set up those traps and stop the beasts!"
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_755_1#3$1"
        }
    },
    {
        "command": "name",
