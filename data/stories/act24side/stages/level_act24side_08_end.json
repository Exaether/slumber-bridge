    {
        "tag": "playmusic",
        "intro": "$dignified_intro",
        "key": "$dignified_loop",
        "volume": 0.6
    },
    {
        "tag": "character",
        "name": "avg_npc_753_1#3$1"
    },
    {
        "text": "He said...",
        "tag": "name",
        "value": "Ataru Takii"
    },
    {
        "tag": "character",
        "name": "avg_npc_753_1#3$1"
    },
    {
        "text": "'I'm sorry, father.'",
        "tag": "name",
        "value": "Ataru Takii"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#5$1"
    },
    {
        "text": "Hmph... I've had enough of your tall tale. He never called me father.",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#5$1"
    },
    {
        "text": "That brat...",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#3$1"
    },
    {
        "text": "Argh!",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "character"
    },
    {
        "text": "(Deep breath)",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "text": "But I...",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "text": "Only the old man's back is visible."
    },
    {
        "text": "But he could hear the sound of water dripping."
    },
    {
        "text": "Tears that had been forced back for too long, finally overflowing."
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#2$1"
    },
    {
        "text": "I miss him.",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
    {
