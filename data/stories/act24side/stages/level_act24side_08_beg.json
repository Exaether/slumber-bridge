    {
        "text": "Hurry it up, everyone!",
        "tag": "name",
        "value": "Hiroshi Ritou"
    },
    {
        "tag": "character"
    },
    {
        "text": "But...",
        "tag": "name",
        "value": "Masked Villager"
    },
    {
        "text": "You should run too, Ritou! Money isn't as important as your life.",
        "tag": "name",
        "value": "Masked Villager"
    },
    {
        "tag": "character",
        "name": "avg_npc_757_1#1$1"
    },
    {
        "text": "Shut up!",
        "tag": "name",
        "value": "Hiroshi Ritou"
    },
    {
        "tag": "character",
        "name": "avg_npc_757_1#1$1"
    },
    {
        "text": "I'll delay the old man!",
        "tag": "name",
        "value": "Hiroshi Ritou"
    },
    {
        "tag": "character",
        "name": "avg_npc_757_1#1$1"
    },
    {
        "text": "What are you standing around for?",
        "tag": "name",
        "value": "Hiroshi Ritou"
    },
    {
        "tag": "character",
        "name": "avg_npc_757_1#1$1"
    },
    {
        "text": "Can I take it you've given up on treating your sister?",
        "tag": "name",
        "value": "Hiroshi Ritou"
    },
    {
        "tag": "character"
    },
    {
        "text": "But... Alright.",
        "tag": "name",
        "value": "Masked Villager"
    },
    {
        "tag": "character",
        "name": "avg_npc_757_1#1$1"
    },
    {
        "text": "Kusso...",
        "tag": "name",
        "value": "Hiroshi Ritou"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
