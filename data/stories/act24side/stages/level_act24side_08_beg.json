        "name": "avg_npc_762_1#1$1"
    },
    {
        "text": "*Sobbing*...",
        "tag": "name",
        "value": "Lost Child"
    },
    {
        "tag": "character",
        "name": "avg_npc_762_1#1$1"
    },
    {
        "text": "Mom? Where are you?",
        "tag": "name",
        "value": "Lost Child"
    },
    {
        "tag": "character",
        "name": "avg_npc_762_1#1$1"
    },
    {
        "text": "Where are you...",
        "tag": "name",
        "value": "Lost Child"
    },
    {
        "tag": "character",
        "name": "avg_npc_762_1#1$1"
    },
    {
        "text": "Mom... don't leave me here...",
        "tag": "name",
        "value": "Lost Child"
    },
