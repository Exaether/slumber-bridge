        "randomness": 50,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Hey! Arty! Get back here this instant!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 70,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Ah\u2014Don't come any closer, it wasn't me who took your eggs! I'll even put them back for you, okay?",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "camerashake",
        "duration": 0.3,
        "xstrength": 30,
        "ystrength": 30,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "I'll return them right now! Don't peck me! Not my horn!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "text": "Agh! It stinks! Blegh\u2014",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "text": "Yato! Help me out!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "text": "Arty! No more egg pinching for mew!",
        "tag": "name",
        "value": "Noir Corne"
    },
