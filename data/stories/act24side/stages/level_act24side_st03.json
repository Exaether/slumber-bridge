    {
        "command": "character",
        "params": {
            "name": "avg_1030_noirc2_1#9$1"
        }
    },
    {
        "command": "name",
        "value": "Noir Corne",
        "text": "Ah... the monitoring report says it hasn't left the Soubo Mountains. It can be seen circling them amidst the cloud of ashes from time to time."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_1030_noirc2_1#1$1"
        }
    },
    {
        "command": "name",
        "value": "Noir Corne",
        "text": "It won't be easy to spot it from a place like this. Lemme take a look..."
