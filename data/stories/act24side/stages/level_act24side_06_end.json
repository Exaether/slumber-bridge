        "power": 250,
        "fadetime": 0.4,
        "isblock": false
    },
    {
        "tag": "playsound",
        "key": "$MH_nekogood",
        "volume": 1
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "ystrength": 40,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Mroaw! I caught it!",
        "tag": "name",
        "value": "Palico"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#4$1"
    },
    {
        "text": "Let go!",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
