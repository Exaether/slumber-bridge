        "ystrength": 40,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "tag": "character",
        "name": "avg_npc_750_1#6$1"
    },
    {
