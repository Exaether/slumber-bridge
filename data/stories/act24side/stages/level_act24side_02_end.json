        "xstrength": 50,
        "ystrength": 50,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Ah!",
        "tag": "multiline",
        "name": "Noir Corne"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "text": "What's the matter?",
        "tag": "name",
        "value": "Yato"
    },
    {
        "tag": "character",
        "name": "char_500_noirc_1"
    },
    {
        "text": "The ladder broke...",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "character"
    },
    {
        "text": "What? How?! Chikushou!",
        "tag": "name",
        "value": "Yato"
    },
    {
        "tag": "character",
        "name": "char_500_noirc_1"
    },
    {
        "text": "Calm down, Yato! I'm fine!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "character"
    },
    {
        "text": "Stay calm, stay calm, let me think... Right! I have an idea!",
        "tag": "name",
        "value": "Yato"
    },
    {
        "text": "Position your shield between yourself and the bomb, then detonate it and use the force of the shockwave to launch yourself up!",
        "tag": "name",
        "value": "Yato"
    },
    {
        "text": "I'll definitely catch you.",
        "tag": "name",
        "value": "Yato"
    },
    {
        "tag": "character",
        "name": "char_500_noirc_1"
    },
    {
        "text": "Got it.",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "character"
    },
    {
        "text": "Get ready!",
        "tag": "name",
        "value": "Yato"
    },
    {
        "text": "Jump!",
        "tag": "name",
        "value": "Yato"
    },
