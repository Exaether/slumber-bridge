    {
        "tag": "background",
        "image": "36_g10_easternhouse",
        "screenadapt": "coverall"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "tag": "playmusic",
        "intro": "$mist_intro",
        "key": "$mist_loop",
        "volume": 0.6
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
