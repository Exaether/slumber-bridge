    {
        "tag": "character",
        "name": "char_500_noirc_1"
    },
    {
        "text": "I'm coming, hup\u2014",
        "tag": "multiline",
        "name": "Noir Corne"
    },
    {
        "tag": "character",
        "name": "char_500_noirc_1"
    },
