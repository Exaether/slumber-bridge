    {
        "tag": "character",
        "name": "char_500_noirc_1"
    },
    {
        "text": "You head up first! I'll keep them at bay here!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "character",
        "name": "avg_502_Yato_1#7$1"
    },
    {
        "text": "No, too dangerous. You'd probably end up getting buried alive.",
        "tag": "name",
        "value": "Yato"
    },
    {
        "tag": "character",
        "name": "char_500_noirc_1"
    },
    {
        "text": "Just listen to me for once, or one of them might slip past.",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "character",
        "name": "avg_502_Yato_1#2$1"
    },
    {
        "text": "...Fine, then you follow my instructions.",
        "tag": "name",
        "value": "Yato"
    },
    {
        "tag": "dialog"
    },
