    {
        "tag": "charslot"
    },
    {
        "text": "A huge roar rumbled in his eardrums and his consciousness managed to peel away from the muddy chaos."
    },
    {
        "text": "He raised his head, staring at the enormous behemoth rearing up before him."
    },
    {
        "text": "He stared into its eyes."
    },
    {
        "tag": "character",
        "name": "avg_npc_755_1#6$1"
    },
    {
        "text": "Hoh...it's you.",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "text": "Yes... I remember now....",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "dialog"
    },
