    {
        "text": "He hit his thighs in desperation, but the muscles merely trembled unresponsively."
    },
    {
        "text": "This time, he had truly exhausted any last trace of strength in his body."
    },
    {
        "tag": "dialog"
    },
    {
        "text": "The spear slipped from his hand."
    },
    {
        "tag": "dialog"
    },
    {
        "text": "Get up! Stand up!",
        "tag": "name",
        "value": "Yoshitaka Kashiwau"
    },
    {
        "tag": "dialog"
    },
