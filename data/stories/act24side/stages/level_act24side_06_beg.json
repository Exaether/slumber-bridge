    },
    {
        "text": "Rathalos! The Rathalos is falling!",
        "tag": "name",
        "value": "Felyne Scholar"
    },
    {
        "text": "The mask is covering my eyes! I can't see anything!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "tag": "playsound",
        "key": "$MH_nekoinjured"
    },
    {
        "text": "Noir Corne! Noir Cornnnne! L-Look what the R-Ra-Rathalos is charging toward!",
        "tag": "name",
        "value": "Felyne Scholar"
    },
    {
        "text": "T-Toward what?!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "text": "We're about to crash!",
        "tag": "name",
        "value": "Felyne Scholar"
    },
    {
        "text": "Hold on... Finally, my mask's back in place!",
        "tag": "name",
        "value": "Noir Corne"
    },
    {
        "text": "Ahh! We're going to crash!",
        "tag": "name",
        "value": "Noir Corne"
