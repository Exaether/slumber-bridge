    },
    {
        "tag": "character",
        "name": "avg_npc_008"
    },
    {
        "text": "What the hell are you mumbling about?",
        "tag": "name",
        "value": "'Captain'"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
