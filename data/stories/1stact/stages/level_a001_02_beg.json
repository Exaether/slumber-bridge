    },
    {
        "text": "(\u00c6girian) All that standeth before me shall perish.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "(\u00c6girian) All that beareth arms against me shall return to dust.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "(\u00c6girian) All that craveth death, step forth.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "blocker",
