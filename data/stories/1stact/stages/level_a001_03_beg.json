    {
        "text": "She's really gonna kill me! Whoa, what is she doing to Miss Carol?",
        "tag": "name",
        "value": "Grani"
    },
    {
        "tag": "character",
        "name": "avg_npc_003"
    },
    {
        "text": "Her eyes, they're so red... G-Grani!",
        "tag": "name",
        "value": "Carol"
    },
    {
        "tag": "character",
        "name": "char_220_grani#1"
    },
    {
        "text": "No, no, no! This can't be happening!",
