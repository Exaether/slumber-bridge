    },
    {
        "tag": "camerashake",
        "duration": 0.6,
        "xstrength": 5,
        "ystrength": 8,
        "vibrato": 30,
        "randomness": 90,
        "block": true
    },
    {
        "text": "Woah!!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "character",
        "name": "avg_npc_010#2"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Big Bob"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character"
    },
    {
        "tag": "playsound",
        "key": "$d_gen_walk_n",
        "volume": 0.6
    },
    {
        "tag": "character",
        "name": "char_263_skadi#2",
        "fadetime": 1
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "I don't care who you are, or what you plan on doing.",
        "tag": "name",
        "value": "Skadi"
    },
    {
        "text": "But you shall disappear from my sight.",
        "tag": "name",
        "value": "Skadi"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "block": true
    },
    {
        "tag": "background"
    },
    {
