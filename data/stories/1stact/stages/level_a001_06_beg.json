            "name2": "char_220_grani#3",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Grani",
        "text": "Why didn't you say so in the first place?!"
    },
    {
        "command": "name",
        "value": "Grani",
        "text": "What's the point of playing the villain anyway? Wouldn't kill you to be a bit more frank."
