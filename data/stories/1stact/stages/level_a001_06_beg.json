            "fadeout": true,
            "block": true
        }
    },
    {
        "command": "name",
        "value": "Big Bob",
        "text": "I'm nothing like you greed-driven lot!"
    },
    {
        "command": "name",
        "value": "Big Bob",
        "text": "I used to be a good-for-nothing just like you, but I've seen the world for what it is."
