    {
        "command": "character",
        "params": {
            "name": "avg_npc_010#2",
            "name2": "char_220_grani#5",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Big Bob",
        "text": "In that case, let me have the treasure then!"
