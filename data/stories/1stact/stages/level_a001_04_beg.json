    {
        "tag": "playmusic",
        "intro": "$mist_intro",
        "key": "$mist_loop",
        "volume": 0.6,
        "crossfade": 1.5
    },
    {
        "text": "Aaaagh\u2014",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "avg_npc_008",
        "fadetime": 0.5
    },
    {
        "text": "Someone... help... save me...",
        "tag": "name",
        "value": "'Captain'"
    },
    {
        "text": "It's... the Infected...",
        "tag": "name",
        "value": "'Captain'"
    },
    {
        "tag": "character"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "...What'd you do to him?",
        "tag": "name",
        "value": "Reunion Member A"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_1",
        "fadetime": 1
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "I didn't even do anything. He just tripped over himself...",
        "tag": "name",
        "value": "Reunion Member B"
    },
    {
        "text": "Huh.",
        "tag": "name",
        "value": "Reunion Member B"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2",
        "name2": "char_1002_nsabr_1",
        "focus": 1
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Reunion Member A"
    },
    {
        "tag": "character"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.6,
        "block": true
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "fadetime": 0.6,
        "block": true
    },
    {
        "tag": "character",
        "name": "char_220_grani#5"
    },
    {
        "text": "They're... from Reunion?",
        "tag": "name",
        "value": "Grani"
    },
    {
        "tag": "character",
        "name": "avg_npc_010"
    },
    {
        "text": "You guys...",
        "tag": "name",
        "value": "Big Bob"
    },
    {
        "tag": "character",
        "name": "char_220_grani#5"
    },
    {
        "text": "Big Bob, what are you doing?",
        "tag": "name",
        "value": "Grani"
    },
    {
        "text": "These guys aren't your ordinary...",
        "tag": "name",
        "value": "Grani"
    },
    {
        "tag": "character",
        "name": "avg_npc_010"
    },
    {
        "text": "Say no more. We're going to have to fight!",
        "tag": "name",
        "value": "Big Bob"
    },
    {
        "tag": "character",
        "name": "char_1002_nsabr_2",
        "name2": "char_1002_nsabr_1"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "text": "Quick, capture them before they get away!",
        "tag": "name",
        "value": "Reunion Member"
    },
    {
        "tag": "delay",
        "time": 0.6
    },
    {
