        "value": "Big Bob",
        "text": "You guys..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_220_grani#5"
        }
    },
    {
        "command": "name",
        "value": "Grani",
        "text": "Big Bob, what are you doing?"
    },
    {
        "command": "name",
        "value": "Grani",
        "text": "These guys aren't your ordinary..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_010"
        }
    },
    {
