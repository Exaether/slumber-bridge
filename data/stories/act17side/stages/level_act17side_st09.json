    },
    {
        "text": "Hunting, must be done.",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "tag": "character",
        "name": "avg_npc_456_1#1$1"
    },
    {
        "text": "Purpose, to mold the environment.",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "tag": "character",
        "name": "avg_npc_456_1#1$1"
    },
    {
        "text": "You, are rich in nutrients.",
        "tag": "name",
        "value": "Seaborn"
    },
