    },
    {
        "tag": "character",
        "name": "avg_npc_186"
    },
    {
        "text": "My blood and your blood are identical.",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "text": "You smell my scent, exactly as we smell your scent.",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "text": "You find us, kill us...",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "text": "When we do not understand, we kill you too.",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "text": "We feed the ocean. Our bodies have provided for the ocean.",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "text": "Ishar-mla, we possess the same home.",
        "tag": "name",
        "value": "Seaborn"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1,
        "block": true
    },
    {
