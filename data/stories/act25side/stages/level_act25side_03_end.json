        "time": 2
    },
    {
        "tag": "charslot",
        "slot": "r",
        "focus": "l"
    },
    {
        "text": "Who goes there?",
        "tag": "name",
        "value": "Agent A"
    },
    {
        "tag": "charslot",
        "slot": "r",
        "focus": "r"
    },
    {
        "text": "A... kid?",
        "tag": "name",
        "value": "Agent B"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_895_1#1$1",
        "duration": 1
    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "text": "Looks like the Doctor's intel was good.",
        "tag": "name",
        "value": "Ifrit"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_895_1#9$1"
    },
    {
        "text": "Hey, you, I don't know why you're hiding here, but I think you oughta surrender now.",
        "tag": "name",
        "value": "Ifrit"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 1.5,
        "block": true
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
