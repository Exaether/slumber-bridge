    },
    {
        "tag": "charslot",
        "slot": "l",
        "name": "avg_npc_895_1#5$1",
        "focus": "l"
    },
    {
        "text": "Silence? What are you doing here?",
        "tag": "name",
        "value": "Ifrit"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_896_1#4$1"
    },
    {
        "text": "...Silence.",
        "tag": "name",
        "value": "Saria"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_1031_slent2_1#1$1"
    },
    {
        "text": "Why are you here?",
        "tag": "name",
        "value": "Silence"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
