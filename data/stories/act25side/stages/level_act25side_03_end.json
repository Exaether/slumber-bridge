        "volume": 0.3,
        "channel": "y",
        "delay": 0.15
    },
    {
        "text": "Come on, mash that photo button!",
        "tag": "name",
        "value": "Reporter"
    },
    {
        "tag": "playsound",
        "key": "$skill_flash",
        "volume": 0.3,
        "channel": "y",
        "delay": 0.3
    },
    {
        "text": "Mr. Vice President! What did you think about your trip to Rhine today?",
        "tag": "name",
        "value": "Reporter"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_529_1#1$1",
        "duration": 0.5
    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "Ask your questions in order, please! We have ten minutes, there's no rush.",
        "tag": "name",
        "value": "Rhine Staff"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot",
        "duration": 0.5
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Reporter"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "dialog"
    },
    {
