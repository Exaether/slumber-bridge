    },
    {
        "tag": "delay",
        "time": 0.5
    },
    {
        "text": "You heard me right. I'm clapping.",
        "tag": "name",
        "value": "Muelsyse"
    },
    {
        "text": "'Vice President's Visit Bolsters Rhine Lab\u2019s Claim as Industry Leader'... the headlines write themselves.",
        "tag": "name",
        "value": "Muelsyse"
    },
    {
        "text": "The tour concluded without incident. The Vice President will leave Rhine Lab in ten minutes.",
        "tag": "name",
        "value": "Muelsyse"
    },
    {
        "text": "...Doctor.",
        "tag": "name",
        "value": "Muelsyse"
    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
