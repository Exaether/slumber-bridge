            "focus": "r"
        }
    },
    {
        "command": "name",
        "value": "Theresis",
        "text": "..."
    },
    {
        "command": "name",
        "value": "Theresis",
        "text": "You have chosen one to follow, but not the path that she walks."
    },
    {
        "command": "name",
        "value": "Theresis",
        "text": "If you do not know why you walk, how will you bear the pain of losing the ones who walk with you, Ascalon?"
    },
