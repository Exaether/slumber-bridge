    {
        "tag": "subtitle",
        "text": "A nightmare that walks the night.",
        "x": 300,
        "y": 370,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle"
    },
    {
        "tag": "subtitle",
        "text": "A monster who kidnaps children and sucks their blood dry.",
        "x": 300,
        "y": 550,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle"
    },
    {
        "tag": "subtitle",
        "text": "Their bodies stink of blood.",
        "x": 300,
        "y": 450,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle"
    },
    {
        "tag": "subtitle",
        "text": "They have eyes that glow crimson red.",
        "x": 300,
        "y": 400,
        "alignment": "center",
        "size": 24,
        "delay": 0.04,
        "width": 700
    },
    {
        "tag": "subtitle"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0.5,
        "block": true
    },
    {
        "tag": "character",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "camerashake",
        "duration": 0.6,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "Ahhhh\u2014!",
        "tag": "name",
        "value": "Brave Child"
    },
    {
        "tag": "character",
        "name": "char_171_bldsk_1",
        "enter": "middle",
        "fadetime": 1.5,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1.5
    },
    {
        "text": "Got you now.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_171_bldsk_1",
        "focus": -1
    },
    {
        "text": "No... Stay away! Don't come any closer! I... I won't let you hurt Yuri!",
        "tag": "name",
        "value": "Brave Child"
    },
    {
        "tag": "character",
        "name": "char_171_bldsk_1"
    },
    {
        "text": "Me, hurt him? Boy, what do you think I'm trying to do?",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_171_bldsk_1",
        "focus": -1
    },
    {
        "text": "You want to suck his blood, you blood-sucking monster!",
        "tag": "name",
        "value": "Brave Child"
    },
    {
        "tag": "character",
        "name": "char_171_bldsk_1"
    },
    {
        "text": "Well, it's been a long while since anyone has called me that.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "Yes, that's right. I'm a Vampire.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$fightgeneral"
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 10,
