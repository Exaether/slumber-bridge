    {
        "text": "11:41 P.M. \\ Overcast"
    },
    {
        "text": "Lungmen District 7, City Gateway"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$drift"
    },
    {
        "tag": "delay",
