        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "You know how loyal I am! Why are you abandoning me, Boss?!",
        "tag": "name",
        "value": "Broca"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "character",
        "name": "char_356_broca#4",
        "focus": -1
    },
    {
        "text": "It's because you're loyal\u00a0\u00a0, Broca.",
        "tag": "name",
        "value": "???"
    },
    {
        "text": "All that loyalty, isn't it natural you'd die for me?",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "char_356_broca#4"
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Broca"
    },
    {
        "tag": "dialog"
