    {
        "text": "Aosta, are we really joining this Rhodes Island organization?",
        "tag": "name",
        "value": "Broca"
    },
    {
        "tag": "character",
        "name": "char_346_aosta",
        "fadetime": 1,
        "block": true
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
        "text": "That's right, Broca. I think it's our best option.",
        "tag": "name",
        "value": "Aosta"
    },
    {
        "tag": "character",
        "name": "char_356_broca",
        "name2": "char_346_aosta",
        "focus": 1
    },
    {
        "text": "There's\u00a0\u00a0 other places we could go.",
        "tag": "name",
        "value": "Broca"
    },
    {
        "tag": "character",
        "name": "char_356_broca",
        "name2": "char_346_aosta",
        "focus": 2
    },
    {
        "text": "I know you aren't a fan of this idea, Broca, but, honestly, this is our best option.",
        "tag": "name",
        "value": "Aosta"
    },
    {
        "tag": "character",
        "name": "char_356_broca",
        "name2": "char_346_aosta",
        "focus": 1
    },
    {
        "text": "......",
        "tag": "name",
        "value": "Broca"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "delay",
        "time": 1
    },
    {
