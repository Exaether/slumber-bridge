    },
    {
        "text": "The place where only one moon shines.",
        "tag": "name",
        "value": "Old Sarkaz Hunter"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 0,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "cameraeffect",
        "effect": "Grayscale",
        "fadetime": 0,
        "amount": 0,
        "block": true
    },
    {
        "tag": "background",
        "image": "bg_iceforest_1",
        "screenadapt": "coverall"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 0,
        "g": 0,
        "b": 0,
        "fadetime": 2,
        "block": true
    },
    {
