        "fadeout": true,
        "block": false
    },
    {
        "text": "Who's there?",
        "tag": "name",
        "value": "Firewatch"
    },
    {
        "text": "I...",
        "tag": "name",
        "value": "Firewatch"
    },
    {
        "tag": "character",
        "name": "char_158_milu"
    },
    {
        "tag": "camerashake",
        "duration": 0.5,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": false
    },
    {
        "text": "*cough* *cough* *cough* *cough*...",
        "tag": "name",
        "value": "Firewatch"
    },
    {
        "tag": "stopmusic",
        "fadetime": 2
    },
    {
        "text": "I have to stay up... stay awake.",
        "tag": "name",
        "value": "Firewatch"
    },
    {
        "text": "I still haven't... I...",
        "tag": "name",
        "value": "Firewatch"
    },
