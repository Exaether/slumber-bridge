            "a": 0,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 0.6,
            "block": true
        }
    },
    {
        "command": "character",
        "params": {
            "name": "char_158_milu"
        }
    },
    {
        "command": "name",
        "value": "Firewatch",
        "text": "Past, present, future... no matter where I am."
    },
    {
        "command": "name",
        "value": "Firewatch",
        "text": "Until I find every last traitor, until I fulfill my revenge\u2014"
    },
    {
        "command": "name",
        "value": "Firewatch",
        "text": "This will be the only name I possess."
    },
