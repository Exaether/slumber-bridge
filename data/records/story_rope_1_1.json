        "duration": 0.2,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 70,
        "fadeout": true,
        "block": false
    },
    {
        "text": "I'm, I'm getting a little dizzy...",
        "tag": "name",
        "value": "Rope"
    },
