        "name": "char_1011_purgatory_1#1"
    },
    {
        "text": "Hello, I live in the building furthest on the east. Would it be any trouble if I borrowed...",
        "tag": "name",
        "value": "Lava"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_418_1#1$1"
    },
    {
        "text": "Er... no, sorry, we don't have any. Best of luck.",
        "tag": "name",
        "value": "Neighbor A"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "playsound",
        "key": "$doorclosequite"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "char_1011_purgatory_1#1"
    },
    {
        "text": "(Won't even hear me finishing a sentence...)",
        "tag": "name",
        "value": "Lava"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "blocker",
