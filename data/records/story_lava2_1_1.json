    {
        "tag": "charslot",
        "slot": "m",
        "name": "char_1011_purgatory_1#1"
    },
    {
        "text": "Hello, I'm wondering if I could borrow some chili powder.",
        "tag": "name",
        "value": "Lava"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "tag": "playsound",
        "key": "$doorclosequite"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "text": "They flatly shut the door in her face."
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "char_1011_purgatory_1#1"
    },
    {
        "text": "(Tolerant... you say?)",
        "tag": "name",
        "value": "Lava"
    },
    {
        "tag": "dialog"
    },
    {
