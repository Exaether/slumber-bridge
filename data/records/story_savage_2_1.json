            "g": 0,
            "b": 0,
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "background",
        "params": {
            "image": "bg_canteen"
        }
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1"
        }
    },
    {
        "command": "blocker",
        "params": {
            "a": 0,
            "r": 0,
            "g": 0,
            "b": 0,
            "fadetime": 1,
            "block": true
        }
    },
    {
        "command": "delay",
        "value": 2
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "Aaah\u2014hmp! ...Delish! Thank you for the food, Savage!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "(Rapid chewing)"
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "Oh, fine, you're welcome."
    },
    {
        "command": "character",
        "params": {
            "name": "char_365_aprl"
        }
    },
    {
        "command": "name",
        "value": "April",
        "text": "Th-This pie tastes so... so professional."
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "Heh-heh... no surprises there, no surprises. There's no one out there who can brush off my handiwork."
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "April, you want to try some of mine too? It's all the rage in Victorian eating right now, you just take anything and dump loaaads\u2014and loads of ketchup on it!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "No! You've already used up two whole bottles on this! You can't even taste the original flavor anymore, you naughty little kid!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "Heheh, how about you try my special portion then, Ayers? It's the taste of innovation!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "I always abide by the original flavors. Eat your grotesquely revised pie yourself..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "Huh? Don't be a bore, Ayers! Get a little more creativity in you."
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "When we were in Victoria, every time we went to a restaurant, we'd see customers ordering a pie just like this, and then squeezing at least four ketchup packets onto it."
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "'The healthiest part of the food's actually the complimentary ketchup sachets,' didn't they always say that at all the fast food places?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_365_aprl"
        }
    },
    {
        "command": "name",
        "value": "April",
        "text": "You are not comparing Savage's pie to a fast food joint."
    },
    {
        "command": "name",
        "value": "April",
        "text": "Everything about it's so perfect, from the heat control to the aroma..."
    },
    {
        "command": "name",
        "value": "April",
        "text": "I feel like it's been ages since I tried this flavor. It's a scent you'd get while running around outside... is it nostalgia, maybe..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "Yeah? I think it's pretty good, right?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_365_aprl"
        }
    },
    {
        "command": "name",
        "value": "April",
        "text": "How is it you have no idea how to read the mood?"
    },
    {
        "command": "character",
        "params": {
            "name": "char_294_ayer",
            "name2": "char_373_Leonhardt_1",
            "focus": 1
        }
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "Leon's trying to say that as a Catastrophe Messenger, he's already used to a life of long spates without any Rim Billiton food available. Being too dependent on your home's dishes... makes it hard to carry on outside."
    },
    {
        "command": "character",
        "params": {
            "name": "char_373_Leonhardt_1"
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "That's right. By the way, let me tell you something cool, April, while we were traveling out there, we saw another way to eat pie, where you have to grab it with your hands, and then you jump into the air\u2014"
    },
    {
        "command": "character",
        "params": {
            "name": "char_365_aprl"
        }
    },
    {
        "command": "name",
        "value": "April",
        "text": "Wagh! Careful, you're gonna drop it, you're gonna drop the pie...!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "Hol\u2014Hold on, other people are still working right now, settle down a little... Leonhardt, sit still!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_373_Leonhardt_1"
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "Aw, okay..."
    },
    {
        "command": "dialog"
    },
    {
        "command": "character"
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "playsound",
        "params": {
            "key": "$d_gen_walk_n"
        }
    },
    {
        "command": "delay",
        "value": 1
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#3",
            "fadetime": 1.5
        }
    },
    {
        "command": "delay",
        "value": 2
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Excuse me..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_365_aprl",
            "name2": "char_294_ayer"
        }
    },
    {
        "command": "name",
        "value": "April & Ayerscarpe",
        "text": "Ah."
    },
    {
        "command": "character",
        "params": {
            "name": "char_373_Leonhardt_1"
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "Whoa, it's Amiya and the Doctor\u2014"
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#2"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "So you were all dining, then."
    },
    {
        "command": "character",
        "params": {
            "name": "char_373_Leonhardt_1"
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "No, we weren't, this was, uh, Savage inviting us for a 'taste-of-home sampling party'..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "You've made such a mess of the dining hall. Sorry, Amiya, Doctor, I'll tidy it all up soon."
    },
    {
        "command": "character",
        "params": {
            "name": "char_002_amiya_1#10"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "It's okay, we're here to sample Savage's culinary delicacies, too. Let's all clean up afterwards."
    },
    {
        "command": "character",
        "params": {
            "name": "char_365_aprl",
            "name2": "char_294_ayer",
            "focus": 2
        }
    },
    {
        "command": "name",
        "value": "Ayerscarpe",
        "text": "Egg on your face, Leon."
    },
    {
        "command": "character",
        "params": {
            "name": "char_373_Leonhardt_1"
        }
    },
    {
        "command": "name",
        "value": "Leonhardt",
        "text": "I thought it'd be fine to act a little cool with just us four... April, I'll show you that special eating method next time."
    },
    {
        "command": "dialog"
    },
