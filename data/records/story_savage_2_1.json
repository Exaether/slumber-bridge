        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "*cough* *cough*... *cough*... Waah, Savage, help me..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "camerashake",
        "params": {
            "duration": 0.5,
            "xstrength": 15,
            "ystrength": 15,
            "vibration": 20,
            "randomness": 70,
            "fadeout": true,
            "block": false
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "Pff... pff, haha..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_051"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Waaah, my eyes hurt..."
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "Sorry, sorry, let me wipe them off for you now... *cough*, kfah-*cough*, kah-haha..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_051"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Stop making fun of me!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "I'm not making fun of you! Pff... You're just being extra adorable right now, that's all, Amiya. Oh, man, I want a memento of this to keep forever."
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "But you've got the flour all over you, now. Let's take you to tidy up first, yeah..."
    },
    {
        "command": "character",
        "params": {
            "name": "avg_npc_051"
        }
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "N-No, the pie's most important right now... it'll be awful if we can't finish it in time!"
    },
    {
        "command": "name",
        "value": "Amiya",
        "text": "Savage, let's wait until we're done to tidy!"
    },
    {
        "command": "character",
        "params": {
            "name": "char_230_savage_1"
        }
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "Haha, alright then. Amiya, come here, let me wipe your face off for you."
    },
    {
        "command": "name",
        "value": "Savage",
        "text": "Once we've got the pie done and in the oven, we'll go and have a good wash..."
    },
    {
        "command": "dialog"
    },
    {
        "command": "blocker",
        "params": {
            "a": 0,
            "r": 0,
            "g": 0,
            "b": 0,
