    {
        "tag": "playsound",
        "key": "$d_sp_ballista",
        "volume": 0.7
    },
    {
        "tag": "camerashake",
        "duration": 1,
        "xstrength": 10,
        "ystrength": 12,
        "vibrato": 30,
        "randomness": 90,
