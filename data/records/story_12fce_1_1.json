    },
    {
        "text": "You still alive?!",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "tag": "character",
        "name": "avg_npc_053",
        "name2": "char_009_12fce_1",
        "focus": 2
    },
    {
        "text": "I'm fine.",
        "tag": "name",
        "value": "???"
    },
    {
        "tag": "character",
        "name": "avg_npc_053",
        "name2": "char_009_12fce_1",
        "focus": 1
    },
    {
        "text": "They found our vantage point. We don't have much time left! Get a move on!",
        "tag": "name",
        "value": "Sarkaz Mercenary"
    },
    {
        "tag": "dialog"
    },
