        }
    },
    {
        "command": "name",
        "value": "Taihe",
        "text": "Thank you for coming."
    },
    {
        "command": "charslot",
        "params": {
            "slot": "m",
            "name": "avg_npc_041"
        }
    },
    {
        "command": "name",
        "value": "???",
        "text": "It just happens I'm on duty today..."
    },
    {
        "command": "name",
        "value": "???",
        "text": "Taihe, what is there that we cannot discuss in the Department of Discipline and Supervision's offices?"
    },
    {
        "command": "dialog"
    },
    {
        "command": "charslot"
