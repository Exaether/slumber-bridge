        "fadetime": 0.05,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 0,
        "r": 255,
        "g": 0,
        "b": 0,
        "fadetime": 0.05,
        "block": true
    },
    {
        "tag": "blocker",
        "a": 1,
        "r": 255,
        "g": 0,
