        "name": "avg_4025_aprot2_1#3$1"
    },
    {
        "text": "Stop! Stop!",
        "tag": "name",
        "value": "Abyss"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_npc_701_1#1$1"
    },
    {
        "text": "I can't let get you into trouble.",
        "tag": "name",
        "value": "Sad Man"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "playsound",
        "key": "$d_avg_knife",
        "channel": 1
    },
    {
        "tag": "playsound",
        "key": "$blooddrop",
        "channel": 2
    },
    {
        "tag": "camerashake",
        "duration": 0.8,
        "xstrength": 50,
        "ystrength": 50,
        "vibrato": 30,
        "randomness": 90,
        "fadeout": true,
        "block": true
    },
    {
        "tag": "charslot",
        "duration": 1.5
    },
    {
        "tag": "playsound",
        "key": "$bodyfalldown1"
    },
    {
        "tag": "delay",
        "time": 2
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4025_aprot2_1#5$1"
    },
    {
        "text": "...Tell me you're joking.",
        "tag": "name",
        "value": "Abyss"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Silent Man"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4025_aprot2_1#5$1"
    },
    {
        "text": "Get up! Stop acting!",
        "tag": "name",
        "value": "Abyss"
    },
    {
        "text": "Get up! We need to go, or it'll be too late!",
        "tag": "name",
        "value": "Abyss"
    },
    {
        "tag": "dialog"
    },
    {
        "tag": "charslot"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Silent Man"
    },
    {
        "tag": "charslot",
        "slot": "m",
        "name": "avg_4025_aprot2_1#5$1"
    },
    {
        "text": "Say something!",
        "tag": "name",
        "value": "Abyss"
    },
    {
        "text": "...",
        "tag": "name",
        "value": "Abyss"
    },
    {
        "tag": "dialog"
    },
